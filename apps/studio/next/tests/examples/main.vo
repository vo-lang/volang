package main

import (
	"encoding/json"
	"fmt"
	"github.com/vo-lang/studio/next/examples"
)

type catalog struct {
	Console []examples.Example `json:"console"`
	UI []examples.Example `json:"ui"`
}

func main() {
	bytes, err := json.Marshal(catalog{Console: examples.Console(), UI: examples.UI()})
	if err != nil {
		panic(err)
	}
	fmt.Print(string(bytes))
}
