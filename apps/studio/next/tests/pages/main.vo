package main

import (
	"fmt"
	"github.com/vo-lang/studio/next/app"
	"github.com/vo-lang/studio/next/documentation"
)

func main() {
	paths := app.StaticPaths()
	seen := make(map[string]bool)
	if len(paths) != len(documentation.Pages()) + 6 {
		panic("static page catalog is incomplete")
	}
	for _, path := range paths {
		page, err := app.Describe(path)
		if err != nil || page.Status != 200 || seen[path] {
			panic("invalid or repeated static page: " + path)
		}
		seen[path] = true
	}
	for _, sample := range []struct {
		URL string
		Title string
		Status int
	}{
		{"/studio", "Gallery", 200}, {"/studio/gallery", "Gallery", 200},
		{"/studio/recover", "Recover browser projects", 200}, {"/studio/playground", "Playground", 200},
		{"/studio/playground/ui", "Playground", 200}, {"/studio/docs", "First steps", 200},
		{"/studio/docs/first-steps", "First steps", 200}, {"/studio/docs/state", "State & identity", 200},
		{"/studio/docs?topic=lifecycle", "Lifecycle & requests", 200},
		{"/studio/docs/unknown", "Documentation", 404}, {"/studio/missing", "Page not found", 404},
		{"/studio/docs/hello%2Fworld", "Documentation", 404}, {"/unknown", "Page not found", 404},
	} {
		page, err := app.Describe(sample.URL)
		if err != nil || page.Status != sample.Status || page.Title != sample.Title + " · Volang Studio" {
			panic("page metadata disagrees with route: " + sample.URL)
		}
	}
	for _, chapter := range documentation.Pages() {
		if !seen["/studio/docs/" + chapter.ID] {
			panic("missing static chapter: " + chapter.ID)
		}
		for _, location := range []string{
			"/studio/docs/" + chapter.ID, "/studio/docs/?topic=" + chapter.ID,
		} {
			page, err := app.Describe(location)
			if err != nil || page.Status != 200 || page.Title != chapter.Title + " · Volang Studio" ||
				page.Document.Asset != chapter.Asset ||
				page.Request.Value != "/studio-docs/" + chapter.Asset + "?v=" + chapter.SHA256 ||
				page.Request.TimeoutMilliseconds != 10000 {
				panic("chapter metadata or cache identity differs: " + location)
			}
		}
	}
	legacy := make(map[string]bool)
	redirects := app.LegacyRedirects()
	if len(redirects) != len(documentation.Pages()) + 14 {
		panic("legacy redirect catalog is incomplete")
	}
	for _, redirect := range redirects {
		if legacy[redirect.From] || seen[redirect.From] || !seen[redirect.To] {
			panic("invalid legacy redirect: " + redirect.From)
		}
		legacy[redirect.From] = true
	}
	fmt.Println("studio page contracts: routes and 23 chapter identities ok")
}
