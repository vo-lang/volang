{"version":1,"headingID":"doc-dynamic-access-specification","nodes":[{"tag":"h2","attrs":{"id":"doc-overview"},"children":[{"tag":"#text","text":"Overview"}]},{"tag":"p","children":[{"tag":"#text","text":"Vo supports opt-in dynamic operations on values whose structure is unknown at compile time."}]},{"tag":"p","children":[{"tag":"#text","text":"Dynamic access is enabled by the "},{"tag":"code","children":[{"tag":"#text","text":"~>"}]},{"tag":"#text","text":" operator. The operator does not introduce\na new runtime representation. An interface base already carries its dynamic\ntype and value; a concrete protocol base dispatches statically. Reflection on\nanother concrete value requires an explicit conversion to "},{"tag":"code","children":[{"tag":"#text","text":"any"}]},{"tag":"#text","text":"."}]},{"tag":"p","children":[{"tag":"#text","text":"Dynamic operations return "},{"tag":"code","children":[{"tag":"#text","text":"(any, error)"}]},{"tag":"#text","text":" and are intended to compose with Vo's existing error handling ("},{"tag":"code","children":[{"tag":"#text","text":"?"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"fail"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"errdefer"}]},{"tag":"#text","text":"). There is no error-carrying payload."}]},{"tag":"h3","attrs":{"id":"doc-supported-base-types"},"children":[{"tag":"#text","text":"Supported Base Types"}]},{"tag":"p","children":[{"tag":"#text","text":"The "},{"tag":"code","children":[{"tag":"#text","text":"~>"}]},{"tag":"#text","text":" operator can be used on:"}]},{"tag":"table","children":[{"tag":"thead","children":[{"tag":"tr","children":[{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"Type"}]},{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"Allowed"}]},{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"Reason"}]}]}]},{"tag":"tbody","children":[{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"any"}]},{"tag":"#text","text":" / "},{"tag":"code","children":[{"tag":"#text","text":"interface"}]}]},{"tag":"td","children":[{"tag":"#text","text":"✅"}]},{"tag":"td","children":[{"tag":"#text","text":"Dynamic dispatch"}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"(any, error)"}]},{"tag":"#text","text":" tuple"}]},{"tag":"td","children":[{"tag":"#text","text":"✅"}]},{"tag":"td","children":[{"tag":"#text","text":"Chained access with short-circuit"}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"#text","text":"Named concrete types"}]},{"tag":"td","children":[{"tag":"#text","text":"✅ with protocol"}]},{"tag":"td","children":[{"tag":"#text","text":"Must implement the exact reserved protocol for the operation"}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"#text","text":"Pointers"}]},{"tag":"td","children":[{"tag":"#text","text":"✅ with protocol"}]},{"tag":"td","children":[{"tag":"#text","text":"Must implement the exact reserved protocol for the operation"}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"#text","text":"Structs / maps / slices / arrays / strings"}]},{"tag":"td","children":[{"tag":"#text","text":"✅ after "},{"tag":"code","children":[{"tag":"#text","text":"any(v)"}]}]},{"tag":"td","children":[{"tag":"#text","text":"Reflection is explicit through an interface value"}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"int"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"bool"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"float"}]}]},{"tag":"td","children":[{"tag":"#text","text":"❌"}]},{"tag":"td","children":[{"tag":"#text","text":"No methods, no fields, no indexing"}]}]}]}]},{"tag":"p","children":[{"tag":"#text","text":"Concrete reflection requires an explicit conversion such as "},{"tag":"code","children":[{"tag":"#text","text":"any(value)~>Field"}]},{"tag":"#text","text":".\nReflection exposes exported struct fields and fields carrying a "},{"tag":"code","children":[{"tag":"#text","text":"dyn:\"name\""}]},{"tag":"#text","text":" tag.\nAn unexported field without that tag remains inaccessible; a protocol method can\nprovide controlled access when needed."}]},{"tag":"h2","attrs":{"id":"doc-syntax"},"children":[{"tag":"#text","text":"Syntax"}]},{"tag":"h3","attrs":{"id":"doc-dynamic-access-operator-"},"children":[{"tag":"#text","text":"Dynamic Access Operator ("},{"tag":"code","children":[{"tag":"#text","text":"~>"}]},{"tag":"#text","text":")"}]},{"tag":"pre","attrs":{"data-language":"go"},"children":[{"tag":"code","children":[{"tag":"#text","text":"// Field access\na~>field           // → (any, error)\na~>field?          // → any (propagate error)\n\n// Chaining\na~>b~>c             // → (any, error) (implicit short-circuiting)\na~>b~>c?            // → any\n\n// Indexing\na~>[key]           // → (any, error)\na~>[key]?          // → any (propagate error)\n\n// Call\na~>(args...)       // → (any, error)\na~>(args...)?      // → any (propagate error)\n\n// Method call (syntax sugar)\na~>method(args...) // → (any, error)\na~>method(args...)?// → any (propagate error)\n\n// Type assertion (same as interface)\nv := a.(T)         // → T (panic on failure)\nv, ok := a.(T)     // → (T, bool) (ok=false on failure, no panic)\n"}]}]},{"tag":"p","children":[{"tag":"strong","children":[{"tag":"#text","text":"Note"}]},{"tag":"#text","text":": Optional-chaining style operators like "},{"tag":"code","children":[{"tag":"#text","text":"?."}]},{"tag":"#text","text":" and "},{"tag":"code","children":[{"tag":"#text","text":"?[]"}]},{"tag":"#text","text":" are not part of Vo syntax. Use postfix "},{"tag":"code","children":[{"tag":"#text","text":"?"}]},{"tag":"#text","text":" on the result of each dynamic operation."}]},{"tag":"p","children":[{"tag":"strong","children":[{"tag":"#text","text":"Note"}]},{"tag":"#text","text":": The left operand may be "},{"tag":"code","children":[{"tag":"#text","text":"any/interface"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"(any, error)"}]},{"tag":"#text","text":", or a\nconcrete value implementing the exact reserved protocol for that operation.\nOther concrete values require an explicit "},{"tag":"code","children":[{"tag":"#text","text":"any(value)"}]},{"tag":"#text","text":" conversion for\nreflection. An "},{"tag":"code","children":[{"tag":"#text","text":"(any, error)"}]},{"tag":"#text","text":" base short-circuits when its error is non-nil."}]},{"tag":"h3","attrs":{"id":"doc-dynamic-operation-whitelist"},"children":[{"tag":"#text","text":"Dynamic Operation Whitelist"}]},{"tag":"p","children":[{"tag":"#text","text":"Dynamic access does not participate in normal static member lookup or overload resolution. Only a small whitelist of operations is supported when using "},{"tag":"code","children":[{"tag":"#text","text":"~>"}]},{"tag":"#text","text":":"}]},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"#text","text":"Field access: "},{"tag":"code","children":[{"tag":"#text","text":"a~>field"}]},{"tag":"#text","text":" (returns "},{"tag":"code","children":[{"tag":"#text","text":"(any, error)"}]},{"tag":"#text","text":")"}]},{"tag":"li","children":[{"tag":"#text","text":"Indexing: "},{"tag":"code","children":[{"tag":"#text","text":"a~>[key]"}]},{"tag":"#text","text":" (returns "},{"tag":"code","children":[{"tag":"#text","text":"(any, error)"}]},{"tag":"#text","text":")"}]},{"tag":"li","children":[{"tag":"#text","text":"Call: "},{"tag":"code","children":[{"tag":"#text","text":"a~>(args...)"}]},{"tag":"#text","text":" (returns "},{"tag":"code","children":[{"tag":"#text","text":"(any, error)"}]},{"tag":"#text","text":")"}]},{"tag":"li","children":[{"tag":"#text","text":"Method call (syntax sugar): "},{"tag":"code","children":[{"tag":"#text","text":"a~>method(args...)"}]},{"tag":"#text","text":" (returns "},{"tag":"code","children":[{"tag":"#text","text":"(any, error)"}]},{"tag":"#text","text":")"}]},{"tag":"li","children":[{"tag":"#text","text":"Error propagation: apply postfix "},{"tag":"code","children":[{"tag":"#text","text":"?"}]},{"tag":"#text","text":" to unwrap and propagate the "},{"tag":"code","children":[{"tag":"#text","text":"error"}]}]}]},{"tag":"p","children":[{"tag":"#text","text":"Dynamic writes use "},{"tag":"code","children":[{"tag":"#text","text":"dyn.SetAttr"}]},{"tag":"#text","text":" and "},{"tag":"code","children":[{"tag":"#text","text":"dyn.SetIndex"}]},{"tag":"#text","text":". A dynamic assignment target\nis a compile-time error, which keeps every write error visible in source."}]},{"tag":"p","children":[{"tag":"#text","text":"All other dynamic operations are compile errors."}]},{"tag":"h2","attrs":{"id":"doc-protocol-methods"},"children":[{"tag":"#text","text":"Protocol Methods"}]},{"tag":"p","children":[{"tag":"#text","text":"Vo defines five "},{"tag":"strong","children":[{"tag":"#text","text":"language-level protocol methods"}]},{"tag":"#text","text":" that customize dynamic access behavior. These are reserved method names with fixed signatures."}]},{"tag":"h3","attrs":{"id":"doc-protocol-definition"},"children":[{"tag":"#text","text":"Protocol Definition"}]},{"tag":"table","children":[{"tag":"thead","children":[{"tag":"tr","children":[{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"Method"}]},{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"Signature"}]},{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"Triggered By"}]}]}]},{"tag":"tbody","children":[{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"DynAttr"}]}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"(name string) (any, error)"}]}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"a~>field"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"DynSetAttr"}]}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"(name string, value any) error"}]}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.SetAttr(a, name, v)"}]},{"tag":"#text","text":" or direct call"}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"DynIndex"}]}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"(key any) (any, error)"}]}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"a~>[key]"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"DynSetIndex"}]}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"(key any, value any) error"}]}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.SetIndex(a, key, v)"}]},{"tag":"#text","text":" or direct call"}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"DynCall"}]}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"(args ...any) (any, error)"}]}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"a~>(args)"}]}]}]}]}]},{"tag":"h3","attrs":{"id":"doc-semantics"},"children":[{"tag":"#text","text":"Semantics"}]},{"tag":"ol","attrs":{"start":"1"},"children":[{"tag":"li","children":[{"tag":"p","children":[{"tag":"strong","children":[{"tag":"#text","text":"Fixed protocol typing"}]},{"tag":"#text","text":": A concrete "},{"tag":"code","children":[{"tag":"#text","text":"~>"}]},{"tag":"#text","text":" base must implement the exact protocol for its operation. Interface bases are checked at runtime."}]}]},{"tag":"li","children":[{"tag":"p","children":[{"tag":"strong","children":[{"tag":"#text","text":"Concrete dispatch"}]},{"tag":"#text","text":": A concrete protocol base dispatches only to the\nstatically validated reserved method. Reflection requires an explicit\nconversion to "},{"tag":"code","children":[{"tag":"#text","text":"any"}]},{"tag":"#text","text":"."}]}]},{"tag":"li","children":[{"tag":"p","children":[{"tag":"strong","children":[{"tag":"#text","text":"Interface dispatch"}]},{"tag":"#text","text":": For an interface base, the runtime checks the\ndynamic concrete value for the corresponding protocol. It falls back to\nreflection only when that protocol is absent."}]}]},{"tag":"li","children":[{"tag":"p","children":[{"tag":"strong","children":[{"tag":"#text","text":"Inheritance via Embedding"}]},{"tag":"#text","text":": Protocol methods can be inherited through struct embedding."}]}]},{"tag":"li","children":[{"tag":"p","children":[{"tag":"strong","children":[{"tag":"#text","text":"Signature Enforcement"}]},{"tag":"#text","text":": If a type defines a method with a protocol name (e.g., "},{"tag":"code","children":[{"tag":"#text","text":"DynAttr"}]},{"tag":"#text","text":") but the signature does not match, it is a "},{"tag":"strong","children":[{"tag":"#text","text":"compile-time error"}]},{"tag":"#text","text":"."}]}]}]},{"tag":"h3","attrs":{"id":"doc-example-custom-dynamic-object"},"children":[{"tag":"#text","text":"Example: Custom Dynamic Object"}]},{"tag":"pre","attrs":{"data-language":"go"},"children":[{"tag":"code","children":[{"tag":"#text","text":"type Config struct {\n    data map[string]any\n}\n\nfunc (c *Config) DynAttr(name string) (any, error) {\n    v, ok := c.data[name]\n    if !ok {\n        return nil, dyn.ErrBadField\n    }\n    return v, nil\n}\n\nfunc (c *Config) DynSetAttr(name string, value any) error {\n    c.data[name] = value\n    return nil\n}\n\nfunc main() error {\n    c := &Config{data: map[string]any{}}\n    dyn.SetAttr(c, \"name\", \"hello\")? // calls DynSetAttr(\"name\", \"hello\")\n    v := c~>name?         // calls DynAttr(\"name\") → \"hello\"\n    return nil\n}\n"}]}]},{"tag":"h3","attrs":{"id":"doc-example-embedding-dynmapobject"},"children":[{"tag":"#text","text":"Example: Embedding dyn.MapObject"}]},{"tag":"pre","attrs":{"data-language":"go"},"children":[{"tag":"code","children":[{"tag":"#text","text":"import \"dyn\"\n\ntype Config struct {\n    dyn.MapObject  // embed: inherits DynAttr, DynSetAttr, DynIndex, DynSetIndex\n}\n\nfunc main() error {\n    c := Config{dyn.MapObject{}}\n    dyn.SetAttr(c, \"name\", \"hello\")? // calls inherited DynSetAttr\n    v := c~>name?         // calls inherited DynAttr\n    return nil\n}\n"}]}]},{"tag":"h3","attrs":{"id":"doc-signature-error-example"},"children":[{"tag":"#text","text":"Signature Error Example"}]},{"tag":"pre","attrs":{"data-language":"go"},"children":[{"tag":"code","children":[{"tag":"#text","text":"type Bad struct{}\n\n// Compile error: DynAttr has wrong signature\n// Expected: (string) (any, error)\n// Got: (int) string\nfunc (b Bad) DynAttr(x int) string { return \"\" }\n"}]}]},{"tag":"h3","attrs":{"id":"doc-dispatch-priority"},"children":[{"tag":"#text","text":"Dispatch Priority"}]},{"tag":"p","children":[{"tag":"#text","text":"For a concrete base, "},{"tag":"code","children":[{"tag":"#text","text":"a~>field"}]},{"tag":"#text","text":" calls its validated "},{"tag":"code","children":[{"tag":"#text","text":"DynAttr"}]},{"tag":"#text","text":" method."}]},{"tag":"p","children":[{"tag":"#text","text":"For an interface base, dispatch proceeds in this order:"}]},{"tag":"ol","attrs":{"start":"1"},"children":[{"tag":"li","children":[{"tag":"strong","children":[{"tag":"#text","text":"Protocol method"}]},{"tag":"#text","text":": call "},{"tag":"code","children":[{"tag":"#text","text":"DynAttr(string) (any, error)"}]},{"tag":"#text","text":" when implemented"}]},{"tag":"li","children":[{"tag":"strong","children":[{"tag":"#text","text":"Map with string key"}]},{"tag":"#text","text":": access a "},{"tag":"code","children":[{"tag":"#text","text":"map[string]V"}]},{"tag":"#text","text":" key"}]},{"tag":"li","children":[{"tag":"strong","children":[{"tag":"#text","text":"Visible struct field"}]},{"tag":"#text","text":": access an exported field or its "},{"tag":"code","children":[{"tag":"#text","text":"dyn"}]},{"tag":"#text","text":" tag name"}]},{"tag":"li","children":[{"tag":"strong","children":[{"tag":"#text","text":"Method as closure"}]},{"tag":"#text","text":": return an exported method when no field matches"}]},{"tag":"li","children":[{"tag":"strong","children":[{"tag":"#text","text":"Error"}]},{"tag":"#text","text":": return "},{"tag":"code","children":[{"tag":"#text","text":"ErrBadField"}]}]}]},{"tag":"h2","attrs":{"id":"doc-error-mechanism"},"children":[{"tag":"#text","text":"Error Mechanism"}]},{"tag":"p","children":[{"tag":"#text","text":"Package "},{"tag":"code","children":[{"tag":"#text","text":"dyn"}]},{"tag":"#text","text":" exports sentinel errors. Dynamic operations may add operation\ncontext, while "},{"tag":"code","children":[{"tag":"#text","text":"errors.Is"}]},{"tag":"#text","text":" identifies the stable category. A protocol method's\nnon-nil error is propagated unchanged."}]},{"tag":"h3","attrs":{"id":"doc-error-generation"},"children":[{"tag":"#text","text":"Error Generation"}]},{"tag":"table","children":[{"tag":"thead","children":[{"tag":"tr","children":[{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"Operation"}]},{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"Failure Condition"}]},{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"Stable "},{"tag":"code","children":[{"tag":"#text","text":"errors.Is"}]},{"tag":"#text","text":" Category"}]}]}]},{"tag":"tbody","children":[{"tag":"tr","children":[{"tag":"td","children":[{"tag":"#text","text":"Any operation"}]},{"tag":"td","children":[{"tag":"#text","text":"nil base"}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.ErrNilBase"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"a~>field"}]}]},{"tag":"td","children":[{"tag":"#text","text":"field or method does not exist"}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.ErrBadField"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"a~>field"}]}]},{"tag":"td","children":[{"tag":"#text","text":"value does not support field access"}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.ErrTypeMismatch"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.SetAttr(a, name, x)"}]}]},{"tag":"td","children":[{"tag":"#text","text":"field does not exist"}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.ErrBadField"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.SetAttr(a, name, x)"}]}]},{"tag":"td","children":[{"tag":"#text","text":"base is not mutable or value is not assignable"}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.ErrTypeMismatch"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"a~>[key]"}]},{"tag":"#text","text":" / "},{"tag":"code","children":[{"tag":"#text","text":"dyn.SetIndex"}]}]},{"tag":"td","children":[{"tag":"#text","text":"key has an invalid type"}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.ErrBadIndex"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"a~>[key]"}]}]},{"tag":"td","children":[{"tag":"#text","text":"map key is absent"}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.ErrBadField"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"a~>[key]"}]},{"tag":"#text","text":" / "},{"tag":"code","children":[{"tag":"#text","text":"dyn.SetIndex"}]}]},{"tag":"td","children":[{"tag":"#text","text":"index is out of bounds"}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.ErrOutOfBounds"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"a~>[key]"}]},{"tag":"#text","text":" / "},{"tag":"code","children":[{"tag":"#text","text":"dyn.SetIndex"}]}]},{"tag":"td","children":[{"tag":"#text","text":"value does not support indexing or mutation"}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.ErrTypeMismatch"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"a~>method(args...)"}]}]},{"tag":"td","children":[{"tag":"#text","text":"method does not exist"}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.ErrBadField"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"#text","text":"Dynamic call"}]},{"tag":"td","children":[{"tag":"#text","text":"parameter or result signature mismatch"}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.ErrSigMismatch"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"a~>(args...)"}]}]},{"tag":"td","children":[{"tag":"#text","text":"value is not callable"}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.ErrBadCall"}]}]}]}]}]},{"tag":"h2","attrs":{"id":"doc-runtime-representation"},"children":[{"tag":"#text","text":"Runtime Representation"}]},{"tag":"h3","attrs":{"id":"doc-representation"},"children":[{"tag":"#text","text":"Representation"}]},{"tag":"p","children":[{"tag":"#text","text":"Dynamic access operates on ordinary "},{"tag":"code","children":[{"tag":"#text","text":"any"}]},{"tag":"#text","text":"/"},{"tag":"code","children":[{"tag":"#text","text":"interface"}]},{"tag":"#text","text":" values."}]},{"tag":"p","children":[{"tag":"#text","text":"There is no error-carrying payload. Errors are reported via the explicit "},{"tag":"code","children":[{"tag":"#text","text":"error"}]},{"tag":"#text","text":" return value of dynamic operations."}]},{"tag":"h2","attrs":{"id":"doc-lhs-type-driven-assignment"},"children":[{"tag":"#text","text":"LHS Type-Driven Assignment"}]},{"tag":"p","children":[{"tag":"#text","text":"When an LHS variable has a known static type, that type becomes the expected\ndynamic result type. The runtime checks ordinary assignment compatibility; it\ndoes not perform numeric coercion or other unrelated explicit conversions."}]},{"tag":"h3","attrs":{"id":"doc-rule"},"children":[{"tag":"#text","text":"Rule"}]},{"tag":"table","children":[{"tag":"thead","children":[{"tag":"tr","children":[{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"LHS Declaration"}]},{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"Result Type"}]},{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"Check"}]}]}]},{"tag":"tbody","children":[{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"v, err := ..."}]}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"any"}]}]},{"tag":"td","children":[{"tag":"#text","text":"None (default)"}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"var v int; v, err = ..."}]}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"int"}]}]},{"tag":"td","children":[{"tag":"#text","text":"Runtime assignment/type assertion"}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"var v MyStruct; v, err = ..."}]}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"MyStruct"}]}]},{"tag":"td","children":[{"tag":"#text","text":"Runtime assignment/type assertion"}]}]}]}]},{"tag":"h3","attrs":{"id":"doc-applies-to"},"children":[{"tag":"#text","text":"Applies To"}]},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"strong","children":[{"tag":"#text","text":"Field access"}]},{"tag":"#text","text":": "},{"tag":"code","children":[{"tag":"#text","text":"v, err := obj~>field"}]}]},{"tag":"li","children":[{"tag":"strong","children":[{"tag":"#text","text":"Index access"}]},{"tag":"#text","text":": "},{"tag":"code","children":[{"tag":"#text","text":"v, err := obj~>[key]"}]}]},{"tag":"li","children":[{"tag":"strong","children":[{"tag":"#text","text":"Method call"}]},{"tag":"#text","text":": "},{"tag":"code","children":[{"tag":"#text","text":"v, err := obj~>method(args...)"}]}]},{"tag":"li","children":[{"tag":"strong","children":[{"tag":"#text","text":"Direct call"}]},{"tag":"#text","text":": "},{"tag":"code","children":[{"tag":"#text","text":"v, err := obj~>(args...)"}]}]}]},{"tag":"h3","attrs":{"id":"doc-examples"},"children":[{"tag":"#text","text":"Examples"}]},{"tag":"pre","attrs":{"data-language":"go"},"children":[{"tag":"code","children":[{"tag":"#text","text":"var obj interface{} = map[string]int{\"count\": 42}\n\n// LHS is any (short var decl)\nv, err := obj~>[\"count\"]          // v is any\n\n// LHS has known type\nvar count int\ncount, err = obj~>[\"count\"]       // count is int (auto conversion)\n\n// Multi-return with known types\ntype Data struct { Name string; Age int }\nvar obj2 interface{} = &Data{Name: \"Alice\", Age: 30}\n\nvar name string\nvar age int\nname, err = obj2~>Name            // auto conversion to string\nage, err = obj2~>Age              // auto conversion to int\n"}]}]},{"tag":"h3","attrs":{"id":"doc-error-on-type-mismatch"},"children":[{"tag":"#text","text":"Error on Type Mismatch"}]},{"tag":"p","children":[{"tag":"#text","text":"If the runtime value is not assignable to the expected LHS type, the operation\nreturns an error matching "},{"tag":"code","children":[{"tag":"#text","text":"dyn.ErrTypeMismatch"}]},{"tag":"#text","text":"."}]},{"tag":"pre","attrs":{"data-language":"go"},"children":[{"tag":"code","children":[{"tag":"#text","text":"var count int\ncount, err = obj~>[\"name\"]        // err is TypeError (string -> int fails)\n"}]}]},{"tag":"h2","attrs":{"id":"doc-runtime-signature-checking"},"children":[{"tag":"#text","text":"Runtime Signature Checking"}]},{"tag":"p","children":[{"tag":"#text","text":"Dynamic calls perform "},{"tag":"strong","children":[{"tag":"#text","text":"runtime signature verification"}]},{"tag":"#text","text":" before invoking the target closure. The expected signature is derived from the LHS types at compile time."}]},{"tag":"h3","attrs":{"id":"doc-checks-performed"},"children":[{"tag":"#text","text":"Checks Performed"}]},{"tag":"ol","attrs":{"start":"1"},"children":[{"tag":"li","children":[{"tag":"strong","children":[{"tag":"#text","text":"Return value count"}]},{"tag":"#text","text":": The closure's return count must match the number of LHS variables (minus the error variable)."}]},{"tag":"li","children":[{"tag":"strong","children":[{"tag":"#text","text":"Parameter count"}]},{"tag":"#text","text":": The closure's parameter count must match the number of arguments provided."}]},{"tag":"li","children":[{"tag":"strong","children":[{"tag":"#text","text":"Parameter types"}]},{"tag":"#text","text":": Each argument's runtime type (rttid) must be compatible with the closure's expected parameter type."}]},{"tag":"li","children":[{"tag":"strong","children":[{"tag":"#text","text":"Return types"}]},{"tag":"#text","text":": If LHS has known types, the closure's return types must be compatible."}]}]},{"tag":"h3","attrs":{"id":"doc-examples-1"},"children":[{"tag":"#text","text":"Examples"}]},{"tag":"pre","attrs":{"data-language":"go"},"children":[{"tag":"code","children":[{"tag":"#text","text":"type Calc struct { val int }\nfunc (c *Calc) Add(x int) int { return c.val + x }\nfunc (c *Calc) Pair() (int, string) { return c.val, \"ok\" }\n\nvar obj interface{} = &Calc{val: 42}\n\n// OK: signature matches, LHS is any\nr1, err := obj~>Add(10)           // r1 is any(52)\n\n// OK: signature matches, LHS has known type\nvar result int\nresult, err = obj~>Add(10)        // result is 52 (int)\n\n// Error: return count mismatch (expects 1, got 2)\nr1, err := obj~>Pair()            // err is SignatureError\n\n// OK: return count matches\nr1, r2, err := obj~>Pair()        // r1 is any(42), r2 is any(\"ok\")\n\n// OK: with known LHS types\nvar n int\nvar s string\nn, s, err = obj~>Pair()           // n is 42, s is \"ok\"\n\n// Error: parameter count mismatch\nr1, err := obj~>Add()             // err is SignatureError (expects 1 arg)\nr1, err := obj~>Add(1, 2)         // err is SignatureError (expects 1 arg)\n\n// Error: parameter type mismatch\nr1, err := obj~>Add(\"wrong\")      // err is SignatureError (expects int)\n"}]}]},{"tag":"h3","attrs":{"id":"doc-implementation"},"children":[{"tag":"#text","text":"Implementation"}]},{"tag":"p","children":[{"tag":"#text","text":"The expected signature is encoded as an "},{"tag":"code","children":[{"tag":"#text","text":"rttid"}]},{"tag":"#text","text":" (runtime type ID) at compile time, including LHS types when known. At runtime, the "},{"tag":"code","children":[{"tag":"#text","text":"dyn_call_check"}]},{"tag":"#text","text":" function compares the closure's signature rttid against the expected signature rttid. If they don't match, a "},{"tag":"code","children":[{"tag":"#text","text":"SignatureError"}]},{"tag":"#text","text":" is returned without invoking the closure."}]},{"tag":"h2","attrs":{"id":"doc-implementation-details"},"children":[{"tag":"#text","text":"Implementation Details"}]},{"tag":"h3","attrs":{"id":"doc-type-checker-changes"},"children":[{"tag":"#text","text":"Type Checker Changes"}]},{"tag":"pre","attrs":{"data-language":"rust"},"children":[{"tag":"code","children":[{"tag":"#text","text":"// Dynamic access operator\n// If the base has static type any/interface, dynamic access returns (any, error).\nif base_type.is_any_or_interface() {\n    return Type::Tuple(Type::Any, Type::Error);\n}\n\n// If the base has static type (any, error), dynamic access also returns (any, error)\n// and short-circuits on the error component.\nif base_type.is_tuple_any_error() {\n    return Type::Tuple(Type::Any, Type::Error);\n}\n"}]}]},{"tag":"h3","attrs":{"id":"doc-codegen-changes"},"children":[{"tag":"#text","text":"Codegen Changes"}]},{"tag":"pre","attrs":{"data-language":"rust"},"children":[{"tag":"code","children":[{"tag":"#text","text":"// Dynamic access operations lower to runtime helper calls that return (value, error).\n// Postfix `?` is regular Vo error-propagation sugar.\na~>field           → dyn_get_attr(a, \"field\")                 // (any, error)\na~>field?          → dyn_get_attr(a, \"field\")?                // any\na~>[key]           → dyn_get_index(a, any(key))                // (any, error)\na~>[key]?          → dyn_get_index(a, any(key))?               // any\na~>(args...)       → dyn_call(a, any(args...))                 // (any, error)\na~>(args...)?      → dyn_call(a, any(args...))?                // any\n\n// Method call sugar\na~>method(args...) → dyn_call_method(a, \"method\", any(args...))  // (any, error)\n"}]}]},{"tag":"h3","attrs":{"id":"doc-chained-access-codegen-short-circuiting"},"children":[{"tag":"#text","text":"Chained Access Codegen (Short-circuiting)"}]},{"tag":"p","children":[{"tag":"#text","text":"When the left operand of "},{"tag":"code","children":[{"tag":"#text","text":"~>"}]},{"tag":"#text","text":" has type "},{"tag":"code","children":[{"tag":"#text","text":"(any, error)"}]},{"tag":"#text","text":", the generated code must short-circuit:"}]},{"tag":"pre","attrs":{"data-language":"rust"},"children":[{"tag":"code","children":[{"tag":"#text","text":"// a~>b~>c where a has type `any`\n// Desugars to:\n{\n    let (v1, e1) = dyn_get_attr(a, \"b\")\n    if e1 != nil {\n        (nil, e1)  // short-circuit\n    } else {\n        dyn_get_attr(v1, \"c\")\n    }\n}\n\n// Equivalently, using a helper:\ndyn_chain(dyn_get_attr(a, \"b\"), |v| dyn_get_attr(v, \"c\"))\n\n// where dyn_chain is:\nfn dyn_chain(base: (any, error), op: fn(any) -> (any, error)) -> (any, error) {\n    let (v, e) = base\n    if e != nil {\n        return (nil, e)\n    }\n    op(v)\n}\n"}]}]},{"tag":"h3","attrs":{"id":"doc-difference-abc-vs-abc"},"children":[{"tag":"#text","text":"Difference: "},{"tag":"code","children":[{"tag":"#text","text":"a~>b~>c"}]},{"tag":"#text","text":" vs "},{"tag":"code","children":[{"tag":"#text","text":"a~>b?~>c"}]}]},{"tag":"table","children":[{"tag":"thead","children":[{"tag":"tr","children":[{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"Expression"}]},{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"On "},{"tag":"code","children":[{"tag":"#text","text":"a~>b"}]},{"tag":"#text","text":" failure"}]},{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"Result type"}]}]}]},{"tag":"tbody","children":[{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"a~>b~>c"}]}]},{"tag":"td","children":[{"tag":"#text","text":"Short-circuit, return "},{"tag":"code","children":[{"tag":"#text","text":"(nil, err)"}]}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"(any, error)"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"a~>b?~>c"}]}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"?"}]},{"tag":"#text","text":" triggers "},{"tag":"code","children":[{"tag":"#text","text":"fail"}]},{"tag":"#text","text":", function exits"}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"(any, error)"}]}]}]}]}]},{"tag":"p","children":[{"tag":"#text","text":"The first form collects errors; the second form fails early."}]},{"tag":"h3","attrs":{"id":"doc-nil-interface"},"children":[{"tag":"#text","text":"nil Interface"}]},{"tag":"p","children":[{"tag":"#text","text":"If the base value is a nil interface, dynamic access returns "},{"tag":"code","children":[{"tag":"#text","text":"TypeError(\"cannot access on nil\")"}]},{"tag":"#text","text":"."}]},{"tag":"pre","attrs":{"data-language":"go"},"children":[{"tag":"code","children":[{"tag":"#text","text":"var a any = nil\nv, err := a~>field   // err is TypeError\n"}]}]},{"tag":"h3","attrs":{"id":"doc-compiler-lowering-sketch"},"children":[{"tag":"#text","text":"Compiler Lowering Sketch"}]},{"tag":"p","children":[{"tag":"#text","text":"The following pseudocode names describe internal lowering operations. They are\nnot source-level declarations and programs cannot import or call them directly."}]},{"tag":"pre","attrs":{"data-language":"rust"},"children":[{"tag":"code","children":[{"tag":"#text","text":"fn dyn_get_attr(d: any, name: &str) -> (any, error) {\n    match get_field(d, name) {\n        Ok(v) => (v, nil),\n        Err(e) => (any(nil), e),\n    }\n}\n\nfn dyn_get_index(d: any, key: any) -> (any, error) {\n    match get_index(d, key) {\n        Ok(v) => (v, nil),\n        Err(e) => (any(nil), e),\n    }\n}\n\n// dyn_assert not needed - uses standard interface type assertion\n\nfn dyn_set_attr(d: any, name: &str, val: any) -> error {\n    set_field(d, name, val)\n}\n\nfn dyn_set_index(d: any, key: any, val: any) -> error {\n    set_index(d, key, val)\n}\n\nfn dyn_call_method(d: any, method: &str, args: any, expected_sig: rttid) -> (any, error) {\n    match get_method(d, method) {\n        Ok(m) => dyn_call(m, args, expected_sig),\n        Err(e) => (any(nil), e),\n    }\n}\n"}]}]},{"tag":"h3","attrs":{"id":"doc-user-facing-helper-apis"},"children":[{"tag":"#text","text":"User-facing Helper APIs"}]},{"tag":"p","children":[{"tag":"#text","text":"Package "},{"tag":"code","children":[{"tag":"#text","text":"dyn"}]},{"tag":"#text","text":" exposes the complete explicit helper surface. These functions are\nuseful when callers need to handle a dynamic-operation error directly:"}]},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.GetAttr(base any, name string) (any, error)"}]}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.GetIndex(base any, key any) (any, error)"}]}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.SetAttr(base any, name string, value any) error"}]}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn.SetIndex(base any, key any, value any) error"}]}]}]},{"tag":"p","children":[{"tag":"#text","text":"Dynamic calls remain language operations written with "},{"tag":"code","children":[{"tag":"#text","text":"~>"}]},{"tag":"#text","text":"; the lowering ABI,\nsignature metadata, and runtime entry points are compiler implementation details."}]},{"tag":"h2","attrs":{"id":"doc-examples-2"},"children":[{"tag":"#text","text":"Examples"}]},{"tag":"h3","attrs":{"id":"doc-basic-usage"},"children":[{"tag":"#text","text":"Basic Usage"}]},{"tag":"pre","attrs":{"data-language":"go"},"children":[{"tag":"code","children":[{"tag":"#text","text":"func processJSON(data any) (string, error) {\n    a := data\n     \n    // Chained operations, each step is checked\n    userName := (a~>response~>data~>user~>name?).(string)\n    userAge := (a~>response~>data~>user~>age?).(int)\n    greeting := (a~>config~>greeting?).(string)\n\n    // Dynamic writes expose their errors.\n    dyn.SetAttr(a, \"last_user\", userName)?\n    dyn.SetIndex(a, \"last_age\", userAge)?\n    \n    // Complex expression\n    message := greeting + \" \" + userName\n    \n    return message, nil\n}\n"}]}]},{"tag":"h3","attrs":{"id":"doc-dynamic-set-with-explicit-error-handling"},"children":[{"tag":"#text","text":"Dynamic set with explicit error handling"}]},{"tag":"pre","attrs":{"data-language":"go"},"children":[{"tag":"code","children":[{"tag":"#text","text":"func updateCount(data any) error {\n    a := data\n\n    err := dyn.SetAttr(a, \"count\", 1)\n    err?\n\n    err = dyn.SetIndex(a, \"count\", 2)\n    err?\n\n    return nil\n}\n"}]}]},{"tag":"h3","attrs":{"id":"doc-writing-through-a-dynamically-obtained-value"},"children":[{"tag":"#text","text":"Writing through a dynamically obtained value"}]},{"tag":"pre","attrs":{"data-language":"go"},"children":[{"tag":"code","children":[{"tag":"#text","text":"func setNested(a any, v any) error {\n    child := a~>a?\n    dyn.SetAttr(child, \"b\", v)?\n    return nil\n}\n"}]}]},{"tag":"p","children":[{"tag":"#text","text":"The intermediate value must be a pointer or reference type when the mutation\nneeds to affect its original owner."}]},{"tag":"h3","attrs":{"id":"doc-safe-access-with-explicit-error"},"children":[{"tag":"#text","text":"Safe Access with explicit error"}]},{"tag":"pre","attrs":{"data-language":"go"},"children":[{"tag":"code","children":[{"tag":"#text","text":"func safeGet(data any, field string) (any, error) {\n\tv, err := dyn.GetAttr(data, field)\n    if err != nil {\n        return nil, err\n    }\n    return v, nil\n}\n"}]}]},{"tag":"h2","attrs":{"id":"doc-design-summary"},"children":[{"tag":"#text","text":"Design Summary"}]},{"tag":"table","children":[{"tag":"thead","children":[{"tag":"tr","children":[{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"Aspect"}]},{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":"Design"}]}]}]},{"tag":"tbody","children":[{"tag":"tr","children":[{"tag":"td","children":[{"tag":"#text","text":"Entry Point"}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"~>"}]},{"tag":"#text","text":" operator on supported types (see Supported Base Types)"}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"#text","text":"Protocol Methods"}]},{"tag":"td","children":[{"tag":"code","children":[{"tag":"#text","text":"DynAttr"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"DynSetAttr"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"DynIndex"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"DynSetIndex"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"DynCall"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"#text","text":"Dispatch"}]},{"tag":"td","children":[{"tag":"#text","text":"Protocol-first, then reflection fallback"}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"#text","text":"Result Type"}]},{"tag":"td","children":[{"tag":"#text","text":"Dynamic operations return "},{"tag":"code","children":[{"tag":"#text","text":"(any, error)"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"#text","text":"Error Handling"}]},{"tag":"td","children":[{"tag":"#text","text":"No error-carrying payload; check per-step via "},{"tag":"code","children":[{"tag":"#text","text":"?"}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"#text","text":"Runtime Layout"}]},{"tag":"td","children":[{"tag":"#text","text":"Base boxed to "},{"tag":"code","children":[{"tag":"#text","text":"any"}]},{"tag":"#text","text":", uses ordinary interface values"}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"#text","text":"Semantics"}]},{"tag":"td","children":[{"tag":"#text","text":"Whitelist + compile-time desugaring to helper calls"}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"#text","text":"Signature Check"}]},{"tag":"td","children":[{"tag":"#text","text":"Protocol method names require matching signatures (compile error otherwise)"}]}]}]}]}]}