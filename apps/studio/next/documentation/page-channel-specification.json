emain cyclic;"}]},{"tag":"li","children":[{"tag":"#text","text":"repeated map references continue to share one destination map;"}]},{"tag":"li","children":[{"tag":"#text","text":"slices preserve "},{"tag":"code","children":[{"tag":"#text","text":"len"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"cap"}]},{"tag":"#text","text":", start offset, and shared backing arrays;"}]},{"tag":"li","children":[{"tag":"#text","text":"different objects with equal contents remain different objects."}]}]},{"tag":"p","children":[{"tag":"#text","text":"The destination graph never aliases ordinary heap objects in the source\nisland. Port send capabilities keep endpoint identity and follow the separate\ncapability rules above."}]},{"tag":"p","children":[{"tag":"#text","text":"Finite object graphs are not rejected solely because their nesting exceeds a\nfixed depth. Validation, packing, and unpacking use cycle-aware graph walks, so\ndeep pointer and collection graphs preserve the same semantics as shallow ones.\nOrdinary allocation and serialized-size limits still apply, and validation\ncompletes before endpoint publication."}]},{"tag":"h3","attrs":{"id":"doc-example--compile-error-non-sendable-element-type"},"children":[{"tag":"#text","text":"Example — compile error: non-sendable element type"}]},{"tag":"pre","attrs":{"data-language":"go"},"children":[{"tag":"code","children":[{"tag":"#text","text":"out := make(port func(), 1)\n\ngo @(isl) func(dst port<- func()) {\n    dst <- myFunc\n}(out)\n"}]}]},{"tag":"p","children":[{"tag":"#text","text":"This is a compile error because "},{"tag":"code","children":[{"tag":"#text","text":"func()"}]},{"tag":"#text","text":" is not sendable."}]},{"tag":"hr"},{"tag":"h2","attrs":{"id":"doc-nil-endpoint-behavior"},"children":[{"tag":"#text","text":"Nil Endpoint Behavior"}]},{"tag":"table","children":[{"tag":"thead","children":[{"tag":"tr","children":[{"tag":"th","attrs":{"scope":"col"},"children":[{"tag":"#text","text":