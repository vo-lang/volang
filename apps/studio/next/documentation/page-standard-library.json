{"version":1,"headingID":"doc-standard-library","nodes":[{"tag":"p","children":[{"tag":"#text","text":"The standard library is source-distributed with the toolchain. Packages compile\nwith the application, while operations that require the operating system,\nnetwork, clock, process, or browser are provided through governed runtime and\nhost contracts."}]},{"tag":"h2","attrs":{"id":"doc-core-packages"},"children":[{"tag":"#text","text":"Core packages"}]},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"errors"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"fmt"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"strconv"}]},{"tag":"#text","text":", and "},{"tag":"code","children":[{"tag":"#text","text":"strings"}]},{"tag":"#text","text":" cover errors, formatting,\nconversions, and text."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"bytes"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"unicode"}]},{"tag":"#text","text":", and "},{"tag":"code","children":[{"tag":"#text","text":"unicode/utf8"}]},{"tag":"#text","text":" cover byte and Unicode processing."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"cmp"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"maps"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"slices"}]},{"tag":"#text","text":", and "},{"tag":"code","children":[{"tag":"#text","text":"sort"}]},{"tag":"#text","text":" provide common collection operations."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"math"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"math/bits"}]},{"tag":"#text","text":", and "},{"tag":"code","children":[{"tag":"#text","text":"math/rand"}]},{"tag":"#text","text":" provide numerical helpers."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"regexp"}]},{"tag":"#text","text":" provides regular-expression compilation and matching."}]}]},{"tag":"h2","attrs":{"id":"doc-encoding"},"children":[{"tag":"#text","text":"Encoding"}]},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"encoding/json"}]},{"tag":"#text","text":" encodes and decodes typed values and open dynamic values."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"encoding/toml"}]},{"tag":"#text","text":" handles TOML configuration data."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"encoding/base64"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"encoding/hex"}]},{"tag":"#text","text":", and "},{"tag":"code","children":[{"tag":"#text","text":"encoding/binary"}]},{"tag":"#text","text":" cover binary\ninterchange."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"encoding/csv"}]},{"tag":"#text","text":" reads and writes row-oriented text data."}]}]},{"tag":"p","children":[{"tag":"#text","text":"Prefer typed structs for stable schemas. Use "},{"tag":"code","children":[{"tag":"#text","text":"any"}]},{"tag":"#text","text":" and the "},{"tag":"code","children":[{"tag":"#text","text":"dyn"}]},{"tag":"#text","text":" package when a\nschema is intentionally open."}]},{"tag":"h2","attrs":{"id":"doc-io-files-and-processes"},"children":[{"tag":"#text","text":"I/O, files, and processes"}]},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"io"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"io/fs"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"bufio"}]},{"tag":"#text","text":", and "},{"tag":"code","children":[{"tag":"#text","text":"bytes"}]},{"tag":"#text","text":" define stream, filesystem, buffering, and\nin-memory byte contracts."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"os"}]},{"tag":"#text","text":", "},{"tag":"code","children":[{"tag":"#text","text":"path"}]},{"tag":"#text","text":", and "},{"tag":"code","children":[{"tag":"#text","text":"path/filepath"}]},{"tag":"#text","text":" expose host filesystem and path behavior."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"os/exec"}]},{"tag":"#text","text":" starts governed child processes on hosts that grant the capability."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"flag"}]},{"tag":"#text","text":" parses command-line flags."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"log"}]},{"tag":"#text","text":" supplies structured application logging primitives."}]}]},{"tag":"p","children":[{"tag":"#text","text":"Host-dependent functions can report unsupported capability on sandboxed\ntargets. Libraries should accept interfaces such as readers, writers, and\nfilesystems so callers can provide deterministic test implementations."}]},{"tag":"h2","attrs":{"id":"doc-network-and-urls"},"children":[{"tag":"#text","text":"Network and URLs"}]},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"net"}]},{"tag":"#text","text":" defines addresses and connection-level contracts."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"net/http"}]},{"tag":"#text","text":" supplies HTTP request, response, client, and server behavior where\nthe host supports it."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"net/url"}]},{"tag":"#text","text":" parses and constructs URLs."}]}]},{"tag":"p","children":[{"tag":"#text","text":"Browser networking remains subject to origin and host policy. Desktop and\nembedded hosts should grant the narrowest authority needed by the application."}]},{"tag":"h2","attrs":{"id":"doc-time-context-and-synchronization"},"children":[{"tag":"#text","text":"Time, context, and synchronization"}]},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"time"}]},{"tag":"#text","text":" provides instants, durations, timers, and formatting."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"context"}]},{"tag":"#text","text":" carries cancellation, deadlines, and request-scoped values."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"sync"}]},{"tag":"#text","text":" provides synchronization primitives for supported shared-runtime\nscenarios."}]},{"tag":"li","children":[{"tag":"#text","text":"Channels remain the preferred coordination primitive between goroutines in\none island. Ports carry messages across islands."}]}]},{"tag":"h2","attrs":{"id":"doc-runtime-packages"},"children":[{"tag":"#text","text":"Runtime packages"}]},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"runtime"}]},{"tag":"#text","text":" exposes scheduler and runtime information intended for application\nuse."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"runtime/mem"}]},{"tag":"#text","text":" exposes bounded memory observations and controls where the\nbackend contract permits them."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"toolchain"}]},{"tag":"#text","text":" exposes versioned toolchain facts to governed generators and\nbuild integrations."}]},{"tag":"li","children":[{"tag":"code","children":[{"tag":"#text","text":"dyn"}]},{"tag":"#text","text":" defines the dynamic-access protocol and stable error categories."}]}]},{"tag":"h2","attrs":{"id":"doc-portability"},"children":[{"tag":"#text","text":"Portability"}]},{"tag":"p","children":[{"tag":"#text","text":"Package presence alone does not grant a platform effect. The same API can be\nimplemented by a native provider, a Web host import, a deterministic test\nprovider, or an unsupported-capability response. Check errors and declare UI\nplatform requirements in the application manifest."}]},{"tag":"p","children":[{"tag":"#text","text":"The maintained package source lives under "},{"tag":"code","children":[{"tag":"#text","text":"lang/stdlib"}]},{"tag":"#text","text":". Its tests in\n"},{"tag":"code","children":[{"tag":"#text","text":"tests/lang"}]},{"tag":"#text","text":" are the executable compatibility contract across VM, JIT, GC\nstress, Native AOT, and Wasm VM lanes."}]}]}