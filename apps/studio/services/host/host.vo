// Package host adapts the versioned Studio capability interfaces to the
// renderer-neutral application-host invocation boundary.
package host

import (
	"context"
	"encoding/json"
	"errors"
	"github.com/vo-lang/studio/domain"
	"github.com/vo-lang/studio/protocol"
	"github.com/vo-lang/ui/system"
)

const MaxRunBatch = 128

type Service struct{}

func New() *Service {
	return &Service{}
}

func (service *Service) Services() protocol.Services {
	return protocol.Services{
		Host: service, Files: service, Language: service, Compiler: service, Runner: service,
		Preview: service, Share: service, Account: service, Remote: service, Credentials: service,
	}
}

type hostInfoResponse struct {
	Info domain.HostInfo
}

func (service *Service) Info(ctx context.Context) (domain.HostInfo, error) {
	var response hostInfoResponse
	err := call(ctx, "host.info", struct{}{}, &response)
	return response.Info, err
}

func call(ctx context.Context, operation string, request interface{}, response interface{}) error {
	if err := ctx.Err(); err != nil {
		return err
	}
	payload, err := json.Marshal(request)
	if err != nil {
		return err
	}
	result, err := system.InvokeHost(protocol.Version, operation, payload)
	if err != nil {
		return err
	}
	if err := ctx.Err(); err != nil {
		return err
	}
	if response == nil {
		return nil
	}
	if len(result) == 0 {
		return errors.New("Studio host returned an empty response")
	}
	return json.Unmarshal(result, response)
}

