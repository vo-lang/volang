type remoteStartResponse struct {
	SessionID string
}

type remoteNextRequest struct {
	SessionID string
}

type remoteNextResponse struct {
	Done bool
	Progress string
	Error string
}

func remoteOperation(ctx context.Context, operation string, request interface{}, progress func(string)) error {
	var started remoteStartResponse
	if err := call(ctx, operation, request, &started); err != nil {
		return err
	}
	if started.SessionID == "" {
		return errors.New("Studio host returned an empty remote operation session")
	}
	stop := func() {
		_ = call(context.Background(), "remote.stop", remoteNextRequest{SessionID: started.SessionID}, nil)
	}
	for {
		select {
			case <-ctx.Done():
				stop()
				return ctx.Err()
			default:
		}
		var next remoteNextResponse
		if err := call(context.Background(), "remote.next", remoteNextRequest{SessionID: started.SessionID}, &next); err != nil {
			if ctx.Err() != nil {
				stop()
				return ctx.Err()
			}
			return err
		}
		if next.Progress != "" && progress != nil {
			progress(next.Progress)
		}
		if next.Done {
			if next.Error != "" {
				return errors.New(next.Error)
			}
			return nil
		}
	}
}

func (service *Service) Pull(ctx context.Context, id domain.ProjectID, progress func(string)) error {
	return remoteOperation(ctx, "remote.pull", projectRequest{ProjectID: id}, progress)
}

