type artifactResponse struct {
	Artifact domain.Artifact
	ID string
	Kind domain.ArtifactKind
	Entry string
	Bytes []byte
	Diagnostics []domain.Diagnostic
}

func (service *Service) Compile(ctx context.Context, request protocol.CompileRequest) (domain.Artifact, error) {
	var response artifactResponse
	err := call(ctx, "compiler.compile", request, &response)
	if response.ID != "" {
		return domain.Artifact{
			ID: response.ID, Kind: response.Kind, Entry: response.Entry, Bytes: response.Bytes,
			Diagnostics: response.Diagnostics,
		}, err
	}
	return response.Artifact, err
}

type runStartResponse struct {
	SessionID string
}

type runNextRequest struct {
	SessionID string
	Maximum int
}

type runNextResponse struct {
	Events []domain.RunEvent
	Done bool
}

type runStopRequest struct {
	SessionID string
}

func publish(ctx context.Context, output chan domain.RunEvent, event domain.RunEvent) bool {
	select {
		case <-ctx.Done():
			return false
		case output <- event:
			return true
	}
}

func (service *Service) Run(ctx context.Context, request protocol.RunRequest) (<-chan domain.RunEvent, error) {
	var started runStartResponse
	if err := call(ctx, "run.start", request, &started); err != nil {
		return nil, err
	}
	if started.SessionID == "" {
		return nil, errors.New("Studio host returned an empty run session")
	}
	output := make(chan domain.RunEvent, MaxRunBatch)
	go func() {
		for {
			if ctx.Err() != nil {
				_ = call(context.Background(), "run.stop", runStopRequest{SessionID: started.SessionID}, nil)
				close(output)
				return
			}
			var response runNextResponse
			if err := call(ctx, "run.next", runNextRequest{
				SessionID: started.SessionID, Maximum: MaxRunBatch,
			}, &response); err != nil {
				if ctx.Err() == nil {
					publish(ctx, output, domain.RunEvent{Kind: domain.RunStderr, Text: err.Error()})
				}
				close(output)
				return
			}
			for _, event := range response.Events {
				if !publish(ctx, output, event) {
					close(output)
					return
				}
			}
			if response.Done {
				close(output)
				return
			}
		}
	}()
	return output, nil
}

