}

type credentialRequest struct {
	Key string
}

type credentialSetRequest struct {
	Key string
	Value string
}

type credentialResponse struct {
	Value string
	Present bool
}

func (service *Service) Get(ctx context.Context, key string) (string, bool, error) {
	var response credentialResponse
	err := call(ctx, "credentials.get", credentialRequest{Key: key}, &response)
	return response.Value, response.Present, err
}

func (service *Service) Set(ctx context.Context, key string, value string) error {
	return call(ctx, "credentials.set", credentialSetRequest{Key: key, Value: value}, nil)
}

func (service *Service) Delete(ctx context.Context, key string) error {
	return call(ctx, "credentials.delete", credentialRequest{Key: key}, nil)
}
