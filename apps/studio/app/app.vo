}

func (state *State) SetPaletteSelection(value int64) {
	state.mu.Lock()
	state.paletteSelected = value
	state.mu.Unlock()
	ui.Invalidate()
}

func searchLinePreview(value string) string {
	preview := strings.TrimSpace(value)
	runes := []rune(preview)
	if len(runes) > 140 {
		preview = string(runes[:137]) + "…"
	}
	return preview
}

func searchFile(path string, text string, query string) []workspaceSearchResult {
	results := make([]workspaceSearchResult, 0)
	for index, line := range strings.Split(text, "\n") {
		lower := strings.ToLower(line)
		columnBytes := strings.Index(lower, query)
		if columnBytes < 0 {
			continue
		}
		column := len([]rune(lower[:columnBytes]))
		results = append(results, workspaceSearchResult{
			Path: path, Line: index + 1, Column: column + 1, Preview: searchLinePreview(line),
		})
	}
	if len(results) == 0 && strings.Contains(strings.ToLower(path), query) {
		results = append(results, workspaceSearchResult{Path: path, Preview: "File name match"})
	}
	return results
}

func (state *State) Search(value string) {
	state.mu.Lock()
	state.searchQuery = value
	if state.searchCancel != nil {
		state.searchCancel()
	}
	ctx, cancel := context.WithCancel(context.Background())
	state.searchCancel = cancel
	state.searchGeneration++
	generation := state.searchGeneration
	project := state.current
	projectGeneration := state.projectGeneration
	jobsInput := make([]searchJob, 0, len(state.files))
	for _, file := range state.files {
		if file.Kind != domain.Directory {
			job := searchJob{Index: len(jobsInput), File: file}
			if code := state.buffers[file.Path]; code != nil {
				job.Text, _ = code.Document.Snapshot()
				job.HasText = true
			}
			jobsInput = append(jobsInput, job)
		}
	}
	query := strings.ToLower(strings.TrimSpace(value))
	if query == "" {
		state.searchResults = nil
		state.searching = false
		state.searchCancel = nil
		state.mu.Unlock()
		cancel()
		ui.Invalidate()
		return
	}
	state.searching = true
	state.mu.Unlock()
	go func() {
		jobs := make(chan searchJob, MaxSearchWorkers)
		output := make(chan searchFileMatches, MaxSearchWorkers)
		workers := MaxSearchWorkers
		if len(jobsInput) < workers {
			workers = len(jobsInput)
		}
		wg := &sync.WaitGroup{}
		for worker := 0; worker < workers; worker++ {
			wg.Go(func() {
				for job := range jobs {
					text := job.Text
					var err error
					if !job.HasText {
						text, err = state.services.Files.ReadFile(ctx, project.ID, job.File.Path)
					}
					values := make([]workspaceSearchResult, 0)
					if err == nil {
						values = searchFile(job.File.Path, text, query)
					}
					select {
						case output <- searchFileMatches{Index: job.Index, Values: values}:
						case <-ctx.Done():
							return
					}
				}
			})
		}
		go func() {
			for _, job := range jobsInput {
				select {
					case jobs <- job:
					case <-ctx.Done():
						close(jobs)
						return
				}
			}
			close(jobs)
		}()
		go func() {
			wg.Wait()
			close(output)
		}()
		buckets := make([][]workspaceSearchResult, len(jobsInput))
		for matches := range output {
			buckets[matches.Index] = matches.Values
		}
		results := make([]workspaceSearchResult, 0)
		for _, values := range buckets {
			for _, result := range values {
				if len(results) >= MaxSearchResults {
					break
				}
				results = append(results, result)
			}
			if len(results) >= MaxSearchResults {
				break
			}
		}
		state.mu.Lock()
		if generation == state.searchGeneration && projectGeneration == state.projectGeneration &&
			state.current.ID == project.ID && ctx.Err() == nil {
			state.searchResults = results
			state.searching = false
			state.searchCancel = nil
		}
		state.mu.Unlock()
		ui.Invalidate()
	}()
}

func (state *State) OpenSearchResult(result workspaceSearchResult) {
	if result.Line <= 0 {
		state.OpenFile(result.Path)
		return
	}
	state.OpenDiagnostic(domain.Diagnostic{
		Path: result.Path, Line: result.Line, Column: result.Column,
		EndLine: result.Line, EndColumn: result.Column + 1,
	})
}

func (state *State) ActivityRail() ui.View {
	state.mu.RLock()
	selected := state.activity
	state.mu.RUnlock()
	home := design.ActivityButton(icons.Home, "Home", "Home", selected == ActivityHome, state.ShowHome)
	explorer := design.ActivityButton(icons.Folder, "Explorer", "Files", selected == ActivityExplorer, func() {
		state.SetActivity(ActivityExplorer)
	})
	search := design.ActivityButton(icons.Search, "Search", "Search", selected == ActivitySearch, func() {
		state.SetActivity(ActivitySearch)
	})
	sourceControl := design.ActivityButton(icons.Branch, "Source Control", "Source", selected ==
		ActivitySourceControl, func() {
		state.SetActivity(ActivitySourceControl)
	})
	docs := design.ActivityButton(icons.Book, "Documentation", "Docs", selected == ActivityDocs, state.ShowDocs)
	if ui.CurrentEnvironment().ViewportWidth < 840 {
		activities := ui.Justify(ui.Row(home, explorer, search, sourceControl, docs), ui.JustifySpaceAround)
		view := ui.MinHeight(ui.Padding(activities, design.Space1), 54)
		view = ui.Background(view, design.Canvas)
		view = ui.Role(view, "navigation")
		return ui.AccessibleName(view, "Studio activities")
	}
	activities := ui.Gap(ui.Column(home, explorer, search, sourceControl, docs), design.Space2)
	view := ui.Padding(ui.Column(activities, ui.Flex(ui.Box(), 1)), design.Space2)
	view = ui.Width(view, 64)
	view = ui.Background(view, design.Canvas)
	view = ui.Role(view, "navigation")
	return ui.AccessibleName(view, "Studio activities")
}

func (state *State) Home() ui.View {
	state.mu.RLock()
	projects := append([]domain.Project(nil), state.projects...)
	current := state.current
	host := state.host
	opening := state.openingExample
	projectSearchQuery := state.projectSearchQuery
	state.mu.RUnlock()
	viewportWidth := ui.CurrentEnvironment().ViewportWidth
	newProject := design.PrimaryButton("New project", state.ToggleProjectCreator)
	openCounter := design.QuietButton("Open UIKit starter", func() {
		state.OpenExample("counter")
	})
	openConcurrency := design.QuietButton("Open goroutine lab", func() {
		state.OpenExample("channels")
	})
	quickActionColumns := "repeat(2, minmax(0px, 1fr))"
	if viewportWidth < 600 {
		quickActionColumns = "minmax(0px, 1fr)"
	}
	quickActions := ui.GridColumns(ui.Gap(ui.Grid(newProject, openCounter, openConcurrency, design.QuietButton("Read documentation", state.ShowDocs)), design.Space2), quickActionColumns)
	quickStart := design.DashboardPanel("QUICK START", "Create and run", "Start from a focused project or an editable example.", quickActions)
	platform := host.Platform
	if platform == "" {
		platform = "Initializing"
	}
	runtimeStatus := "VM"
	if supportsRuntimeMode(host, domain.RuntimeJIT) {
		runtimeStatus = "VM + JIT"
	}
	previewStatus := "Unavailable"
	previewColor := design.TextMuted
	if host.CanPreview {
		previewStatus = "Ready"
		previewColor = design.Success
	}
	environmentRows := ui.Gap(ui.Column(design.CapabilityRow("Host", platform, design.Accent), design.CapabilityRow("Development runtime", runtimeStatus, design.Warning), design.CapabilityRow("Live preview", previewStatus, previewColor), design.CapabilityRow("Release targets", "WebAssembly + native", design.Success)), design.Space3)
	environment := design.DashboardPanel("ENVIRONMENT", "Toolchain ready", "The same typed application crosses development and release hosts.", environmentRows)
	startColumns := "minmax(0px, 1fr) minmax(0px, 1fr)"
	if viewportWidth < 900 {
		startColumns = "minmax(0px, 1fr)"
	}
	startGrid := ui.GridColumns(ui.Gap(ui.Grid(quickStart, environment), design.Space3), startColumns)
	pageHeading := design.SectionHeading("VOLANG STUDIO", "Start", "Build, inspect, and ship pure Volang applications from one workspace.", ui.Box())
	uiExampleViews := make([]ui.View, 0)
	languageExampleViews := make([]ui.View, 0)
	for _, example := range studioexamples.Catalog() {
		item := example
		card := design.StarterCard(item.Monogram, item.Title, item.File, item.Description, item.Tags, item.HasUI, opening !=
			"", func() {
			state.OpenExample(item.ID)
		})
		if item.HasUI {
			uiExampleViews = append(uiExampleViews, ui.Key(card, "starter-" + item.ID))
		} else {
			languageExampleViews = append(languageExampleViews, ui.Key(card, "starter-" + item.ID))
		}
	}
	exampleColumns := "repeat(3, minmax(0px, 1fr))"
	if viewportWidth < 1260 {
		exampleColumns = "repeat(2, minmax(0px, 1fr))"
	}
	if viewportWidth < 860 {
		exampleColumns = "repeat(1, minmax(0px, 1fr))"
	}
	uiExamplesGrid := ui.GridColumns(ui.Gap(ui.Grid(uiExampleViews...), design.Space3), exampleColumns)
	languageExamplesGrid := ui.GridColumns(ui.Gap(ui.Grid(languageExampleViews...), design.Space3), exampleColumns)
	projectViews := make([]ui.View, 0, len(projects))
	normalizedProjectQuery := strings.ToLower(strings.TrimSpace(projectSearchQuery))
	for _, project := range projects {
		item := project
		if normalizedProjectQuery != "" &&
			!strings.Contains(strings.ToLower(item.Name), normalizedProjectQuery) {
			continue
		}
		projectViews = append(projectViews, ui.Key(design.ProjectCard(item.Name, item.Root, item.ID ==
			current.ID, item.Managed, func() {
			state.SelectProject(item.ID)
		}, func() {
			state.BeginRenameProject(item)
		}, func() {
			state.BeginDeleteProject(item)
		}), "home-project-" + string(item.ID)))
	}
	projectColumns := "repeat(2, minmax(0px, 1fr))"
	if viewportWidth < 900 {
		projectColumns = "repeat(1, minmax(0px, 1fr))"
	}
	projectContent := ui.GridColumns(ui.Gap(ui.Grid(projectViews...), design.Space3), projectColumns)
	if len(projects) == 0 {
		projectContent = design.EmptyState("No projects yet", "Open a starter or create a blank UIKit project.", design.PrimaryButton("Create project", state.ToggleProjectCreator))
	} else if len(projectViews) == 0 {
		projectContent = design.EmptyState("No matching projects", "Try a shorter project name.", ui.Box())
	}
	projectSearch := ui.AccessibleName(ui.TextInput(projectSearchQuery, "Search projects", ui.TextChange(state.SetProjectSearchQuery)), "Search projects")
	projectActions := ui.Width(projectSearch, 260)
	projectHeading := design.SectionHeading("RECENT", "Your projects", "Persistent projects and local workspaces available on this device.", projectActions)
	uiHeading := design.SectionHeading("STARTERS", "UIKit applications", "Open, edit, run, and preview complete cross-platform examples.", ui.Box())
	languageHeading := design.SectionHeading("LANGUAGE LAB", "Learn by running", "Focused projects for goroutines, channels, errors, types, files, text, and time.", ui.Box())
	content := ui.Gap(ui.Column(pageHeading, startGrid, uiHeading, uiExamplesGrid, projectHeading, projectContent, languageHeading, languageExamplesGrid), design.Space5)
	content = ui.Flex(ui.MaxWidth(content, 1280), 1)
	content = ui.Justify(ui.Row(content), ui.JustifyCenter)
	pagePadding := design.Space6
	if viewportWidth < 600 {
		pagePadding = design.Space3
	}
	return ui.TestID(ui.Scroll(ui.Padding(content, pagePadding)), "studio-home")
}

func (state *State) ProjectRenameDialog() ui.View {
	state.mu.RLock()
	visible := state.renameProjectVisible
	name := state.renameProjectName
	originalName := state.renameProject.Name
	errorMessage := state.renameProjectError
	busy := state.projectMutationBusy
	state.mu.RUnlock()
	if !visible {
		return ui.Fragment()
	}
	input := ui.AccessibleName(ui.TextInput(name, "project-name", ui.TextChange(state.SetRenameProjectName)), "Renamed project name")
	feedback := ui.Box()
	if errorMessage != "" {
		input = ui.AccessibleDescription(input, errorMessage)
		feedback = kitcomponents.Alert(design.StudioTheme(), "Invalid project name", errorMessage, kitcomponents.IntentDanger, false)
	}
	confirm := ui.Disabled(design.PrimaryButton("Rename project", state.RenameProject), busy ||
		projectNameError(name) != "" || strings.TrimSpace(name) == originalName)
	content := ui.Gap(ui.Column(design.Muted("Choose a filesystem-safe project name."), input, feedback, confirm), design.Space3)
	return design.ModalDialog("Rename project", true, content, state.HideRenameProject)
}

func (state *State) ProjectDeleteDialog() ui.View {
	state.mu.RLock()
	visible := state.deleteProjectVisible
	project := state.deleteProject
	busy := state.projectMutationBusy
	state.mu.RUnlock()
	if !visible {
		return ui.Fragment()
	}
	title := "Forget project"
	message := "Remove “" + project.Name +
		"” from Studio while keeping every file in its external folder?"
	warning := "The project can be opened again later."
	buttonLabel := "Forget project"
	if project.Managed {
		title = "Delete project"
		message = "Delete “" + project.Name + "” and every file in its managed workspace?"
		warning = "This operation cannot be undone."
		buttonLabel = "Delete project permanently"
	}
	confirm := ui.Disabled(design.PrimaryButton(buttonLabel, state.ConfirmDeleteProject), busy)
	content := ui.Gap(ui.Column(ui.Foreground(ui.Text(message), design.TextSecondary), ui.Foreground(ui.Text(warning), design.Danger), confirm), design.Space3)
	return design.ModalDialog(title, true, content, state.HideDeleteProject)
}

func (state *State) PendingConfirmationDialog() ui.View {
	state.mu.RLock()
	switchVisible := state.projectSwitchProject.ID != ""
	project := state.projectSwitchProject
	closeVisible := state.closeFilePath != ""
	closePath := state.closeFilePath
	deleteVisible := state.deleteFilePath != ""
	deletePath := state.deleteFilePath
	state.mu.RUnlock()
	if !switchVisible && !closeVisible && !deleteVisible {
		return ui.Fragment()
	}
	title := "Open " + project.Name
	message := "Open “" + project.Name + "” and discard every unsaved editor change in the current project?"
	warning := "Unsaved changes will be discarded."
	buttonLabel := "Discard changes and open project"
	confirm := state.ConfirmProjectSwitch
	cancel := state.HideProjectSwitchDialog
	if closeVisible {
		title = "Close " + closePath
		message = "Close “" + closePath + "” and discard its unsaved changes?"
		warning = ""
		buttonLabel = "Discard changes and close editor"
		confirm = state.ConfirmCloseFile
		cancel = state.HideCloseFileDialog
	} else if deleteVisible {
		title = "Delete " + deletePath
		message = "Delete “" + deletePath + "” from the current project?"
		warning = "This operation cannot be undone."
		buttonLabel = "Delete file permanently"
		confirm = state.ConfirmDeleteFile
		cancel = state.HideDeleteFileDialog
	}
	views := []ui.View{ui.Foreground(ui.Text(message), design.TextSecondary)}
	if warning != "" {
		views = append(views, ui.Foreground(ui.Text(warning), design.Danger))
	}
	views = append(views, design.DangerButton(buttonLabel, confirm))
	return design.ModalDialog(title, true, ui.Gap(ui.Column(views...), design.Space3), cancel)
}

func (state *State) RemoteDeleteDialog() ui.View {
	state.mu.RLock()
	visible := state.remoteDeleteVisible
	target := state.remote.DeleteTarget
	confirmation := state.remoteDeleteConfirmation
	busy := state.remoteDeleteBusy
	managed := state.current.Managed
	state.mu.RUnlock()
	if !visible {
		return ui.Fragment()
	}
	detail := "Type “" + target +
		"” to confirm. This permanently deletes the GitHub repository and removes the local origin remote."
	input := ui.AccessibleName(ui.TextInput(confirmation, target, ui.TextChange(state.SetRemoteDeleteConfirmation)), "Repository deletion confirmation")
	disabled := busy || strings.TrimSpace(confirmation) != target
	cloudOnly := ui.Disabled(design.DangerButton("Delete cloud repository", func() {
		state.DeleteRemote(false)
	}), disabled)
	combinedLabel := "Delete cloud & forget project"
	if managed {
		combinedLabel = "Delete cloud & local project"
	}
	combined := ui.Disabled(design.DangerButton(combinedLabel, func() {
		state.DeleteRemote(true)
	}), disabled)
	actions := ui.Gap(ui.Column(cloudOnly, combined), design.Space2)
	if busy {
		actions = design.Muted("Deletion in progress…")
	}
	content := ui.Gap(ui.Column(kitcomponents.Alert(design.StudioTheme(), "Permanent operation", detail, kitcomponents.IntentDanger, true), input, actions), design.Space3)
	return design.ModalDialog("Delete GitHub repository", true, content, state.HideRemoteDelete)
}

func (state *State) ProjectShareDialog() ui.View {
	state.mu.RLock()
	visible := state.shareVisible
	loading := state.shareLoading
	result := state.share
	mode := preferredRuntimeMode(state.host)
	state.mu.RUnlock()
	if !visible {
		return ui.Fragment()
	}
	if loading {
		return design.ModalDialog("Share project", true, design.EmptyState("Creating links", "Studio is packaging the saved source snapshot.", ui.Box()), state.HideShareProject)
	}
	if !result.Shareable {
		action := ui.Box()
		if result.DevelopmentLink != "" {
			action = design.QuietButton("Copy repository link", func() {
				state.copyProjectLink(result.DevelopmentLink, "Repository link")
			})
		}
		message := result.Reason
		if message == "" {
			message = "This project does not have a portable sharing target."
		}
		return design.ModalDialog("Share project", true, design.EmptyState("Portable link unavailable", message, action), state.HideShareProject)
	}
	linkView := func(label string, value string, copyLabel string) ui.View {
		caption := ui.FontSize(ui.FontWeight(ui.Foreground(ui.Text(label), design.TextSecondary), 650), 11)
		displayValue := value
		if marker := strings.Index(value, "#share="); marker >= 0 {
			displayValue = value[:marker] + "#share=<portable-snapshot>"
		}
		address := ui.Padding(ui.Background(ui.Foreground(ui.Text(displayValue), design.TextSecondary), design.SurfaceSunken), design.Space3)
		address = ui.Radius(address, 8)
		return ui.Gap(ui.Column(caption, address, design.QuietButton("Copy " + copyLabel, func() {
			state.copyProjectLink(value, label)
		})), design.Space2)
	}
	development := linkView("Studio link", result.DevelopmentLink, "Studio link")
	runner := linkView("Runner link", result.RunnerLink, "Runner link")
	openRunner := ui.AccessibleName(design.PrimaryButton("Open Runner", func() {
		state.StartRun(mode, true)
		target := result.RunnerLink
		if marker := strings.Index(target, "/runner"); marker >= 0 {
			target = target[marker:]
		}
		ui.Navigate(target)
		state.mu.Lock()
		state.shareVisible = false
		state.mu.Unlock()
		ui.Invalidate()
	}), "Open shared project Runner")
	actions := ui.Row(openRunner)
	content := ui.Gap(ui.Column(design.Muted("Both links contain an immutable saved source snapshot. The Runner opens without editor chrome."), development, runner, actions), design.Space4)
	return design.ModalDialog("Share project", true, content, state.HideShareProject)
}

func (state *State) AccountDialog() ui.View {
	state.mu.RLock()
	visible := state.accountVisible
	loading := state.accountLoading
	account := state.account
	platform := state.host.Platform
	state.mu.RUnlock()
	if !visible {
		return ui.Fragment()
	}
	if loading {
		return design.ModalDialog("GitHub account", true, design.EmptyState("Connecting account", "The platform host is completing the account request.", design.Badge("working", design.Accent)), state.HideAccount)
	}
	if account.Connected {
		name := account.Name
		if name == "" {
			name = account.Login
		}
		detail := "@" + account.Login + " · identity is isolated in the platform host"
		content := ui.Gap(ui.Column(design.SectionHeading("GITHUB", name, detail, design.Badge("connected", design.Success)), design.Muted("Disconnecting Studio leaves GitHub CLI or the provider account itself unchanged."), design.QuietButton("Disconnect account", state.DisconnectAccount)), design.Space4)
		return design.ModalDialog("GitHub account", true, content, state.HideAccount)
	}
	description := "Native Studio connects through the authenticated GitHub CLI and receives display-only identity data."
	if platform == "web" {
		description = "The browser host uses a secure one-time token dialog for account verification and never persists the credential."
	}
	content := ui.Gap(ui.Column(design.Muted(description), ui.AccessibleName(design.PrimaryButton("Connect GitHub", state.ConnectAccount), "Connect GitHub account")), design.Space4)
	return design.ModalDialog("GitHub account", true, content, state.HideAccount)
}

func (state *State) NewFileDialog() ui.View {
	state.mu.RLock()
	visible := state.newFileVisible
	path := state.newFilePath
	busy := state.projectMutationBusy
	savePending := state.savePending
	state.mu.RUnlock()
	if !visible {
		return ui.Fragment()
	}
	errorMessage := relativePathError(path)
	input := ui.AccessibleName(ui.TextInput(path, "path/to/file.vo", ui.TextChange(state.SetNewFilePath)), "New file path")
	if errorMessage != "" {
		input = ui.AccessibleDescription(input, errorMessage)
	}
	feedback := ui.Box()
	if errorMessage != "" {
		feedback = kitcomponents.Alert(design.StudioTheme(), "Invalid file path", errorMessage, kitcomponents.IntentDanger, false)
	}
	create := ui.Disabled(design.PrimaryButton("Create file", state.CreateFile), busy || savePending > 0 ||
		!validRelativePath(path))
	content := ui.Gap(ui.Column(design.Muted("Use a path relative to the current project."), input, feedback, create), design.Space3)
	return design.ModalDialog("New file", true, content, state.HideNewFileDialog)
}

func (state *State) RenameFileDialog() ui.View {
	state.mu.RLock()
	visible := state.renameFileVisible
	from := state.activePath
	path := state.renamePath
	busy := state.projectMutationBusy
	state.mu.RUnlock()
	if !visible {
		return ui.Fragment()
	}
	errorMessage := relativePathError(path)
	input := ui.AccessibleName(ui.TextInput(path, "new/path.vo", ui.TextChange(state.SetRenamePath)), "Rename active file")
	if errorMessage != "" {
		input = ui.AccessibleDescription(input, errorMessage)
	}
	feedback := ui.Box()
	if errorMessage != "" {
		feedback = kitcomponents.Alert(design.StudioTheme(), "Invalid file path", errorMessage, kitcomponents.IntentDanger, false)
	}
	rename := ui.Disabled(design.PrimaryButton("Rename file", state.RenameActiveFile), busy ||
		!validRelativePath(path) || path == from)
	content := ui.Gap(ui.Column(design.Muted("Rename " + from + " inside the current project."), input, feedback, rename), design.Space3)
	return design.ModalDialog("Rename file", true, content, state.HideRenameFileDialog)
}

func fileGlyph(kind domain.FileKind) string {
	if kind == domain.Directory {
		return "▾ "
	}
	if kind == domain.ModuleFile {
		return "◇ "
	}
	if kind == domain.DocumentationFile {
		return "≡ "
	}
	if kind == domain.SourceFile {
		return "V "
	}
	return "· "
}

func fileHiddenByCollapsedDirectory(path string, collapsed map[string]bool) bool {
	for directory, hidden := range collapsed {
		if hidden && strings.HasPrefix(path, directory + "/") {
			return true
		}
	}
	return false
}

func (state *State) ToggleDirectory(path string) {
	state.mu.Lock()
	state.collapsedDirectories[path] = !state.collapsedDirectories[path]
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) Explorer() ui.View {
	state.mu.RLock()
	projects := append([]domain.Project(nil), state.projects...)
	current := state.current
	files := append([]domain.FileEntry(nil), state.files...)
	active := state.activePath
	projectCreatorVisible := state.projectCreatorVisible
	newProjectName := state.newProjectName
	newProjectError := state.newProjectError
	newProjectFocusToken := state.newProjectFocusToken
	projectCreationBusy := state.projectCreationBusy
	projectMutationBusy := state.projectMutationBusy
	savePending := state.savePending
	canOpenLocal := state.host.CanOpenLocal
	dirty := make(map[string]bool)
	for path, value := range state.dirty {
			dirty[path] = value
	}
	collapsed := make(map[string]bool)
	for path, value := range state.collapsedDirectories {
		collapsed[path] = value
	}
	state.mu.RUnlock()
	compact := ui.CurrentEnvironment().ViewportWidth < 840
	projectViews := make([]ui.View, 0, len(projects))
	for _, project := range projects {
		item := project
		label := item.Name
		if item.ID == current.ID {
			label = "● " + label
		}
		projectButton := design.SidebarItem(label, item.ID == current.ID, func() {
			state.SelectProject(item.ID)
		})
		projectButton = ui.AccessibleName(projectButton, "Open project " + item.Name)
		projectView := ui.Key(projectButton, string(item.ID))
		if compact && item.ID == current.ID {
			projectViews = append([]ui.View{projectView}, projectViews...)
		} else {
			projectViews = append(projectViews, projectView)
		}
	}
	projectCreator := ui.Box()
	if projectCreatorVisible {
		name := design.ValidatedTextFieldWithFocus("Project name", newProjectName, "my-app", true, projectCreationBusy, newProjectError, newProjectFocusToken, ui.TextChange(state.SetNewProjectName))
		createLabel := "Create project"
		if projectCreationBusy {
			createLabel = "Creating…"
		}
		create := ui.Disabled(design.PrimaryButton(createLabel, state.CreateProject), projectCreationBusy ||
			projectMutationBusy || savePending > 0 || projectNameError(newProjectName) != "")
		projectCreator = ui.Padding(ui.Gap(ui.Column(name, create), design.Space2), design.Space2)
	}
	fileViews := make([]ui.View, 0, len(files))
	for _, file := range files {
		item := file
		if fileHiddenByCollapsedDirectory(item.Path, collapsed) {
			continue
		}
		glyph := fileGlyph(item.Kind)
		if item.Kind == domain.Directory && collapsed[item.Path] {
			glyph = "▸ "
		}
		label := glyph + item.Name
		if dirty[item.Path] {
			label += "  ●"
		}
		button := design.SidebarItem(label, item.Path == active, func() {
			if item.Kind == domain.Directory {
				state.ToggleDirectory(item.Path)
			} else {
				state.OpenFile(item.Path)
			}
		})
		button = ui.Selected(button, item.Path == active)
		button = ui.Role(button, "treeitem")
		if item.Kind == domain.Directory {
			button = ui.Expanded(button, !collapsed[item.Path])
			if collapsed[item.Path] {
				button = ui.AccessibleName(button, "Expand folder " + item.Path)
			} else {
				button = ui.AccessibleName(button, "Collapse folder " + item.Path)
			}
		} else {
			button = ui.AccessibleName(button, "Open " + item.Path)
		}
		if item.Depth > 0 {
			indent := ui.Width(ui.Box(), float64(item.Depth) * design.Space3)
			button = ui.Row(indent, ui.Flex(button, 1))
		}
		fileViews = append(fileViews, ui.Key(button, item.Path))
	}
	fileActionsBusy := projectMutationBusy || savePending > 0
	newFileButton := ui.AccessibleName(ui.Disabled(design.PrimaryButton("New", state.ShowNewFileDialog), fileActionsBusy), "New file")
	secondaryActions := ui.Gap(ui.Row(ui.Disabled(design.QuietButton("Rename", state.ShowRenameFileDialog), projectMutationBusy), ui.Disabled(design.QuietButton("Delete", state.DeleteActiveFile), projectMutationBusy)), design.Space2)
	fileActions := ui.Gap(ui.Column(newFileButton, secondaryActions), design.Space2)
	fileActions = ui.Padding(fileActions, design.Space3)
	if compact {
		fileActions = ui.Padding(ui.Gap(ui.Row(ui.Flex(newFileButton, 1), ui.Disabled(design.QuietButton("Rename", state.ShowRenameFileDialog), projectMutationBusy), ui.Disabled(design.QuietButton("Delete", state.DeleteActiveFile), projectMutationBusy)), design.Space2), design.Space2)
	}
	projectActionsBusy := projectMutationBusy || savePending > 0
	newProjectButton := ui.AccessibleName(ui.Disabled(design.QuietButton("New", state.ToggleProjectCreator), projectActionsBusy), "New project")
	projectActions := ui.Row(newProjectButton)
	if canOpenLocal {
		projectActions = ui.Row(ui.Disabled(design.QuietButton("Open", state.OpenLocalProject), projectActionsBusy), newProjectButton)
	}
	refresh := ui.AccessibleName(design.QuietButton("Refresh", state.RefreshProject), "Refresh project")
	projectList := ui.Column(projectViews...)
	if compact {
		projectList = ui.Height(ui.Scroll(projectList), 40)
	}
	fileTree := ui.AccessibleName(ui.Role(ui.Column(fileViews...), "tree"), "Project files")
	content := ui.Column(design.PanelHeader("PROJECTS", projectActions), projectCreator, projectList, design.PanelHeader(strings.ToUpper(current.Name), refresh), ui.Flex(ui.Scroll(fileTree), 1), fileActions)
	content = ui.Gap(content, design.Space1)
	return design.Panel(content)
}

func (state *State) SearchPanel() ui.View {
	state.mu.RLock()
	query := state.searchQuery
	results := append([]workspaceSearchResult(nil), state.searchResults...)
	searching := state.searching
	state.mu.RUnlock()
	input := ui.TextInput(query, "Search files and source", ui.TextChange(state.Search))
	input = ui.AccessibleName(input, "Search workspace")
	status := design.Badge(strconv.Itoa(len(results)), design.TextSecondary)
	if searching {
		status = design.Badge("searching", design.Accent)
	}
	views := make([]ui.View, 0, len(results))
	for _, result := range results {
		current := result
		label := current.Path
		if current.Line > 0 {
			label += ":" + strconv.Itoa(current.Line) + "  " + current.Preview
		} else if current.Preview != "" {
			label += "  " + current.Preview
		}
		item := design.SidebarItem(label, false, func() {
			state.OpenSearchResult(current)
		})
		item = ui.AccessibleDescription(item, current.Path + ":" + strconv.Itoa(current.Line) + ":" + strconv.Itoa(current.Column))
		views = append(views, item)
	}
	resultsView := ui.Column(views...)
	if query != "" && len(results) == 0 {
		message := "No matches"
		if searching {
			message = "Searching workspace…"
		}
		resultsView = ui.Column(ui.Padding(design.Muted(message), design.Space2))
	} else if query == "" {
		resultsView = ui.Column(ui.Padding(design.Muted("Search file names and source text."), design.Space2))
	}
	panel := design.Panel(ui.Column(design.PanelHeader("SEARCH", status), ui.Padding(input, design.Space2), ui.Flex(ui.Scroll(resultsView), 1)))
	return ui.TestID(panel, "studio-search-panel")
}

func (state *State) SourceControlPanel() ui.View {
	state.mu.RLock()
	canSync := state.host.CanSyncRemote
	remote := state.remote
	loaded := state.remoteLoaded
	loading := state.remoteLoading
	busy := state.remoteBusy
	selectedDiffPath := state.remoteDiff.Path
	message := state.commitMessage
	account := state.account
	pendingSaves := state.savePending
	dirtyEditors := 0
	for _, dirty := range state.dirty {
		if dirty {
			dirtyEditors++
		}
	}
	state.mu.RUnlock()
	editorChangesPending := dirtyEditors > 0 || pendingSaves > 0
	accountLabel := "Account"
	if account.Connected {
		accountLabel = "@" + account.Login
	}
	accountAction := ui.AccessibleName(design.QuietButton(accountLabel, state.ShowAccount), "GitHub account")
	if !canSync {
		description := "This browser workspace has no Git repository provider. GitHub sign-in supplies account identity only; pull, push, history, and repository diffs remain unavailable on this host."
		if dirtyEditors > 0 {
			description = strconv.Itoa(dirtyEditors) + " editor files have unsaved local changes. Save them before leaving this browser workspace. " + description
		}
		return design.Panel(ui.Column(design.PanelHeader("SOURCE CONTROL", accountAction), design.EmptyState("Git is unavailable in this browser host", description, design.QuietButton("Open account", state.ShowAccount))))
	}
	refreshLabel := "Refresh"
	if loading {
		refreshLabel = "Refreshing…"
	}
	refresh := ui.Disabled(design.QuietButton(refreshLabel, state.RefreshRemote), loading || busy)
	header := design.PanelHeader("SOURCE CONTROL", ui.Gap(ui.Row(accountAction, refresh), design.Space2))
	if !loaded {
		return design.Panel(ui.Column(header, design.EmptyState("Repository status", "Connect or initialize Git in this project to synchronize changes.", design.QuietButton("Refresh", state.RefreshRemote))))
	}
	if remote.Repository == "" && remote.Branch == "" {
		return design.Panel(ui.Column(header, design.EmptyState("No Git repository", "Initialize Git and configure a remote in this project to enable synchronization and diffs.", design.QuietButton("Refresh", state.RefreshRemote))))
	}
	summary := remote.Branch + " · " + remote.Provider
	if remote.Dirty {
		summary += " · changes"
	}
	if remote.Ahead > 0 || remote.Behind > 0 {
		summary += " · ↑" + strconv.Itoa(remote.Ahead) + " ↓" + strconv.Itoa(remote.Behind)
	}
	if remote.Diverged {
		summary += " · diverged"
	}
	input := ui.TextInput(message, "Commit message", ui.TextChange(state.SetCommitMessage))
	input = ui.AccessibleName(input, "Git commit message")
	changeViews := make([]ui.View, 0, len(remote.Changes))
	for _, change := range remote.Changes {
		item := change
		label := strings.ToUpper(item.Status) + "  " + item.Path
		if item.Staged {
			label += "  · staged"
		}
		button := design.SidebarItem(label, selectedDiffPath == item.Path, func() {
			state.OpenRemoteDiff(item.Path)
		})
		button = ui.AccessibleName(button, "Open changes for " + item.Path)
		changeViews = append(changeViews, ui.Key(button, "remote-change-" + item.Path))
	}
	changes := ui.Column(changeViews...)
	if len(changeViews) == 0 {
		changes = ui.Column(design.Muted("Working tree clean"))
	}
	warning := ui.Box()
	if remote.Conflicts > 0 {
		warning = kitcomponents.Alert(design.StudioTheme(), "Resolve conflicts", strconv.Itoa(remote.Conflicts) +
			" files require resolution before pull or push.", kitcomponents.IntentDanger, false)
	} else if remote.Diverged {
		warning = kitcomponents.Alert(design.StudioTheme(), "Branches diverged", "Inspect local changes, then pull or reconcile before pushing.", kitcomponents.IntentWarning, false)
	} else if editorChangesPending {
		detail := strconv.Itoa(dirtyEditors) + " editor files have unsaved changes. Save all before pulling or pushing."
		if pendingSaves > 0 {
			detail = "Studio is finishing " + strconv.Itoa(pendingSaves) + " file saves. Source control will unlock when they complete."
		}
		warning = kitcomponents.Alert(design.StudioTheme(), "Editor changes pending", detail, kitcomponents.IntentWarning, false)
	}
	actions := ui.Row(ui.Disabled(design.QuietButton("Pull", state.PullRemote), busy ||
		remote.Conflicts > 0 || editorChangesPending), ui.Disabled(design.PrimaryButton("Commit & Push", state.PushRemote), busy ||
		remote.Conflicts > 0 ||
		editorChangesPending ||
		strings.TrimSpace(message) == ""))
	if busy {
		actions = ui.Row(design.QuietButton("Cancel operation", state.CancelRemote))
	}
	repositoryActions := ui.Box()
	if remote.DeleteTarget != "" {
		repositoryActions = ui.AccessibleName(design.QuietButton("Repository settings", state.ShowRemoteDelete), "Open destructive repository settings for " +
			remote.DeleteTarget)
	}
	content := ui.Column(header, ui.Padding(ui.Column(ui.Text(summary), design.Muted(remote.Repository), repositoryActions), design.Space3), ui.Padding(warning, design.Space3), design.PanelHeader("CHANGES", design.Badge(strconv.Itoa(len(remote.Changes)), design.TextSecondary)), ui.Flex(ui.Scroll(ui.Padding(changes, design.Space2)), 1), ui.Padding(input, design.Space3), ui.Padding(actions, design.Space3))
	return design.Panel(content)
}

func (state *State) DocsNavigation() ui.View {
	state.mu.RLock()
	query := state.docQuery
	selected := state.docPageID
	expanded := make(map[string]bool)
	for id, value := range state.docExpanded {
		expanded[id] = value
	}
	state.mu.RUnlock()
	input := ui.TextInput(query, "Search documentation", ui.TextChange(state.SetDocQuery))
	input = ui.AccessibleName(input, "Search documentation")
	pages := documentationPages()
	items := make([]kitdata.TreeItem, 0, len(pages) + len(documentation.Sections()))
	matchingPages := 0
	searching := strings.TrimSpace(query) != ""
	for _, section := range documentation.Sections() {
		sectionPages := make([]domain.DocPage, 0)
		for _, page := range pages {
			if page.SectionID == section.ID && documentationMatches(page, query) {
				sectionPages = append(sectionPages, page)
			}
		}
		if len(sectionPages) == 0 {
			continue
		}
		matchingPages += len(sectionPages)
		sectionExpanded := searching || expanded[section.ID]
		items = append(items, kitdata.TreeItem{
			Key: "section/" + section.ID,
			Label: section.Title + " (" + strconv.Itoa(len(sectionPages)) + ")", Depth: 0, HasChildren: true,
			Expanded: sectionExpanded,
		})
		if sectionExpanded {
			for _, page := range sectionPages {
				items = append(items, kitdata.TreeItem{
					Key: "page/" + page.ID, Label: page.Title, Depth: 1, Selected: page.ID == selected,
				})
			}
		}
	}
	badge := strconv.Itoa(documentation.PageCount()) + " pages"
	tree := kitdata.Tree(design.StudioTheme(), "Volang documentation", items, state.ToggleDocSection, state.SelectDocTreeItem)
	content := ui.Column(design.PanelHeader("VOLANG DOCUMENTATION", design.Badge(badge, design.Accent)), ui.Padding(input, design.Space2), ui.Flex(ui.Scroll(tree), 1))
	if matchingPages == 0 {
		content = ui.Column(design.PanelHeader("VOLANG DOCUMENTATION", design.Badge(badge, design.Accent)), ui.Padding(input, design.Space2), design.EmptyState("No documentation found", "Try language, errors, goroutines, modules, CLI, AOT, components, or testing.", ui.Box()))
	}
	return design.Panel(content)
}

func (state *State) SidePanel() ui.View {
	state.mu.RLock()
	activity := state.activity
	state.mu.RUnlock()
	panel := state.Explorer()
	if activity == ActivitySearch {
		panel = state.SearchPanel()
	} else if activity == ActivitySourceControl {
		panel = state.SourceControlPanel()
	} else if activity == ActivityDocs {
		panel = state.DocsNavigation()
	}
	return ui.TestID(panel, "studio-side-panel")
}

func shortPath(path string) string {
	index := strings.LastIndex(path, "/")
	if index >= 0 && index + 1 < len(path) {
		return path[index + 1:]
	}
	return path
}

func (state *State) DocumentTabs() ui.View {
	state.mu.RLock()
	paths := append([]string(nil), state.openPaths...)
	active := state.activePath
	dirty := make(map[string]bool)
	for path, value := range state.dirty {
		dirty[path] = value
	}
	state.mu.RUnlock()
	tabs := make([]ui.View, 0, len(paths))
	for _, path := range paths {
		current := path
		label := shortPath(current)
		if dirty[current] {
			label += "  ●"
		}
		tab := design.DocumentTab(label, current, current == active, func() {
			state.OpenFile(current)
		}, func() {
			state.CloseFile(current)
		})
		tabs = append(tabs, ui.Key(tab, "document-tab-" + current))
	}
	bar := ui.Row(tabs...)
	bar = ui.Role(bar, "tablist")
	bar = ui.AccessibleName(bar, "Open editors")
	bar = ui.Background(bar, design.Canvas)
	return ui.Scroll(bar)
}

func (state *State) EditorPanel() ui.View {
	state.mu.RLock()
	code := state.editor
	path := state.activePath
	focusToken := state.editorFocusToken
	state.mu.RUnlock()
	if code == nil {
		return design.EmptyState("Open a project", "Choose a project and source file to begin.", design.PrimaryButton("Create project", state.CreateProject))
	}
	options := editor.DefaultOptions()
	options.Width = 0
	options.Height = 0
	options.AccessibleName = "Editor for " + path
	options.FocusToken = focusToken
	options.OnChange = state.DocumentChanged
	return ui.TestID(design.Panel(ui.Column(state.DocumentTabs(), ui.Flex(editor.View(code, options), 1))), "studio-editor-panel")
}

func (state *State) FindBar() ui.View {
	state.mu.RLock()
	findVisible := state.findVisible
	findQuery := state.findQuery
	state.mu.RUnlock()
	input := ui.TextInput(findQuery, "Find in active file", ui.TextChange(state.SetFindQuery))
	input = ui.AccessibleName(input, "Find in active file")
	actions := ui.Row(design.QuietButton("Previous", state.FindPrevious), design.QuietButton("Next", state.FindNext), design.QuietButton("Close", state.HideFind))
	findContent := ui.Row(ui.Flex(input, 1), actions)
	if ui.CurrentEnvironment().ViewportWidth < 600 {
		findContent = ui.Gap(ui.Column(input, ui.Justify(actions, ui.JustifyEnd)), design.Space2)
	}
	findBar := ui.Padding(findContent, design.Space2)
	findBar = ui.Background(findBar, design.SurfaceRaised)
	findBar = ui.Hidden(findBar, !findVisible)
	return findBar
}

func (state *State) ConsolePanel() ui.View {
	state.mu.RLock()
	entries := append([]domain.ConsoleEntry(nil), state.console...)
	running := state.running
	state.mu.RUnlock()
	lines := make([]ui.View, 0, len(entries))
	for _, entry := range entries {
		color := design.TextSecondary
		if entry.Level == domain.ConsoleError {
			color = design.Danger
		} else if entry.Level == domain.ConsoleSuccess {
			color = design.Success
		} else if entry.Level == domain.ConsoleWarning {
			color = design.Warning
		}
		line := ui.Foreground(ui.Text("[" + entry.Source + "] " + entry.Text), color)
		line = ui.Key(line, "log-" + strconv.FormatUint(entry.Sequence, 10))
		lines = append(lines, line)
	}
	action := design.QuietButton("Clear", func() {
		state.mu.Lock()
		state.console = nil
		state.mu.Unlock()
		ui.Invalidate()
	})
	if running {
		action = design.QuietButton("Stop", state.StopRun)
	}
	log := ui.Role(ui.Scroll(ui.Column(lines...)), "log")
	log = ui.AccessibleName(log, "Studio console")
	return ui.TestID(design.Panel(ui.Column(design.PanelHeader("CONSOLE", action), ui.Padding(ui.Flex(log, 1), design.Space2))), "studio-console-panel")
}

func (state *State) ProblemsPanel() ui.View {
	state.mu.RLock()
	paths := append([]string(nil), state.openPaths...)
	byPath := make(map[string][]domain.Diagnostic)
	for path, values := range state.diagnosticsByPath {
		byPath[path] = append([]domain.Diagnostic(nil), values...)
	}
	state.mu.RUnlock()
	values := make([]domain.Diagnostic, 0)
	for _, path := range paths {
		for _, value := range byPath[path] {
			item := value
			if item.Path == "" {
				item.Path = path
			}
			values = append(values, item)
		}
	}
	views := make([]ui.View, 0, len(values))
	for index, value := range values {
		current := value
		color := design.TextSecondary
		if value.Severity == domain.DiagnosticError {
			color = design.Danger
		} else if value.Severity == domain.DiagnosticWarning {
			color = design.Warning
		}
		message := ui.Button(value.Message, ui.Action(func() {
			state.OpenDiagnostic(current)
		}))
		message = ui.AccessibleDescription(message, value.Path + ":" + strconv.Itoa(value.Line) + ":" +
			strconv.Itoa(value.Column))
		message = ui.MinHeight(ui.Padding(ui.WhiteSpace(ui.FontSize(ui.Foreground(message, color), 12), "normal"), design.Space2), 36)
		message = ui.Background(message, design.Surface)
		message = ui.HoverBackground(message, design.SurfaceHover)
		message = ui.PressedBackground(message, design.SurfacePressed)
		message = ui.FocusRing(message, design.Accent)
		message = ui.BorderWidth(message, 0)
		message = ui.Radius(message, 7)
		location := ui.FontSize(design.Muted(value.Path + ":" + strconv.Itoa(value.Line) + ":" +
			strconv.Itoa(value.Column) +
			" · " +
			value.Code), 10)
		item := ui.Gap(ui.Column(message, location), design.Space1)
		views = append(views, ui.Key(ui.Padding(item, design.Space2), "problem-" + strconv.Itoa(index)))
	}
	if len(values) == 0 {
		views = append(views, design.EmptyState("No problems", "The latest analysis completed cleanly.", ui.Box()))
	}
	content := ui.Flex(ui.Scroll(ui.Column(views...)), 1)
	return ui.TestID(design.Panel(ui.Column(design.PanelHeader("PROBLEMS", design.Badge(strconv.Itoa(len(values)), design.TextSecondary)), content)), "studio-problems-panel")
}

func (state *State) RemoteDiffPanel() ui.View {
	state.mu.RLock()
	diff := state.remoteDiff
	loading := state.remoteDiffLoading
	state.mu.RUnlock()
	if loading {
		return design.EmptyState("Loading changes", "Studio is reading the repository diff for " +
			diff.Path +
			".", design.Badge("working", design.Accent))
	}
	if diff.Path == "" {
		return design.EmptyState("No change selected", "Choose a changed file in Source Control to inspect its unified diff.", ui.Box())
	}
	lines := strings.Split(diff.Unified, "\n")
	views := make([]ui.View, 0, len(lines))
	for index, line := range lines {
		color := design.TextSecondary
		if strings.HasPrefix(line, "+") && !strings.HasPrefix(line, "+++") {
			color = design.Success
		} else if strings.HasPrefix(line, "-") && !strings.HasPrefix(line, "---") {
			color = design.Danger
		} else if strings.HasPrefix(line, "@@") {
			color = design.Accent
		}
		view := ui.FontSize(ui.Foreground(ui.Text(line), color), 12)
		views = append(views, ui.Key(view, "diff-line-" + strconv.Itoa(index)))
	}
	badge := design.Badge("working tree", design.Accent)
	if diff.Truncated {
		badge = design.Badge("truncated", design.Warning)
	}
	header := design.PanelHeader(strings.ToUpper(diff.Path), badge)
	log := ui.AccessibleName(ui.Role(ui.Scroll(ui.Gap(ui.Column(views...), design.Space1)), "log"), "Changes for " +
		diff.Path)
	return design.Panel(ui.Column(header, ui.Padding(ui.Flex(log, 1), design.Space3)))
}

func (state *State) PreviewPanel() ui.View {
	state.mu.RLock()
	status := state.previewState
	surface := state.previewSurface
	stale := state.previewStale
	previewError := state.previewError
	mode := preferredRuntimeMode(state.host)
	state.mu.RUnlock()
	if status == domain.PreviewBuilding {
		return design.EmptyState("Building preview", "The active UI entry is compiling.", design.Badge("working", design.Accent))
	}
	if status == domain.PreviewFailed {
		return design.EmptyState("Preview failed", "See Problems and Console for details.", design.PrimaryButton("Try again", func() {
			state.StartRun(mode, true)
		}))
	}
	if status != domain.PreviewReady || surface == "" {
		return design.EmptyState("No preview yet", "Run the current UI entry in an isolated child session.", design.PrimaryButton("Open preview", func() {
			state.StartRun(mode, true)
		}))
	}
	if strings.HasPrefix(surface, "native-window://") {
		description := "The native preview runs in an isolated desktop window and closes when it is replaced or the project changes."
		if stale {
			description = "The open preview is out of date. Reload it to run the current editor snapshot."
		}
		return design.EmptyState("Preview window is open", description, design.PrimaryButton("Reload preview", func() {
			state.StartRun(mode, true)
		}))
	}
	view := ui.PlatformView("volang-studio-preview/v1", surface, "Embedded Volang application preview")
	view = ui.MinWidth(view, 0)
	view = ui.MinHeight(view, 0)
	view = ui.Flex(view, 1)
	view = ui.Background(view, design.Canvas)
	action := design.QuietButton("Reload", func() {
		state.StartRun(mode, true)
	})
	if stale {
		action = ui.Gap(ui.Row(design.Badge("outdated", design.Warning), action), design.Space2)
	}
	feedback := ui.Box()
	if previewError != "" {
		feedback = kitcomponents.Alert(design.StudioTheme(), "Preview update failed", previewError, kitcomponents.IntentWarning, false)
	} else if stale {
		feedback = kitcomponents.Alert(design.StudioTheme(), "Preview is out of date", "Reload to run the current editor snapshot.", kitcomponents.IntentWarning, false)
	}
	return design.Panel(ui.Column(design.PanelHeader("PREVIEW", action), feedback, view))
}

func (state *State) ReturnToStudio() {
	state.mu.Lock()
	state.activity = ActivityExplorer
	state.status = "Workspace ready"
	state.mu.Unlock()
	ui.Navigate("/workspace")
	ui.Invalidate()
}

// RunnerView is the chromeless project surface used by portable Runner links.
// It owns compile progress, recovery, stop/reload, and the route back into the
// full workspace while reusing the same compiler and preview services.
func (state *State) RunnerView() ui.View {
	state.mu.RLock()
	project := state.current
	hasProject := state.hasProject
	running := state.running
	status := state.status
	mode := preferredRuntimeMode(state.host)
	state.mu.RUnlock()
	name := "Shared Volang application"
	if hasProject {
		name = project.Name
	}
	statusColor := studioStatusColor(status, running)
	action := design.PrimaryButton("Reload", func() {
		state.StartRun(mode, true)
	})
	if running {
		action = design.QuietButton("Stop", state.StopRun)
	}
	returnButton := ui.AccessibleName(design.QuietButton("Edit in Studio", state.ReturnToStudio), "Return to Studio workspace")
	header := ui.Align(ui.Gap(ui.Row(design.BrandLockup(), ui.Width(ui.Height(ui.Background(ui.Box(), design.DividerStrong), 24), 1), ui.Column(ui.FontWeight(ui.Text(name), 700), design.Muted("Portable Runner")), ui.Flex(ui.Box(), 1), design.StatusPill(status, statusColor), returnButton, action), design.Space3), ui.AlignCenter)
	if ui.CurrentEnvironment().ViewportWidth < 600 {
		identity := ui.Align(ui.Row(design.BrandMark(), ui.Gap(ui.Column(ui.FontWeight(ui.Text(name), 700), design.Muted("Portable Runner")), design.Space1), ui.Flex(ui.Box(), 1), returnButton), ui.AlignCenter)
		controls := ui.Align(ui.Row(design.StatusPill(status, statusColor), ui.Flex(ui.Box(), 1), action), ui.AlignCenter)
		header = ui.Gap(ui.Column(identity, controls), design.Space2)
	}
	header = design.TopBar(header)
	preview := ui.Flex(state.PreviewPanel(), 1)
	if !hasProject {
		preview = ui.Flex(design.EmptyState("Loading project", "Studio is restoring the shared source snapshot.", design.Badge("loading", design.Accent)), 1)
	}
	content := design.AppSurface(ui.Column(header, preview))
	content = ui.MinWidth(content, 0)
	content = ui.MinHeight(content, 320)
	viewportHeight := ui.CurrentEnvironment().ViewportHeight
	if viewportHeight > 0 {
		content = ui.Height(content, viewportHeight)
	}
	return content
}

type documentationHeading struct {
	ID string
	Title string
	Level int
	BlockIndex int
}

func documentationHeadingSlug(title string, fallback int) string {
	slug := ""
	separator := false
	for _, character := range strings.ToLower(title) {
		letter := character >= 'a' && character <= 'z'
		digit := character >= '0' && character <= '9'
		if letter || digit {
			if separator && slug != "" {
				slug += "-"
			}
			slug += string(character)
			separator = false
		} else {
			separator = true
		}
	}
	if slug == "" {
		return "section-" + strconv.Itoa(fallback)
	}
	return slug
}

func documentationHeadings(blocks []document.Block) []documentationHeading {
	headings := make([]documentationHeading, 0)
	seen := make(map[string]int)
	for index, block := range blocks {
		if block.Kind == document.Heading && (block.Level == 2 || block.Level == 3) {
			id := documentationHeadingSlug(block.Text, index)
			seen[id]++
			if seen[id] > 1 {
				id += "-" + strconv.Itoa(seen[id])
			}
			headings = append(headings, documentationHeading{
				ID: id, Title: block.Text, Level: block.Level, BlockIndex: index,
			})
		}
	}
	return headings
}

func documentationHeadingForBlock(headings []documentationHeading, blockIndex int) string {
	for _, heading := range headings {
		if heading.BlockIndex == blockIndex {
			return heading.ID
		}
	}
	return ""
}

func renderDocumentation(blocks []document.Block, headings []documentationHeading, selectedHeading string, focusToken int64) ui.View {
	views := make([]ui.View, 0, len(blocks))
	for index, block := range blocks {
		var view ui.View
		if block.Kind == document.Heading {
			size := 18.0
			weight := int64(700)
			if block.Level == 1 {
				size = 30
				weight = 780
			} else if block.Level == 2 {
				size = 20
				weight = 730
			}
			view = ui.FontSize(ui.FontWeight(ui.Text(block.Text), weight), size)
			view = ui.AccessibleName(ui.Role(view, "heading"), block.Text)
			if block.Level == 2 || block.Level == 3 {
				headingID := documentationHeadingForBlock(headings, index)
				view = ui.TestID(ui.Focusable(view, true), headingID)
				if selectedHeading == headingID {
					view = ui.FocusRequest(view, focusToken)
				}
			}
		} else if block.Kind == document.CodeBlock {
			code := ui.Foreground(ui.Text(block.Text), 0xffc3e88d)
			if block.Info != "" && block.Info != "table" {
				code = ui.Gap(ui.Column(design.Muted(block.Info), code), design.Space1)
			}
			view = ui.Padding(ui.Background(code, design.SurfaceSunken), design.Space3)
			view = ui.BorderColor(ui.BorderWidth(view, 1), design.Divider)
		} else if block.Kind == document.ListItem {
			marker := ui.Width(ui.Foreground(ui.Text(block.Info), design.Accent), 18)
			if block.Info == "" {
				marker = ui.Width(ui.Height(ui.Radius(ui.Background(ui.Box(), design.Accent), 3), 6), 18)
			}
			view = ui.Align(ui.Gap(ui.Row(marker, ui.Foreground(ui.Text(block.Text), design.TextSecondary)), design.Space2), ui.AlignCenter)
		} else if block.Kind == document.Quote {
			view = kitcomponents.Alert(design.StudioTheme(), "Note", block.Text, kitcomponents.IntentInfo, false)
		} else if block.Kind == document.Rule {
			view = ui.Height(ui.Background(ui.Box(), design.Divider), 1)
		} else if block.Text == "" {
			view = ui.Height(ui.Box(), design.Space1)
		} else {
			view = ui.Foreground(ui.Text(block.Text), design.TextSecondary)
		}
		views = append(views, ui.Key(view, "doc-block-" + strconv.Itoa(index)))
	}
	return ui.Gap(ui.Column(views...), design.Space3)
}

func (state *State) documentationOutline(pageID string, headings []documentationHeading, selected string) ui.View {
	items := make([]kitdata.TreeItem, 0, len(headings))
	for _, heading := range headings {
		items = append(items, kitdata.TreeItem{
			Key: heading.ID, Label: heading.Title, Depth: int64(heading.Level - 2),
			Selected: heading.ID == selected,
		})
	}
	tree := kitdata.Tree(design.StudioTheme(), "On this page", items, func(key string) {}, func(key string) {
		state.OpenDocHeading(pageID, key)
	})
	header := design.PanelHeader("ON THIS PAGE", design.Badge(strconv.Itoa(len(headings)), design.TextSecondary))
	outline := ui.Gap(ui.Column(header, tree), design.Space2)
	outline = ui.BorderColor(ui.BorderWidth(ui.Radius(ui.Background(outline, design.SurfaceRaised), 8), 1), design.Divider)
	return ui.Padding(outline, design.Space2)
}

func (state *State) DocsPanel() ui.View {
	state.mu.RLock()
	selected := state.docPageID
	selectedHeading := state.docHeadingID
	focusToken := state.docFocusToken
	state.mu.RUnlock()
	pages := documentationPages()
	if len(pages) == 0 {
		return design.Panel(design.EmptyState("Documentation unavailable", "The maintained documentation catalog contains no pages.", ui.Box()))
	}
	page := pages[0]
	pageIndex := 0
	for index, candidate := range pages {
		if candidate.ID == selected {
			page = candidate
			pageIndex = index
			break
		}
	}
	blocks, err := document.ParseMarkdown(page.Markdown, 4096)
	if err != nil {
		return design.Panel(kitcomponents.Alert(design.StudioTheme(), "Documentation unavailable", err.Error(), kitcomponents.IntentDanger, false))
	}
	headings := documentationHeadings(blocks)
	breadcrumb := ui.Gap(ui.Row(design.Muted("Documentation"), design.Muted("/"), design.Muted(page.Section), design.Muted("/"), ui.Text(page.Title)), design.Space2)
	header := ui.Align(ui.Row(ui.Flex(breadcrumb, 1), design.Badge("Volang " + documentation.Version(), design.Success)), ui.AlignCenter)
	provenance := ui.Gap(ui.Column(ui.Foreground(ui.Text(page.Summary), design.TextSecondary), design.Muted("Canonical source · " +
		page.SourcePath)), design.Space1)
	previous := ui.Box()
	if pageIndex > 0 {
		item := pages[pageIndex - 1]
		previous = design.QuietButton("← Previous · " + item.Title, func() {
			state.OpenDoc(item.ID)
		})
	}
	next := ui.Box()
	if pageIndex + 1 < len(pages) {
		item := pages[pageIndex + 1]
		next = design.QuietButton("Next · " + item.Title + " →", func() {
			state.OpenDoc(item.ID)
		})
	}
	pageNavigation := ui.Align(ui.Row(previous, ui.Flex(ui.Box(), 1), next), ui.AlignCenter)
	articleParts := []ui.View{header, provenance}
	outline := ui.Box()
	if len(headings) > 0 {
		outline = state.documentationOutline(page.ID, headings, selectedHeading)
		if ui.CurrentEnvironment().ViewportWidth < 1180 {
			articleParts = append(articleParts, outline)
		}
	}
	articleParts = append(articleParts, renderDocumentation(blocks, headings, selectedHeading, focusToken), ui.Height(ui.Background(ui.Box(), design.Divider), 1), pageNavigation)
	article := ui.Gap(ui.Column(articleParts...), design.Space5)
	article = ui.MaxWidth(article, 840)
	article = ui.Padding(article, design.Space6)
	content := ui.Flex(article, 1)
	if len(headings) > 0 && ui.CurrentEnvironment().ViewportWidth >= 1180 {
		content = ui.Row(ui.Flex(article, 1), ui.Width(ui.Padding(outline, design.Space4), 250))
	}
	content = ui.MaxWidth(content, 1140)
	return design.Panel(ui.Scroll(ui.Justify(ui.Row(content), ui.JustifyCenter)))
}

// executeCommand is the one semantic command dispatcher shared by keyboard
// shortcuts and projections such as the command palette. Keeping the dispatch
// on State also avoids retaining one command callback from inside another UI
// callback across an AOT invalidation boundary.
func (state *State) executeCommand(id string, preferredMode domain.RuntimeMode) {
	switch id {
		case "command.palette", "command.palette.control":
			state.ShowCommandPalette()
		case "project.new":
			state.ToggleProjectCreator()
		case "project.open":
			state.OpenLocalProject()
		case "project.share":
			state.ShowShareProject()
		case "file.new":
			state.ShowNewFileDialog()
		case "file.rename":
			state.ShowRenameFileDialog()
		case "file.save", "file.save.control":
			state.Save()
		case "file.save-all", "file.save-all.control":
			state.SaveAll()
		case "file.close", "file.close.control":
			state.CloseActiveFile()
		case "edit.undo", "edit.undo.control":
			state.Undo()
		case "edit.redo", "edit.redo.control":
			state.Redo()
		case "search.file", "search.file.control":
			state.ShowFind()
		case "search.next", "search.next.control":
			state.FindNext()
		case "search.workspace", "search.workspace.control":
			state.SetActivity(ActivitySearch)
		case "view.explorer":
			state.SetActivity(ActivityExplorer)
		case "view.home":
			state.ShowHome()
		case "view.source-control":
			state.SetActivity(ActivitySourceControl)
		case "view.docs":
			state.ShowDocs()
		case "run.preferred", "run.preferred.control":
			state.StartRun(preferredMode, false)
		case "run.vm":
			state.StartRun(domain.RuntimeVM, false)
		case "run.jit":
			state.StartRun(domain.RuntimeJIT, false)
		case "view.preview", "view.preview.control":
			state.ShowPreview()
			state.StartRun(preferredMode, true)
	}
}

func (state *State) commandScope(preferredMode domain.RuntimeMode) commands.Scope {
	vm := commands.Action("run.vm", "Run with VM", func() {
		state.executeCommand("run.vm", preferredMode)
	})
	state.mu.RLock()
	vm.Enabled = supportsRuntimeMode(state.host, domain.RuntimeVM)
	state.mu.RUnlock()
	jit := commands.Action("run.jit", "Run with JIT", func() {
		state.executeCommand("run.jit", preferredMode)
	})
	state.mu.RLock()
	jit.Enabled = supportsRuntimeMode(state.host, domain.RuntimeJIT)
	canOpenLocal := state.host.CanOpenLocal
	state.mu.RUnlock()
	openProject := commands.Action("project.open", "Open local project", func() {
		state.executeCommand("project.open", preferredMode)
	})
	openProject.Enabled = canOpenLocal
	return commands.NewScope(commands.New("command.palette", "Open command palette", commands.Key("p", ui.ModifierMeta |
		ui.ModifierShift), func() {
		state.executeCommand("command.palette", preferredMode)
	}), commands.New("command.palette.control", "Open command palette", commands.Key("p", ui.ModifierControl |
		ui.ModifierShift), func() {
		state.executeCommand("command.palette.control", preferredMode)
	}), commands.Action("project.new", "Create project", func() {
		state.executeCommand("project.new", preferredMode)
	}), openProject, commands.Action("project.share", "Share current project", func() {
		state.executeCommand("project.share", preferredMode)
	}), commands.Action("file.new", "New file", func() {
		state.executeCommand("file.new", preferredMode)
	}), commands.Action("file.rename", "Rename active file", func() {
		state.executeCommand("file.rename", preferredMode)
	}), commands.New("file.save", "Save", commands.Key("s", ui.ModifierMeta), func() {
		state.executeCommand("file.save", preferredMode)
	}), commands.New("file.save.control", "Save", commands.Key("s", ui.ModifierControl), func() {
		state.executeCommand("file.save.control", preferredMode)
	}), commands.New("file.save-all", "Save all", commands.Key("s", ui.ModifierMeta | ui.ModifierShift), func() {
		state.executeCommand("file.save-all", preferredMode)
	}), commands.New("file.save-all.control", "Save all", commands.Key("s", ui.ModifierControl |
		ui.ModifierShift), func() {
		state.executeCommand("file.save-all.control", preferredMode)
	}), commands.New("file.close", "Close editor", commands.Key("w", ui.ModifierMeta), func() {
		state.executeCommand("file.close", preferredMode)
	}), commands.New("file.close.control", "Close editor", commands.Key("w", ui.ModifierControl), func() {
		state.executeCommand("file.close.control", preferredMode)
	}), commands.New("edit.undo", "Undo", commands.Key("z", ui.ModifierMeta), func() {
		state.executeCommand("edit.undo", preferredMode)
	}), commands.New("edit.undo.control", "Undo", commands.Key("z", ui.ModifierControl), func() {
		state.executeCommand("edit.undo.control", preferredMode)
	}), commands.New("edit.redo", "Redo", commands.Key("z", ui.ModifierMeta | ui.ModifierShift), func() {
		state.executeCommand("edit.redo", preferredMode)
	}), commands.New("edit.redo.control", "Redo", commands.Key("y", ui.ModifierControl), func() {
		state.executeCommand("edit.redo.control", preferredMode)
	}), commands.New("search.file", "Find in file", commands.Key("f", ui.ModifierMeta), func() {
		state.executeCommand("search.file", preferredMode)
	}), commands.New("search.file.control", "Find in file", commands.Key("f", ui.ModifierControl), func() {
		state.executeCommand("search.file.control", preferredMode)
	}), commands.New("search.next", "Find next", commands.Key("g", ui.ModifierMeta), func() {
		state.executeCommand("search.next", preferredMode)
	}), commands.New("search.next.control", "Find next", commands.Key("g", ui.ModifierControl), func() {
		state.executeCommand("search.next.control", preferredMode)
	}), commands.New("search.workspace", "Search workspace", commands.Key("f", ui.ModifierMeta |
		ui.ModifierShift), func() {
		state.executeCommand("search.workspace", preferredMode)
	}), commands.New("search.workspace.control", "Search workspace", commands.Key("f", ui.ModifierControl |
		ui.ModifierShift), func() {
		state.executeCommand("search.workspace.control", preferredMode)
	}), commands.Action("view.explorer", "Show Explorer", func() {
		state.executeCommand("view.explorer", preferredMode)
	}), commands.Action("view.home", "Show Home", func() {
		state.executeCommand("view.home", preferredMode)
	}), commands.Action("view.source-control", "Show Source Control", func() {
		state.executeCommand("view.source-control", preferredMode)
	}), commands.Action("view.docs", "Show Documentation", func() {
		state.executeCommand("view.docs", preferredMode)
	}), commands.New("run.preferred", "Run " + preferredMode.String(), commands.Key("Enter", ui.ModifierMeta), func() {
		state.executeCommand("run.preferred", preferredMode)
	}), commands.New("run.preferred.control", "Run " + preferredMode.String(), commands.Key("Enter", ui.ModifierControl), func() {
		state.executeCommand("run.preferred.control", preferredMode)
	}), vm, jit, commands.New("view.preview", "Open preview", commands.Key("Enter", ui.ModifierMeta |
		ui.ModifierShift), func() {
		state.executeCommand("view.preview", preferredMode)
	}), commands.New("view.preview.control", "Open preview", commands.Key("Enter", ui.ModifierControl |
		ui.ModifierShift), func() {
		state.executeCommand("view.preview.control", preferredMode)
	}))
}

func commandShortcutLabel(shortcut commands.Shortcut) string {
	parts := []string{}
	if shortcut.Modifiers & ui.ModifierControl != 0 || shortcut.Modifiers & ui.ModifierMeta != 0 {
		parts = append(parts, "Ctrl/⌘")
	}
	if shortcut.Modifiers & ui.ModifierAlt != 0 {
		parts = append(parts, "Alt")
	}
	if shortcut.Modifiers & ui.ModifierShift != 0 {
		parts = append(parts, "Shift")
	}
	key := shortcut.Key
	if key == "" {
		key = shortcut.Code
	}
	if key != "" {
		parts = append(parts, strings.ToUpper(key))
	}
	return strings.Join(parts, "+")
}

func (state *State) CommandPalette(scope commands.Scope, preferredMode domain.RuntimeMode) ui.View {
	state.mu.RLock()
	visible := state.paletteVisible
	query := state.paletteQuery
	selected := state.paletteSelected
	focusToken := state.paletteFocusToken
	state.mu.RUnlock()
	if !visible {
		return ui.Fragment()
	}
	derivedQuery := ui.DerivedString(query)
	commandsFound := scope.Search(derivedQuery, 24)
	items := make([]kitcomponents.CommandItem, 0, len(commandsFound))
	for _, item := range commandsFound {
		current := item
		if strings.HasSuffix(current.ID, ".control") {
			continue
		}
		items = append(items, kitcomponents.CommandItem{
			Key: current.ID, Label: current.Label, Detail: current.Description,
			Shortcut: commandShortcutLabel(current.Shortcut), Disabled: !current.Enabled,
		})
	}
	if len(items) == 0 {
		selected = -1
	} else if selected < 0 || selected >= int64(len(items)) {
		selected = 0
	}
	return kitcomponents.CommandPalette(design.StudioTheme(), "Command palette", query, "Type a command", true, selected, focusToken, items, state.SetPaletteQuery, state.SetPaletteSelection, func(commandID string) {
		state.mu.Lock()
		state.paletteVisible = false
		state.paletteQuery = ""
		state.paletteSelected = 0
		state.status = "Ready"
		state.mu.Unlock()
		state.executeCommand(commandID, preferredMode)
		ui.Invalidate()
	}, state.HideCommandPalette)
}

func (state *State) TopBar() ui.View {
	state.mu.RLock()
	project := state.current
	path := state.activePath
	running := state.running
	hasProject := state.hasProject
	mode := state.runMode
	status := state.status
	preferredMode := preferredRuntimeMode(state.host)
	activity := state.activity
	projectMutationBusy := state.projectMutationBusy
	savePending := state.savePending
	dirty := state.hasDirtyLocked()
	state.mu.RUnlock()
	viewportWidth := ui.CurrentEnvironment().ViewportWidth
	run := design.QuietButton("Loading workspace…", func() {})
	preview := design.QuietButton("Preview unavailable", func() {})
	if hasProject && activity != ActivityHome {
		run = ui.Disabled(ui.AccessibleName(design.PrimaryButton("Run " + preferredMode.String(), func() {
			state.StartRun(preferredMode, false)
		}), "Run " + preferredMode.String()), projectMutationBusy)
		preview = ui.Disabled(ui.AccessibleName(design.QuietButton("Preview", func() {
			state.ShowPreview()
			state.StartRun(preferredMode, true)
		}), "Open Preview"), projectMutationBusy)
	}
	if running && activity != ActivityHome {
		run = ui.AccessibleName(design.QuietButton("Stop " + mode.String(), state.StopRun), "Stop " +
			mode.String())
	}
	location := "Home"
	if activity == ActivityHome {
		location = "Start"
	} else if hasProject {
		location = project.Name
		if path != "" && viewportWidth >= 1080 {
			location += "  /  " + path
		}
	}
	locationView := ui.FontSize(ui.Foreground(ui.Text(location), design.TextSecondary), 12)
	separator := ui.Width(ui.Height(ui.Background(ui.Box(), design.DividerStrong), 24), 1)
	left := ui.Align(ui.Gap(ui.Row(design.BrandLockup(), separator, locationView), design.Space3), ui.AlignCenter)
	if viewportWidth < 840 {
		compactLeft := ui.Align(ui.Gap(ui.Row(design.BrandMark(), ui.Flex(locationView, 1)), design.Space2), ui.AlignCenter)
		compactSave := ui.Disabled(ui.AccessibleName(design.QuietButton("Save", state.Save), "Save File"),
			projectMutationBusy || !dirty)
		compactActions := ui.Gap(ui.Row(design.QuietButton("Commands", state.ShowCommandPalette), compactSave, run), design.Space1)
		if activity == ActivityHome {
			compactActions = ui.Row(design.PrimaryButton("New project", state.ToggleProjectCreator))
		}
		bar := ui.Align(ui.Row(ui.Flex(compactLeft, 1), compactActions), ui.AlignCenter)
		bar = ui.AccessibleDescription(bar, status)
		return ui.TestID(ui.Role(design.TopBar(bar), "toolbar"), "studio-topbar")
	}
	statusColor := studioStatusColor(status, running)
	statusView := design.StatusPill(status, statusColor)
	find := design.QuietButton("Find", state.ShowFind)
	save := ui.Disabled(ui.AccessibleName(design.QuietButton("Save", state.Save), "Save File"),
		projectMutationBusy || !dirty)
	share := ui.Disabled(ui.AccessibleName(design.QuietButton("Share", state.ShowShareProject), "Share current project"),
		projectMutationBusy || savePending > 0)
	actions := ui.Gap(ui.Row(design.QuietButton("Commands", state.ShowCommandPalette), find, save, share, run, preview), design.Space2)
	if activity == ActivityHome {
		statusView = design.StatusPill("Workspace ready", design.Success)
		actions = ui.Gap(ui.Row(design.QuietButton("Commands", state.ShowCommandPalette), design.QuietButton("Open workspace", func() {
			state.SetActivity(ActivityExplorer)
		}), design.PrimaryButton("New project", state.ToggleProjectCreator)), design.Space2)
	}
	if viewportWidth < 1080 {
		if activity == ActivityHome {
			actions = ui.Gap(ui.Row(design.QuietButton("Open workspace", func() {
				state.SetActivity(ActivityExplorer)
			}), design.PrimaryButton("New project", state.ToggleProjectCreator)), design.Space2)
		} else {
			actions = ui.Gap(ui.Row(design.QuietButton("Commands", state.ShowCommandPalette), save, share, run, preview), design.Space2)
		}
	}
	bar := ui.Row(left, ui.Flex(ui.Box(), 1), statusView, actions)
	bar = ui.Gap(bar, design.Space3)
	bar = ui.Align(bar, ui.AlignCenter)
	return ui.TestID(ui.Role(design.TopBar(bar), "toolbar"), "studio-topbar")
}

func (state *State) View() ui.View {
	if runnerRoute(ui.LocationPath()) {
		return state.RunnerView()
	}
	state.mu.RLock()
	preferredMode := preferredRuntimeMode(state.host)
	activity := state.activity
	previewState := state.previewState
	problemCount := len(state.diagnostics)
	state.mu.RUnlock()
	viewportWidth := ui.CurrentEnvironment().ViewportWidth
	workspaceOptions := workspace.DefaultOptions()
	workspaceOptions.SplitterSize = 2
	workspaceOptions.TabPadding = 10
	workspaceOptions.TabBarBackground = design.SurfaceSunken
	workspaceOptions.TabBackground = design.SurfaceSunken
	workspaceOptions.ActiveTabBackground = design.Surface
	workspaceOptions.TabForeground = design.TextMuted
	workspaceOptions.ActiveTabForeground = design.TextPrimary
	workspaceOptions.SplitterColor = design.Divider
	body := ui.Flex(state.layout.ViewWithOptions(workspaceOptions), 1)
	if activity == ActivityHome {
		body = ui.Flex(state.Home(), 1)
	}
	content := ui.Column(state.TopBar(), state.FindBar(), ui.Flex(ui.Row(state.ActivityRail(), body), 1))
	if viewportWidth < 840 {
		if activity == ActivityExplorer {
			output := state.ConsolePanel()
			outputHeight := 150.0
			if previewState != domain.PreviewIdle {
				output = state.PreviewPanel()
				outputHeight = 220
			} else if problemCount > 0 {
				output = state.ProblemsPanel()
			}
			side := ui.Overflow(ui.MinHeight(ui.Height(state.SidePanel(), 300), 0), ui.OverflowHidden)
			body = ui.Column(side, ui.Flex(ui.MinHeight(state.EditorPanel(), 0), 1), ui.Height(output, outputHeight))
		} else if activity == ActivityDocs {
			body = ui.Column(ui.Height(state.SidePanel(), 180), ui.Flex(state.DocsPanel(), 1))
		} else if activity == ActivitySearch {
			body = ui.Column(ui.Height(state.SidePanel(), 220), ui.Flex(ui.MinHeight(state.EditorPanel(), 0), 1))
		} else if activity == ActivitySourceControl {
			body = ui.Column(ui.Height(state.SidePanel(), 280), ui.Flex(ui.MinHeight(state.RemoteDiffPanel(), 0), 1))
		} else if activity != ActivityHome {
			body = ui.Flex(state.SidePanel(), 1)
		}
		content = ui.Column(state.TopBar(), state.FindBar(), ui.Flex(body, 1), state.ActivityRail())
	}
	content = design.AppSurface(content)
	content = ui.MinWidth(content, 0)
	content = ui.MinHeight(content, 320)
	viewportHeight := ui.CurrentEnvironment().ViewportHeight
	if viewportHeight > 0 {
		// Bound the application shell to the host viewport so each workspace
		// surface owns its scroll position. Navigating from a long start page
		// must never carry the browser document scroll into the editor.
		content = ui.Height(content, viewportHeight)
	}
	scope := state.commandScope(preferredMode)
	content = ui.Stack(content, state.CommandPalette(scope, preferredMode), state.ProjectRenameDialog(), state.ProjectDeleteDialog(), state.PendingConfirmationDialog(), state.RemoteDeleteDialog(), state.ProjectShareDialog(), state.AccountDialog(), state.NewFileDialog(), state.RenameFileDialog())
	return scope.Bind(content)
}
