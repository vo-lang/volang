	uisystem "github.com/vo-lang/ui/system"
	"github.com/vo-lang/ui/workspace"
	"strconv"
	"strings"
	"sync"
	"time"
)

func inferredSourcePackage(path string) string {
	slash := strings.LastIndex(path, "/")
	if slash < 0 {
		return "main"
	}
	directory := path[:slash]
	if parent := strings.LastIndex(directory, "/"); parent >= 0 {
		directory = directory[parent+1:]
	}
	if directory == "" || isSourceKeyword(directory) {
		return "main"
	}
	for index, value := range directory {
		if value == '_' || value >= 'a' && value <= 'z' || value >= 'A' && value <= 'Z' ||
			value >= 128 || index > 0 && value >= '0' && value <= '9' {
			continue
		}
		return "main"
	}
	return directory
}

func isSourceKeyword(value string) bool {
	const keywords = "|break|case|chan|const|continue|default|defer|else|fallthrough|for|func|go|goto|if|import|interface|island|map|package|port|range|return|select|struct|switch|type|var|fail|errdefer|"
	return strings.Contains(keywords, "|" + value + "|")
}

func preferredRuntimeMode(host domain.HostInfo) domain.RuntimeMode {
	for _, mode := range host.RuntimeModes {
		if mode == domain.RuntimeJIT {
			return mode
		}
	}
	if len(host.RuntimeModes) > 0 {
		return host.RuntimeModes[0]
	}
	return domain.RuntimeVM
}

func supportsRuntimeMode(host domain.HostInfo, mode domain.RuntimeMode) bool {
	for _, available := range host.RuntimeModes {
		if available == mode {
			return true
		}
	}
	return false
}

func studioStatusColor(value string, busy bool) uint32 {
	lower := strings.ToLower(value)
	if strings.Contains(lower, "failed") || strings.Contains(lower, "error") ||
		strings.Contains(lower, "unavailable") ||
		(strings.Contains(lower, "problems") && !strings.HasPrefix(lower, "0 ")) {
		return design.Danger
	}
	if busy || strings.Contains(lower, "building") || strings.Contains(lower, "analyzing") ||
		strings.Contains(lower, "creating") ||
		strings.Contains(lower, "opening") ||
		strings.Contains(lower, "loading") ||
		strings.Contains(lower, "saving") ||
		strings.Contains(lower, "in progress") ||
		strings.Contains(lower, "connecting") ||
		strings.Contains(lower, "deleting") ||
		strings.Contains(lower, "renaming") {
		return design.Warning
	}
	if strings.Contains(lower, "ready") || strings.Contains(lower, "finished") ||
		strings.Contains(lower, "saved") ||
		strings.Contains(lower, "complete") ||
		strings.Contains(lower, "connected") ||
		strings.Contains(lower, "copied") ||
		strings.HasPrefix(lower, "0 problems") {
		return design.Success
	}
	return design.Accent
}

func applicationPath(location string) string {
	path := location
	if index := strings.Index(path, "?"); index >= 0 {
		path = path[:index]
	}
	if index := strings.Index(path, "#"); index >= 0 {
		path = path[:index]
	}
	return path
}

func locationFragment(location string) string {
	index := strings.Index(location, "#")
	if index < 0 || index + 1 >= len(location) {
		return ""
	}
	fragment := location[index + 1:]
	if query := strings.Index(fragment, "?"); query >= 0 {
		fragment = fragment[:query]
	}
	return fragment
}

func runnerRoute(location string) bool {
	return applicationPath(location) == "/runner"
}

func documentationRoute(location string) (string, bool) {
	path := applicationPath(location)
	if !strings.HasPrefix(path, "/docs/") {
		return "", false
	}
	id := strings.TrimPrefix(path, "/docs/")
	for _, page := range documentationPages() {
		if page.ID == id {
			return id, true
		}
	}
	return "introduction", true
}

func workspaceActivityRoute(location string) (Activity, bool) {
	switch applicationPath(location) {
		case "/workspace":
			return ActivityExplorer, true
		case "/search":
			return ActivitySearch, true
		case "/source-control":
			return ActivitySourceControl, true
	}
	return ActivityHome, false
}

func workspaceActivityPath(activity Activity) string {
	if activity == ActivityExplorer {
		return "/workspace"
	}
	if activity == ActivitySearch {
		return "/search"
	}
	if activity == ActivitySourceControl {
		return "/source-control"
	}
	return "/"
}

func reservedPortableName(value string) bool {
	stem := strings.Split(value, ".")[0]
	upper := strings.ToUpper(stem)
	return upper == "CON" || upper == "PRN" || upper == "AUX" || upper == "NUL" ||
		upper == "COM1" || upper == "COM2" || upper == "COM3" || upper == "COM4" ||
		upper == "COM5" || upper == "COM6" || upper == "COM7" || upper == "COM8" ||
		upper == "COM9" || upper == "LPT1" || upper == "LPT2" || upper == "LPT3" ||
		upper == "LPT4" || upper == "LPT5" || upper == "LPT6" || upper == "LPT7" ||
		upper == "LPT8" || upper == "LPT9"
}

func relativePathError(value string) string {
	path := strings.TrimSpace(value)
	if path == "" {
		return ""
	}
	if len(path) > 4096 {
		return "The path is too long."
	}
	if strings.HasPrefix(path, "/") || strings.Contains(path, "\\") {
		return "Use a project-relative path with forward slashes."
	}
	for index, part := range strings.Split(path, "/") {
		if part == "" || part == "." || part == ".." {
			return "The path cannot contain empty, current, or parent segments."
		}
		if index == 0 && part == ".volang" {
			return "The .volang directory is reserved by Studio."
		}
		if len(part) > 255 {
			return "Each path segment must use no more than 255 bytes."
		}
		if strings.HasSuffix(part, ".") || strings.HasSuffix(part, " ") {
			return "Path segments cannot end with a dot or space."
		}
		for _, character := range []byte(part) {
			if character < 32 || character == '<' || character == '>' || character == ':' ||
				character == '"' || character == '|' || character == '?' || character == '*' {
				return "The path contains a character that is unavailable on desktop platforms."
			}
		}
		if reservedPortableName(part) {
			return "The path contains a reserved desktop device name."
		}
	}
	return ""
}

func validRelativePath(value string) bool {
	return strings.TrimSpace(value) != "" && relativePathError(value) == ""
}

func projectNameError(value string) string {
	name := strings.TrimSpace(value)
	if name == "" {
		return "Enter a project name."
	}
	if len(name) > 128 {
		return "Use no more than 128 characters."
	}
	for _, value := range []byte(name) {
		if (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') ||
			(value >= '0' && value <= '9') || value == '-' || value == '_' {
			continue
		}
		return "Use letters, numbers, dashes, and underscores only."
	}
	if reservedPortableName(name) {
		return "Choose a name that is available on every desktop platform."
	}
	return ""
}

const (
	MaxConsoleEntries = 4000
	MaxOpenBuffers = 256
	MaxSearchResults = 500
	MaxSaveQueue = 64
	MaxSearchWorkers = 4
)

type workspaceSearchResult struct {
	Path string
	Line int
	Column int
	Preview string
}

type searchJob struct {
	Index int
	File domain.FileEntry
	Text string
	HasText bool
}

type searchFileMatches struct {
	Index int
	Values []workspaceSearchResult
}

type saveBatch struct {
	Project domain.Project
	ProjectGeneration uint64
	Snapshots []saveSnapshot
}

type Activity int64

const (
	ActivityHome Activity = iota
	ActivityExplorer
	ActivitySearch
	ActivitySourceControl
	ActivityDocs
)

type State struct {
	mu sync.RWMutex
	services protocol.Services
	host domain.HostInfo
	projects []domain.Project
	current domain.Project
	hasProject bool
	projectGeneration uint64
	projectLoadGeneration uint64
	projectLoadCancel context.CancelFunc
	projectSelectionGeneration uint64
	pendingProject domain.Project
	hasPendingProject bool
	projectSwitchProject domain.Project
	projectSwitchSelection uint64
	filesGeneration uint64
	files []domain.FileEntry
	collapsedDirectories map[string]bool
	activePath string
	editor *editor.Model
	editorFocusToken int64
	buffers map[string]*editor.Model
	openPaths []string
	openGeneration uint64
	dirty map[string]bool
	savedText map[string]string
	saveQueue chan saveBatch
	savePending int
	diagnostics []domain.Diagnostic
	diagnosticsByPath map[string][]domain.Diagnostic
	console []domain.ConsoleEntry
	consoleSequence uint64
	activity Activity
	searchQuery string
	searchResults []workspaceSearchResult
	searching bool
	searchGeneration uint64
	searchCancel context.CancelFunc
	findVisible bool
	findQuery string
	paletteVisible bool
	paletteQuery string
	paletteSelected int64
	paletteFocusToken int64
	projectCreatorVisible bool
	openingExample string
	renameProjectVisible bool
	renameProject domain.Project
	renameProjectName string
	renameProjectError string
	deleteProjectVisible bool
	deleteProject domain.Project
	projectMutationBusy bool
	shareVisible bool
	shareLoading bool
	shareGeneration uint64
	share domain.ProjectShare
	accountVisible bool
	accountLoading bool
	accountLoaded bool
	account domain.AccountState
	newProjectName string
	newProjectError string
	newProjectFocusToken int64
	projectCreationBusy bool
	projectSearchQuery string
	newFilePath string
	newFileVisible bool
	renamePath string
	renameFileVisible bool
	closeFilePath string
	closeFileProjectGeneration uint64
	deleteFilePath string
	deleteFileProject domain.Project
	deleteFileProjectGeneration uint64
	running bool
	runMode domain.RuntimeMode
	runPreview bool
	runGeneration uint64
	runCancel context.CancelFunc
	analysisGeneration uint64
	analysisCancel context.CancelFunc
	previewState domain.PreviewState
	previewSurface string
	previewStale bool
	previewError string
	remote domain.RemoteState
	remoteLoaded bool
	remoteLoading bool
	remoteBusy bool
	remoteCancel context.CancelFunc
	remoteGeneration uint64
	remoteDiff domain.RemoteDiff
	remoteDiffLoading bool
	remoteDeleteVisible bool
	remoteDeleteConfirmation string
	remoteDeleteBusy bool
	commitMessage string
	docQuery string
	docPageID string
	docExpanded map[string]bool
	docHeadingID string
	docFocusToken int64
	status string
	layout *workspace.Model
}

func New(services protocol.Services) *State {
	services.Validate()
	state := &State{
		services: services, buffers: make(map[string]*editor.Model), dirty: make(map[string]bool),
		savedText: make(map[string]string), saveQueue: make(chan saveBatch, MaxSaveQueue),
		diagnosticsByPath: make(map[string][]domain.Diagnostic), docPageID: "introduction",
		docExpanded: make(map[string]bool), collapsedDirectories: make(map[string]bool), status: "Ready",
	}
	sections := documentation.Sections()
	if len(sections) > 0 {
		state.docExpanded[sections[0].ID] = true
	}
	var err error
	state.layout, err = workspace.New(workspace.Split("studio-root", workspace.Horizontal, 0.19, workspace.PanelLayout("side-panel", "side-panel"), workspace.Split("studio-main", workspace.Vertical, 0.65, workspace.Tabs("documents", 0, workspace.PanelLayout("editor-panel", "editor"), workspace.PanelLayout("docs-panel", "docs")), workspace.Tabs("bottom", 0, workspace.PanelLayout("console-panel", "console"), workspace.PanelLayout("preview-panel", "preview"), workspace.PanelLayout("problems-panel", "problems"), workspace.PanelLayout("changes-panel", "changes")))), []workspace.Panel{
		{ID: "side-panel", Title: "Navigation", Content: state.SidePanel},
		{ID: "editor", Title: "Editor", Content: state.EditorPanel},
		{ID: "docs", Title: "Documentation", Content: state.DocsPanel},
		{ID: "console", Title: "Console", Content: state.ConsolePanel},
		{ID: "preview", Title: "Preview", Content: state.PreviewPanel},
		{ID: "problems", Title: "Problems", Content: state.ProblemsPanel},
		{ID: "changes", Title: "Changes", Content: state.RemoteDiffPanel},
	})
	if err != nil {
		panic(err.Error())
	}
	go state.saveLoop()
	return state
}

func (state *State) appendConsoleLocked(level domain.ConsoleLevel, source string, text string) {
	state.consoleSequence++
	state.console = append(state.console, domain.ConsoleEntry{
		Sequence: state.consoleSequence, Time: time.Now(), Level: level, Source: source, Text: text,
	})
	if len(state.console) > MaxConsoleEntries {
		state.console = append([]domain.ConsoleEntry(nil), state.console[len(state.console) -
			MaxConsoleEntries:]...)
	}
}

func (state *State) log(level domain.ConsoleLevel, source string, text string) {
	state.mu.Lock()
	state.appendConsoleLocked(level, source, text)
	state.mu.Unlock()
	ui.Invalidate()
}

// ReportFailure makes launcher and host lifecycle errors visible inside the
// product while preserving the mounted shell for recovery actions.
func (state *State) ReportFailure(source string, err error) {
	if err == nil {
		return
	}
	state.mu.Lock()
	state.status = "Action failed"
	state.appendConsoleLocked(domain.ConsoleError, source, err.Error())
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) Bootstrap(ctx context.Context) error {
	location := ui.LocationPath()
	routeActivity, hasWorkspaceRoute := workspaceActivityRoute(location)
	host, err := state.services.Host.Info(ctx)
	if err != nil {
		return err
	}
	if host.Platform == "" || len(host.RuntimeModes) == 0 {
		return errors.New("Studio host returned incomplete capabilities")
	}
	state.mu.Lock()
	state.host = host
	state.mu.Unlock()
	projects, err := state.services.Files.Projects(ctx)
	if err != nil {
		return err
	}
	state.mu.Lock()
	state.projects = projects
	if hasWorkspaceRoute {
		state.activity = routeActivity
	}
	state.mu.Unlock()
	pageID, hasDocumentationRoute := documentationRoute(location)
	if len(projects) == 0 {
		if hasDocumentationRoute {
			state.mu.Lock()
			state.activity = ActivityDocs
			state.docPageID = pageID
			state.expandDocPageLocked(pageID)
			state.docHeadingID = locationFragment(location)
			if state.docHeadingID != "" {
				state.docFocusToken++
			}
			state.mu.Unlock()
			_ = state.layout.Activate("documents", 1)
		}
		ui.Invalidate()
		return nil
	}
	project := projects[0]
	for _, candidate := range projects[1:] {
		if candidate.LastOpenedUnixMillis > project.LastOpenedUnixMillis {
			project = candidate
		}
	}
	if err := state.loadProject(ctx, project, false); err != nil {
		return err
	}
	if hasDocumentationRoute {
		state.mu.Lock()
		state.activity = ActivityDocs
		state.docPageID = pageID
		state.expandDocPageLocked(pageID)
		state.docHeadingID = locationFragment(location)
		if state.docHeadingID != "" {
			state.docFocusToken++
		}
		state.mu.Unlock()
		_ = state.layout.Activate("documents", 1)
	}
	if runnerRoute(location) {
		state.StartRun(preferredRuntimeMode(host), true)
	} else if hasWorkspaceRoute && routeActivity == ActivitySourceControl && host.CanSyncRemote {
		state.RefreshRemote()
	}
	return nil
}

func preferredFile(files []domain.FileEntry) string {
	for _, file := range files {
		if file.Path == "main.vo" {
			return file.Path
		}
	}
	for _, file := range files {
		if file.Kind == domain.SourceFile {
			return file.Path
		}
	}
	if len(files) > 0 {
		return files[0].Path
	}
	return ""
}

func newEditor(project domain.Project, path string, text string) *editor.Model {
	return editor.New(document.NewText(text), "file://" + project.Root + "/" + path, "volang")
}

func (state *State) activateBufferLocked(path string, code *editor.Model) {
	state.activePath = path
	state.renamePath = path
	state.editor = code
	state.diagnostics = append([]domain.Diagnostic(nil), state.diagnosticsByPath[path]...)
	state.status = path
}

func (state *State) hasDirtyLocked() bool {
	for _, dirty := range state.dirty {
		if dirty {
			return true
		}
	}
	return false
}

func (state *State) cancelProjectWorkLocked() {
	state.filesGeneration++
	if state.runCancel != nil {
		state.runCancel()
		state.runCancel = nil
	}
	state.runGeneration++
	state.running = false
	state.runPreview = false
	if state.analysisCancel != nil {
		state.analysisCancel()
		state.analysisCancel = nil
	}
	state.analysisGeneration++
	if state.searchCancel != nil {
		state.searchCancel()
		state.searchCancel = nil
	}
	state.searchGeneration++
	state.searching = false
	if state.remoteCancel != nil {
		state.remoteCancel()
		state.remoteCancel = nil
	}
	state.remoteGeneration++
	state.remoteLoading = false
	state.remoteBusy = false
	state.remoteDiffLoading = false
	state.shareGeneration++
	state.shareLoading = false
}

// detachCurrentProjectLocked removes every guest-visible reference to the
// current project before an asynchronous replacement project is opened. This
// keeps editors and save actions from targeting a project that the host has
// already deleted or forgotten.
func (state *State) detachCurrentProjectLocked() string {
	previousPreview := state.previewSurface
	if state.projectLoadCancel != nil {
		state.projectLoadCancel()
		state.projectLoadCancel = nil
	}
	state.projectLoadGeneration++
	state.projectSelectionGeneration++
	state.cancelProjectWorkLocked()
	state.projectGeneration++
	state.hasProject = false
	state.current = domain.Project{}
	state.files = nil
	state.activePath = ""
	state.renamePath = ""
	state.editor = nil
	state.buffers = make(map[string]*editor.Model)
	state.openPaths = nil
	state.openGeneration++
	state.dirty = make(map[string]bool)
	state.savedText = make(map[string]string)
	state.diagnostics = nil
	state.diagnosticsByPath = make(map[string][]domain.Diagnostic)
	state.searchResults = nil
	state.findVisible = false
	state.findQuery = ""
	state.paletteVisible = false
	state.paletteQuery = ""
	state.pendingProject = domain.Project{}
	state.hasPendingProject = false
	state.projectSwitchProject = domain.Project{}
	state.newFileVisible = false
	state.newFilePath = ""
	state.renameFileVisible = false
	state.closeFilePath = ""
	state.deleteFilePath = ""
	state.deleteFileProject = domain.Project{}
	state.shareVisible = false
	state.share = domain.ProjectShare{}
	state.previewState = domain.PreviewIdle
	state.previewSurface = ""
	state.previewStale = false
	state.previewError = ""
	state.remote = domain.RemoteState{}
	state.remoteLoaded = false
	state.remoteDiff = domain.RemoteDiff{}
	return previousPreview
}

func (state *State) projectLoadFailed(generation uint64, cancel context.CancelFunc, err error) error {
	cancel()
	state.mu.Lock()
	current := generation == state.projectLoadGeneration
	if current {
		state.projectLoadCancel = nil
		state.status = "Project open failed"
	}
	state.mu.Unlock()
	if !current {
		return nil
	}
	return err
}

func (state *State) loadProject(ctx context.Context, project domain.Project, discardDirty bool) error {
	state.mu.Lock()
	if state.projectLoadCancel != nil {
		state.projectLoadCancel()
	}
	loadCtx, cancel := context.WithCancel(ctx)
	state.projectLoadCancel = cancel
	state.projectLoadGeneration++
	generation := state.projectLoadGeneration
	state.status = "Opening " + project.Name
	state.mu.Unlock()
	ui.Invalidate()
	files, err := state.services.Files.Files(loadCtx, project.ID)
	if err != nil {
		return state.projectLoadFailed(generation, cancel, err)
	}
	path := preferredFile(files)
	var code *editor.Model
	text := ""
	if path != "" {
		var readErr error
		text, readErr = state.services.Files.ReadFile(loadCtx, project.ID, path)
		if readErr != nil {
			return state.projectLoadFailed(generation, cancel, readErr)
		}
		code = newEditor(project, path, text)
	}
	state.mu.Lock()
	if generation != state.projectLoadGeneration {
		state.mu.Unlock()
		cancel()
		return nil
	}
	if state.savePending > 0 || state.projectMutationBusy {
		state.projectLoadCancel = nil
		state.status = "Current project operation is still finishing; choose the project again"
		state.mu.Unlock()
		cancel()
		ui.Invalidate()
		return nil
	}
	if !discardDirty && state.hasProject && state.hasDirtyLocked() {
		state.projectLoadCancel = nil
		state.status = "Current project changed while opening; choose the project again to continue"
		state.mu.Unlock()
		cancel()
		ui.Invalidate()
		return nil
	}
	previousPreview := state.previewSurface
	state.cancelProjectWorkLocked()
	state.projectGeneration++
	state.projectLoadCancel = nil
	state.current = project
	state.current.LastOpenedUnixMillis = time.Now().UnixMilli()
	state.hasProject = true
	for index, candidate := range state.projects {
		if candidate.ID == project.ID {
			state.projects[index] = state.current
			break
		}
	}
	state.files = files
	state.collapsedDirectories = make(map[string]bool)
	state.buffers = make(map[string]*editor.Model)
	state.openPaths = nil
	state.openGeneration++
	state.dirty = make(map[string]bool)
	state.savedText = make(map[string]string)
	state.diagnosticsByPath = make(map[string][]domain.Diagnostic)
	if code != nil {
		state.buffers[path] = code
		state.openPaths = append(state.openPaths, path)
		state.savedText[path] = text
	}
	state.activePath = ""
	state.renamePath = ""
	state.editor = nil
	if code != nil {
		state.activateBufferLocked(path, code)
	}
	state.diagnostics = nil
	state.findVisible = false
	state.findQuery = ""
	state.paletteVisible = false
	state.paletteQuery = ""
	state.paletteSelected = 0
	state.projectCreatorVisible = false
	state.newProjectError = ""
	state.renameProjectError = ""
	state.pendingProject = domain.Project{}
	state.hasPendingProject = false
	state.newFileVisible = false
	state.newFilePath = ""
	state.renameFileVisible = false
	state.shareVisible = false
	state.share = domain.ProjectShare{}
	state.previewState = domain.PreviewIdle
	state.previewSurface = ""
	state.previewStale = false
	state.previewError = ""
	state.remote = domain.RemoteState{}
	state.remoteLoaded = false
	state.remoteLoading = false
	state.remoteBusy = false
	state.remoteDiff = domain.RemoteDiff{}
	state.remoteDiffLoading = false
	state.remoteDeleteVisible = false
	state.remoteDeleteBusy = false
	state.remoteDeleteConfirmation = ""
	state.commitMessage = "Update from Volang Studio"
	state.status = "Ready"
	state.appendConsoleLocked(domain.ConsoleSuccess, "workspace", "Opened " + project.Name)
	activity := state.activity
	state.mu.Unlock()
	activationErr := state.services.Files.ActivateProject(loadCtx, project.ID)
	cancel()
	if activationErr != nil {
		state.log(domain.ConsoleWarning, "workspace", "Could not remember the active project: " + activationErr.Error())
	}
	if _, docs := documentationRoute(ui.LocationPath()); !docs && !runnerRoute(ui.LocationPath()) && activity != ActivityHome {
		ui.Navigate(workspaceActivityPath(activity))
	}
	_ = state.layout.Activate("documents", 0)
	if previousPreview != "" {
		_ = state.services.Preview.ClosePreview(context.Background(), previousPreview)
	}
	if code != nil {
		state.scheduleAnalysis(code.Document.Version())
	}
	return nil
}

func (state *State) requestProjectLoad(project domain.Project) {
	state.mu.Lock()
	if state.hasProject && state.current.ID == project.ID {
		state.pendingProject = domain.Project{}
		state.hasPendingProject = false
		state.activity = ActivityExplorer
		state.status = project.Name
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	if state.savePending > 0 {
		state.projectSelectionGeneration++
		state.pendingProject = project
		state.hasPendingProject = true
		state.activity = ActivityExplorer
		state.status = "Finishing saves before opening " + project.Name
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	if state.projectMutationBusy {
		state.activity = ActivityExplorer
		state.status = "Wait for the current project operation to finish"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	state.pendingProject = domain.Project{}
	state.hasPendingProject = false
	state.projectSelectionGeneration++
	selection := state.projectSelectionGeneration
	dirty := state.hasDirtyLocked()
	state.activity = ActivityExplorer
	if dirty {
		state.projectSwitchProject = project
		state.projectSwitchSelection = selection
		state.status = "Confirm opening " + project.Name
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	state.status = "Opening " + project.Name
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		state.mu.RLock()
		current := selection == state.projectSelectionGeneration
		state.mu.RUnlock()
		if !current {
			return
		}
		if err := state.loadProject(context.Background(), project, false); err != nil {
			state.log(domain.ConsoleError, "workspace", err.Error())
		}
		ui.Invalidate()
	}()
}

func (state *State) HideProjectSwitchDialog() {
	state.mu.Lock()
	if state.projectSwitchProject.ID != "" {
		if state.projectSwitchSelection == state.projectSelectionGeneration {
			state.status = "Kept current project"
		}
		state.projectSwitchProject = domain.Project{}
	}
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) ConfirmProjectSwitch() {
	state.mu.Lock()
	if state.projectSwitchProject.ID == "" || state.projectSwitchSelection != state.projectSelectionGeneration {
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	project := state.projectSwitchProject
	selection := state.projectSwitchSelection
	state.projectSwitchProject = domain.Project{}
	state.status = "Opening " + project.Name
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		state.mu.RLock()
		current := selection == state.projectSelectionGeneration
		state.mu.RUnlock()
		if !current {
			return
		}
		if err := state.loadProject(context.Background(), project, true); err != nil {
			state.log(domain.ConsoleError, "workspace", err.Error())
		}
		ui.Invalidate()
	}()
}

func (state *State) SelectProject(id domain.ProjectID) {
	state.mu.RLock()
	projects := append([]domain.Project(nil), state.projects...)
	state.mu.RUnlock()
	for _, project := range projects {
		if project.ID == id {
			state.requestProjectLoad(project)
			return
		}
	}
}

func (state *State) OpenExample(id string) {
	example, ok := studioexamples.Find(id)
	if !ok {
		state.log(domain.ConsoleError, "examples", "Example was not found")
		return
	}
	state.mu.Lock()
	if state.projectMutationBusy || state.projectCreationBusy {
		state.status = "Wait for the current project operation before opening an example"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	if state.openingExample != "" {
		state.mu.Unlock()
		return
	}
	for _, project := range state.projects {
		if project.Name == example.ProjectName {
			state.activity = ActivityExplorer
			state.status = "Opening " + example.Title
			state.mu.Unlock()
			state.SelectProject(project.ID)
			return
		}
	}
	state.openingExample = example.ID
	state.projectMutationBusy = true
	state.status = "Creating editable " + example.Title + " project"
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		project, err := state.services.Files.CreateProject(context.Background(), protocol.CreateProjectRequest{
			Name: example.ProjectName, Template: "studio-example/" + example.ID, Files: example.Files,
		})
		if err != nil {
			state.mu.Lock()
			state.openingExample = ""
			state.projectMutationBusy = false
			state.status = "Example failed to open"
			state.appendConsoleLocked(domain.ConsoleError, "examples", err.Error())
			state.mu.Unlock()
			ui.Invalidate()
			return
		}
		state.mu.Lock()
		state.projects = append(state.projects, project)
		state.openingExample = ""
		state.projectMutationBusy = false
		state.mu.Unlock()
		state.requestProjectLoad(project)
	}()
}

func (state *State) ShowHome() {
	state.mu.Lock()
	state.activity = ActivityHome
	state.status = "Starter projects and recent workspaces"
	state.mu.Unlock()
	ui.Navigate("/")
	ui.Invalidate()
}

func (state *State) ShowShareProject() {
	state.mu.Lock()
	if !state.hasProject || state.shareLoading {
		state.mu.Unlock()
		return
	}
	state.shareVisible = true
	state.share = domain.ProjectShare{}
	if state.projectMutationBusy {
		state.share = domain.ProjectShare{Reason: "Wait for the current project operation before sharing."}
		state.status = "Project operation still in progress"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	if state.hasDirtyLocked() || state.savePending > 0 {
		state.share = domain.ProjectShare{
			Reason: "Save all edited files before creating an immutable project link.",
		}
		state.status = "Save changes before sharing"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	state.shareLoading = true
	state.shareGeneration++
	generation := state.shareGeneration
	project := state.current
	projectGeneration := state.projectGeneration
	state.status = "Creating portable project links"
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		result, err := state.services.Share.Share(context.Background(), project.ID)
		state.mu.Lock()
		if generation != state.shareGeneration || projectGeneration != state.projectGeneration ||
			state.current.ID != project.ID {
			state.mu.Unlock()
			return
		}
		state.shareLoading = false
		if err != nil {
			state.share = domain.ProjectShare{Reason: err.Error()}
			state.status = "Project link failed"
			state.appendConsoleLocked(domain.ConsoleError, "share", err.Error())
		} else {
			state.share = result
			if result.Shareable {
				state.status = "Portable project links ready"
				state.appendConsoleLocked(domain.ConsoleSuccess, "share", "Created Studio and Runner links for " +
					project.Name)
			} else {
				state.status = "Project link unavailable"
			}
		}
		state.mu.Unlock()
		ui.Invalidate()
	}()
}

func (state *State) HideShareProject() {
	state.mu.Lock()
	state.shareGeneration++
	state.shareLoading = false
	state.shareVisible = false
	state.share = domain.ProjectShare{}
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) ShowAccount() {
	state.mu.Lock()
	state.accountVisible = true
	if state.accountLoading || state.accountLoaded {
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	state.accountLoading = true
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		account, err := state.services.Account.Account(context.Background())
		state.mu.Lock()
		state.accountLoading = false
		if err != nil {
			state.appendConsoleLocked(domain.ConsoleError, "account", err.Error())
		} else {
			state.account = account
			state.accountLoaded = true
		}
		state.mu.Unlock()
		ui.Invalidate()
	}()
}

func (state *State) HideAccount() {
	state.mu.Lock()
	if !state.accountLoading {
		state.accountVisible = false
	}
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) ConnectAccount() {
	state.mu.Lock()
	if state.accountLoading {
		state.mu.Unlock()
		return
	}
	state.accountLoading = true
	state.status = "Connecting GitHub account"
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		account, err := state.services.Account.ConnectAccount(context.Background())
		state.mu.Lock()
		state.accountLoading = false
		if err != nil {
			if strings.Contains(strings.ToLower(err.Error()), "cancelled") {
				state.status = "GitHub connection cancelled"
			} else {
				state.status = "GitHub connection failed"
				state.appendConsoleLocked(domain.ConsoleError, "account", err.Error())
			}
		} else {
			state.account = account
			state.accountLoaded = true
			state.status = "Connected as " + account.Login
			state.appendConsoleLocked(domain.ConsoleSuccess, "account", "Connected GitHub account " +
				account.Login)
		}
		state.mu.Unlock()
		ui.Invalidate()
	}()
}

func (state *State) DisconnectAccount() {
	state.mu.Lock()
	if state.accountLoading {
		state.mu.Unlock()
		return
	}
	state.accountLoading = true
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		err := state.services.Account.DisconnectAccount(context.Background())
		state.mu.Lock()
		state.accountLoading = false
		if err != nil {
			state.status = "GitHub disconnect failed"
			state.appendConsoleLocked(domain.ConsoleError, "account", err.Error())
		} else {
			state.account = domain.AccountState{Provider: "github"}
			state.accountLoaded = true
			state.status = "GitHub account disconnected"
		}
		state.mu.Unlock()
		ui.Invalidate()
	}()
}

func (state *State) copyProjectLink(value string, label string) {
	if value == "" {
		return
	}
	if err := uisystem.WriteClipboardText(value); err != nil {
		state.log(domain.ConsoleError, "share", err.Error())
		return
	}
	state.mu.Lock()
	state.status = label + " copied"
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) BeginRenameProject(project domain.Project) {
	state.mu.Lock()
	if state.projectMutationBusy || state.projectCreationBusy {
		state.mu.Unlock()
		return
	}
	state.renameProject = project
	state.renameProjectName = project.Name
	state.renameProjectError = ""
	state.renameProjectVisible = true
	state.status = "Rename " + project.Name
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) SetRenameProjectName(value string) {
	state.mu.Lock()
	state.renameProjectName = value
	state.renameProjectError = projectNameError(value)
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) HideRenameProject() {
	state.mu.Lock()
	if !state.projectMutationBusy {
		state.renameProjectVisible = false
		state.renameProjectName = ""
		state.renameProjectError = ""
	}
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) RenameProject() {
	state.mu.Lock()
	name := strings.TrimSpace(state.renameProjectName)
	project := state.renameProject
	nameError := projectNameError(name)
	if !state.renameProjectVisible || state.projectMutationBusy {
		state.mu.Unlock()
		return
	}
	if nameError != "" {
		state.renameProjectError = nameError
		state.status = "Enter a valid project name"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	if state.hasProject && state.current.ID == project.ID && state.savePending > 0 {
		state.status = "Wait for pending saves before renaming"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	state.projectMutationBusy = true
	state.status = "Renaming " + project.Name
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		renamed, err := state.services.Files.RenameProject(context.Background(), project.ID, name)
		state.mu.Lock()
		if err != nil {
			state.projectMutationBusy = false
			state.status = "Project rename failed"
			state.renameProjectError = err.Error()
			state.appendConsoleLocked(domain.ConsoleError, "project", err.Error())
			state.mu.Unlock()
			ui.Invalidate()
			return
		}
		wasCurrent := state.hasProject && state.current.ID == project.ID
		previousPreview := ""
		rebindPaths := make([]string, 0)
		rebindEditors := make([]*editor.Model, 0)
		var activeEditor *editor.Model
		for index, existing := range state.projects {
			if existing.ID == project.ID {
				state.projects[index] = renamed
				break
			}
		}
		if wasCurrent {
			previousPreview = state.previewSurface
			state.cancelProjectWorkLocked()
			state.projectGeneration++
			state.current = renamed
			state.previewState = domain.PreviewIdle
			state.previewSurface = ""
			state.previewStale = false
			state.previewError = ""
			state.remote = domain.RemoteState{}
			state.remoteLoaded = false
			state.remoteDiff = domain.RemoteDiff{}
			for _, path := range state.openPaths {
				if code := state.buffers[path]; code != nil {
					rebindPaths = append(rebindPaths, path)
					rebindEditors = append(rebindEditors, code)
				}
			}
			activeEditor = state.editor
		}
		state.renameProjectVisible = false
		state.renameProjectName = ""
		state.renameProjectError = ""
		state.status = "Renamed project to " + renamed.Name
		state.appendConsoleLocked(domain.ConsoleSuccess, "project", "Renamed " + project.Name + " to " +
			renamed.Name)
		state.mu.Unlock()
		for index, code := range rebindEditors {
			if err := code.Rebind("file://" + renamed.Root + "/" + rebindPaths[index], "volang"); err != nil {
				state.log(domain.ConsoleError, "editor", err.Error())
			}
		}
		if previousPreview != "" {
			_ = state.services.Preview.ClosePreview(context.Background(), previousPreview)
		}
		state.mu.Lock()
		state.projectMutationBusy = false
		state.mu.Unlock()
		if activeEditor != nil {
			state.scheduleAnalysis(activeEditor.Document.Version())
		}
		ui.Invalidate()
	}()
}

func (state *State) BeginDeleteProject(project domain.Project) {
	state.mu.Lock()
	if state.projectMutationBusy || state.projectCreationBusy {
		state.mu.Unlock()
		return
	}
	state.deleteProject = project
	state.deleteProjectVisible = true
	state.status = "Confirm removal of " + project.Name
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) HideDeleteProject() {
	state.mu.Lock()
	if !state.projectMutationBusy {
		state.deleteProjectVisible = false
	}
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) ConfirmDeleteProject() {
	state.mu.Lock()
	project := state.deleteProject
	if !state.deleteProjectVisible || state.projectMutationBusy {
		state.mu.Unlock()
		return
	}
	if state.hasProject && state.current.ID == project.ID && state.savePending > 0 {
		state.status = "Wait for pending saves before removing this project"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	state.projectMutationBusy = true
	state.status = "Removing " + project.Name
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		var err error
		if project.Managed {
			err = state.services.Files.DeleteProject(context.Background(), project.ID)
		} else {
			err = state.services.Files.ForgetProject(context.Background(), project.ID)
		}
		if err != nil {
			state.mu.Lock()
			state.projectMutationBusy = false
			state.status = "Project removal failed"
			state.appendConsoleLocked(domain.ConsoleError, "project", err.Error())
			state.mu.Unlock()
			ui.Invalidate()
			return
		}
		verb := "Forgot "
		if project.Managed {
			verb = "Deleted "
		}
		state.completeProjectRemoval(project, verb)
	}()
}

func (state *State) completeProjectRemoval(project domain.Project, verb string) {
	state.mu.Lock()
	remaining := make([]domain.Project, 0, len(state.projects) - 1)
	for _, existing := range state.projects {
		if existing.ID != project.ID {
			remaining = append(remaining, existing)
		}
	}
	state.projects = remaining
	wasCurrent := state.hasProject && state.current.ID == project.ID
	previousPreview := ""
	if wasCurrent {
		previousPreview = state.detachCurrentProjectLocked()
	}
	state.projectMutationBusy = false
	state.deleteProjectVisible = false
	state.remoteDeleteBusy = false
	state.remoteDeleteVisible = false
	state.remoteDeleteConfirmation = ""
	state.status = verb + project.Name
	state.appendConsoleLocked(domain.ConsoleSuccess, "project", verb + project.Name)
	state.mu.Unlock()
	if previousPreview != "" {
		_ = state.services.Preview.ClosePreview(context.Background(), previousPreview)
	}
	if wasCurrent && len(remaining) > 0 {
		if err := state.loadProject(context.Background(), remaining[0], true); err != nil {
			state.log(domain.ConsoleError, "project", err.Error())
		}
	}
	ui.Invalidate()
}

func (state *State) CreateProject() {
	state.mu.Lock()
	name := strings.TrimSpace(state.newProjectName)
	if state.projectCreationBusy || state.projectMutationBusy || state.savePending > 0 {
		if state.projectMutationBusy || state.savePending > 0 {
			state.status = "Wait for the current project operation before creating a project"
		}
		state.mu.Unlock()
		return
	}
	nameError := projectNameError(name)
	if nameError != "" {
		state.projectCreatorVisible = true
		state.activity = ActivityExplorer
		state.newProjectError = nameError
		state.newProjectFocusToken++
		state.status = "Enter a project name"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	state.projectCreationBusy = true
	state.projectMutationBusy = true
	state.newProjectError = ""
	state.status = "Creating " + name
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		project, err := state.services.Files.CreateProject(context.Background(), protocol.CreateProjectRequest{
			Name: name, Template: "ui",
		})
		if err != nil {
			state.mu.Lock()
			state.projectCreationBusy = false
			state.projectMutationBusy = false
			state.newProjectError = err.Error()
			state.newProjectFocusToken++
			state.status = "Project creation failed"
			state.appendConsoleLocked(domain.ConsoleError, "project", err.Error())
			state.mu.Unlock()
			ui.Invalidate()
			return
		}
		state.mu.Lock()
		state.projects = append(state.projects, project)
		state.newProjectName = ""
		state.newProjectError = ""
		state.projectCreationBusy = false
		state.projectMutationBusy = false
		state.projectCreatorVisible = false
		state.activity = ActivityExplorer
		state.mu.Unlock()
		state.requestProjectLoad(project)
	}()
}

func (state *State) ToggleProjectCreator() {
	state.mu.Lock()
	if state.projectCreationBusy {
		state.mu.Unlock()
		return
	}
	state.projectCreatorVisible = !state.projectCreatorVisible
	if state.projectCreatorVisible {
		state.activity = ActivityExplorer
		state.newProjectError = projectNameError(state.newProjectName)
		state.newProjectFocusToken++
	} else {
		state.newProjectError = ""
	}
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) SetNewProjectName(value string) {
	state.mu.Lock()
	state.newProjectName = value
	state.newProjectError = projectNameError(value)
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) SetProjectSearchQuery(value string) {
	state.mu.Lock()
	state.projectSearchQuery = value
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) OpenLocalProject() {
	state.mu.Lock()
	canOpen := state.host.CanOpenLocal
	if !canOpen || state.projectMutationBusy || state.projectCreationBusy || state.savePending > 0 {
		if canOpen && (state.projectMutationBusy || state.savePending > 0) {
			state.status = "Wait for the current project operation before opening a folder"
		}
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	state.projectMutationBusy = true
	state.status = "Selecting a project folder"
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		root, selected, err := uisystem.OpenFolder(uisystem.FileDialogOptions{
			Title: "Open Volang project", CanCreateDirectories: false,
		})
		if err != nil {
			state.mu.Lock()
			state.projectMutationBusy = false
			state.mu.Unlock()
			state.log(domain.ConsoleError, "project", err.Error())
			return
		}
		if !selected {
			state.mu.Lock()
			state.projectMutationBusy = false
			state.status = "Folder selection cancelled"
			state.mu.Unlock()
			ui.Invalidate()
			return
		}
		project, err := state.services.Files.OpenProject(context.Background(), root)
		if err != nil {
			state.mu.Lock()
			state.projectMutationBusy = false
			state.mu.Unlock()
			state.log(domain.ConsoleError, "project", err.Error())
			return
		}
		state.mu.Lock()
		present := false
		for _, existing := range state.projects {
			if existing.ID == project.ID {
				present = true
				break
			}
		}
		if !present {
			state.projects = append(state.projects, project)
		}
		state.projectMutationBusy = false
		state.mu.Unlock()
		state.requestProjectLoad(project)
	}()
}

func (state *State) openFile(path string, after func(*editor.Model)) {
	state.mu.Lock()
	project := state.current
	projectGeneration := state.projectGeneration
	hasProject := state.hasProject
	if code, present := state.buffers[path]; present {
		state.openGeneration++
		state.activateBufferLocked(path, code)
		version := code.Document.Version()
		state.mu.Unlock()
		_ = state.layout.Activate("documents", 0)
		state.scheduleAnalysis(version)
		if after != nil {
			after(code)
		}
		ui.Invalidate()
		return
	}
	if len(state.openPaths) >= MaxOpenBuffers {
		state.status = "Open editor limit reached"
		state.mu.Unlock()
		state.log(domain.ConsoleError, "editor", "Close an editor before opening another file")
		return
	}
	state.openGeneration++
	generation := state.openGeneration
	state.mu.Unlock()
	if !hasProject {
		return
	}
	go func() {
		text, err := state.services.Files.ReadFile(context.Background(), project.ID, path)
		if err != nil {
			state.log(domain.ConsoleError, "files", err.Error())
			return
		}
		code := newEditor(project, path, text)
		state.mu.Lock()
		if state.projectGeneration != projectGeneration || state.current.ID != project.ID {
			state.mu.Unlock()
			return
		}
		if existing, present := state.buffers[path]; present {
			code = existing
		} else {
			state.buffers[path] = code
			state.openPaths = append(state.openPaths, path)
			state.savedText[path] = text
		}
		active := generation == state.openGeneration
		if active {
			state.activateBufferLocked(path, code)
		}
		state.mu.Unlock()
		if active {
			_ = state.layout.Activate("documents", 0)
			state.scheduleAnalysis(code.Document.Version())
			if after != nil {
				after(code)
			}
		}
		ui.Invalidate()
	}()
}

func (state *State) OpenFile(path string) {
	state.openFile(path, nil)
}

func (state *State) focusDiagnostic(value domain.Diagnostic, code *editor.Model) {
	line := value.Line - 1
	column := value.Column - 1
	if line < 0 {
		line = 0
	}
	if column < 0 {
		column = 0
	}
	offset, err := code.Document.Offset(document.Position{Line: line, Column: column})
	if err != nil {
		offset, err = code.Document.Offset(document.Position{Line: line, Column: 0})
	}
	if err == nil {
		_ = code.Document.SetSelection(document.Selection{Anchor: offset, Focus: offset})
	}
	viewport := code.Viewport()
	viewport.FirstLine = line - 3
	if viewport.FirstLine < 0 {
		viewport.FirstLine = 0
	}
	_ = code.SetViewport(viewport)
	state.mu.Lock()
	if state.editor == code && state.activePath == value.Path {
		state.editorFocusToken++
	}
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) OpenDiagnostic(value domain.Diagnostic) {
	state.openFile(value.Path, func(code *editor.Model) {
		state.focusDiagnostic(value, code)
	})
}

func (state *State) closeBufferLocked(path string) *editor.Model {
	removedIndex := -1
	nextPaths := make([]string, 0, len(state.openPaths))
	for index, candidate := range state.openPaths {
		if candidate == path {
			removedIndex = index
			continue
		}
		nextPaths = append(nextPaths, candidate)
	}
	if removedIndex < 0 {
		return state.editor
	}
	state.openPaths = nextPaths
	delete(state.buffers, path)
	delete(state.dirty, path)
	delete(state.savedText, path)
	delete(state.diagnosticsByPath, path)
	state.openGeneration++
	if state.activePath != path {
		return nil
	}
	state.activePath = ""
	state.renamePath = ""
	state.editor = nil
	state.diagnostics = nil
	if len(nextPaths) == 0 {
		state.status = "No open editors"
		return nil
	}
	if removedIndex >= len(nextPaths) {
		removedIndex = len(nextPaths) - 1
	}
	nextPath := nextPaths[removedIndex]
	code := state.buffers[nextPath]
	state.activateBufferLocked(nextPath, code)
	return code
}

func (state *State) CloseFile(path string) {
	state.mu.RLock()
	dirty := state.dirty[path]
	code := state.buffers[path]
	projectGeneration := state.projectGeneration
	savePending := state.savePending
	state.mu.RUnlock()
	if code == nil {
		return
	}
	if savePending > 0 {
		state.mu.Lock()
		state.status = "Wait for pending saves before closing an editor"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	if !dirty {
		state.mu.Lock()
		if state.projectGeneration != projectGeneration || state.buffers[path] != code || state.dirty[path] {
			state.mu.Unlock()
			return
		}
		next := state.closeBufferLocked(path)
		state.mu.Unlock()
		if next != nil {
			state.scheduleAnalysis(next.Document.Version())
		}
		ui.Invalidate()
		return
	}
	state.mu.Lock()
	if state.projectGeneration == projectGeneration && state.buffers[path] == code {
		state.closeFilePath = path
		state.closeFileProjectGeneration = projectGeneration
		state.status = "Confirm closing " + path
	}
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) HideCloseFileDialog() {
	state.mu.Lock()
	if state.closeFilePath != "" {
		state.status = "Kept " + state.closeFilePath + " open"
	}
	state.closeFilePath = ""
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) ConfirmCloseFile() {
	state.mu.Lock()
	path := state.closeFilePath
	if path == "" || state.projectGeneration != state.closeFileProjectGeneration ||
		state.buffers[path] == nil {
		state.closeFilePath = ""
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	state.closeFilePath = ""
	next := state.closeBufferLocked(path)
	state.status = "Closed " + path
	state.mu.Unlock()
	if next != nil {
		state.scheduleAnalysis(next.Document.Version())
	}
	ui.Invalidate()
}

func (state *State) CloseActiveFile() {
	state.mu.RLock()
	path := state.activePath
	state.mu.RUnlock()
	if path != "" {
		state.CloseFile(path)
	}
}

type saveSnapshot struct {
	Path string
	Code *editor.Model
	Text string
	Version uint64
}

func (state *State) updateDirtyLocked(path string, code *editor.Model) {
	if code == nil {
		delete(state.dirty, path)
		return
	}
	text, _ := code.Document.Snapshot()
	saved, present := state.savedText[path]
	if !present || text != saved {
		state.dirty[path] = true
		return
	}
	delete(state.dirty, path)
}

func (state *State) saveLoop() {
	for batch := range state.saveQueue {
		for _, snapshot := range batch.Snapshots {
			err := state.services.Files.WriteFile(context.Background(), batch.Project.ID, snapshot.Path, snapshot.Text)
			state.mu.Lock()
			if state.savePending > 0 {
				state.savePending--
			}
			currentProject := state.projectGeneration == batch.ProjectGeneration && state.hasProject &&
				state.current.ID == batch.Project.ID
			if err != nil {
				if currentProject {
					state.status = "Save failed"
				}
				state.appendConsoleLocked(domain.ConsoleError, "save", snapshot.Path + ": " + err.Error())
			} else if currentProject {
				current, present := state.buffers[snapshot.Path]
				if present && current == snapshot.Code {
					state.savedText[snapshot.Path] = snapshot.Text
					state.updateDirtyLocked(snapshot.Path, current)
				}
				state.status = "Saved " + snapshot.Path
			}
			if err == nil {
				state.appendConsoleLocked(domain.ConsoleSuccess, "save", "Saved " + snapshot.Path)
			}
			pendingProject := state.pendingProject
			openPending := state.savePending == 0 && state.hasPendingProject &&
				!state.projectMutationBusy
			if openPending {
				state.pendingProject = domain.Project{}
				state.hasPendingProject = false
			}
			state.mu.Unlock()
			ui.Invalidate()
			if openPending {
				state.requestProjectLoad(pendingProject)
			}
		}
	}
}

func (state *State) saveSnapshots(project domain.Project, projectGeneration uint64, snapshots []saveSnapshot) {
	if len(snapshots) == 0 {
		return
	}
	batch := saveBatch{Project: project, ProjectGeneration: projectGeneration, Snapshots: snapshots}
	state.mu.Lock()
	if state.projectGeneration != projectGeneration || !state.hasProject || state.current.ID != project.ID {
		state.mu.Unlock()
		return
	}
	select {
		case state.saveQueue <- batch:
			state.savePending += len(snapshots)
			state.status = "Saving"
		default:
			state.status = "Save queue is full"
			state.appendConsoleLocked(domain.ConsoleError, "save", "Wait for pending saves before saving again")
	}
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) Save() {
	state.mu.RLock()
	project := state.current
	projectGeneration := state.projectGeneration
	path := state.activePath
	code := state.editor
	dirty := state.dirty[path]
	mutationBusy := state.projectMutationBusy
	state.mu.RUnlock()
	if mutationBusy {
		state.mu.Lock()
		state.status = "Wait for the current project operation before saving"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	if code == nil || path == "" || !dirty {
		return
	}
	text, version := code.Document.Snapshot()
	state.saveSnapshots(project, projectGeneration, []saveSnapshot{{Path: path, Code: code, Text: text, Version: version}})
}

func (state *State) SaveAll() {
	state.mu.RLock()
	project := state.current
	projectGeneration := state.projectGeneration
	mutationBusy := state.projectMutationBusy
	paths := append([]string(nil), state.openPaths...)
	dirty := make(map[string]bool)
	for path, value := range state.dirty {
		dirty[path] = value
	}
	buffers := make(map[string]*editor.Model)
	for path, code := range state.buffers {
		buffers[path] = code
	}
	state.mu.RUnlock()
	if mutationBusy {
		state.mu.Lock()
		state.status = "Wait for the current project operation before saving"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	snapshots := make([]saveSnapshot, 0, len(paths))
	for _, path := range paths {
		code := buffers[path]
		if !dirty[path] || code == nil {
			continue
		}
		text, version := code.Document.Snapshot()
		snapshots = append(snapshots, saveSnapshot{Path: path, Code: code, Text: text, Version: version})
	}
	if len(snapshots) == 0 {
		return
	}
	state.saveSnapshots(project, projectGeneration, snapshots)
}

func (state *State) SetNewFilePath(value string) {
	state.mu.Lock()
	state.newFilePath = value
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) SetRenamePath(value string) {
	state.mu.Lock()
	state.renamePath = value
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) ShowNewFileDialog() {
	state.mu.Lock()
	if !state.hasProject || state.projectMutationBusy || state.savePending > 0 {
		if state.hasProject {
			state.status = "Wait for pending project work before creating a file"
		}
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	state.newFileVisible = true
	state.newFilePath = ""
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) HideNewFileDialog() {
	state.mu.Lock()
	state.newFileVisible = false
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) ShowRenameFileDialog() {
	state.mu.Lock()
	if state.activePath != "" {
		state.renameFileVisible = true
		state.renamePath = state.activePath
	}
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) HideRenameFileDialog() {
	state.mu.Lock()
	state.renameFileVisible = false
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) refreshFiles(ctx context.Context, project domain.Project, projectGeneration uint64) error {
	state.mu.Lock()
	state.filesGeneration++
	filesGeneration := state.filesGeneration
	state.mu.Unlock()
	files, err := state.services.Files.Files(ctx, project.ID)
	if err != nil {
		return err
	}
	state.mu.Lock()
	if state.projectGeneration == projectGeneration && state.current.ID == project.ID &&
		state.filesGeneration == filesGeneration {
		state.files = files
	}
	state.mu.Unlock()
	ui.Invalidate()
	return nil
}

func (state *State) RefreshProject() {
	state.mu.Lock()
	if !state.hasProject {
		state.mu.Unlock()
		return
	}
	project := state.current
	projectGeneration := state.projectGeneration
	state.status = "Refreshing project files"
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		if err := state.refreshFiles(context.Background(), project, projectGeneration); err != nil {
			state.log(domain.ConsoleError, "files", err.Error())
			return
		}
		state.mu.Lock()
		if state.projectGeneration == projectGeneration && state.current.ID == project.ID {
			state.status = "Project files refreshed"
		}
		state.mu.Unlock()
		ui.Invalidate()
	}()
}

func (state *State) CreateFile() {
	state.mu.Lock()
	project := state.current
	projectGeneration := state.projectGeneration
	path := strings.TrimSpace(state.newFilePath)
	if !state.hasProject || state.projectMutationBusy || state.savePending > 0 {
		if state.hasProject && state.savePending > 0 {
			state.status = "Wait for pending saves before creating a file"
		}
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	if !validRelativePath(path) {
		state.status = "Enter a valid project-relative file path"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	state.projectMutationBusy = true
	state.status = "Creating " + path
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		content := ""
		if strings.HasSuffix(path, ".vo") {
			content = "package " + inferredSourcePackage(path) + "\n"
		}
		if err := state.services.Files.CreateFile(context.Background(), project.ID, path, content); err !=
			nil {
			state.mu.Lock()
			state.projectMutationBusy = false
			state.status = "File creation failed"
			state.appendConsoleLocked(domain.ConsoleError, "files", err.Error())
			state.mu.Unlock()
			ui.Invalidate()
			return
		}
		state.mu.Lock()
		if state.projectGeneration != projectGeneration || state.current.ID != project.ID {
			state.projectMutationBusy = false
			state.mu.Unlock()
			return
		}
		state.newFilePath = ""
		state.newFileVisible = false
		state.mu.Unlock()
		if err := state.refreshFiles(context.Background(), project, projectGeneration); err != nil {
			state.mu.Lock()
			state.projectMutationBusy = false
			state.status = "Created file; refresh failed"
			state.appendConsoleLocked(domain.ConsoleError, "files", err.Error())
			state.mu.Unlock()
			ui.Invalidate()
			return
		}
		state.OpenFile(path)
		state.mu.Lock()
		state.projectMutationBusy = false
		state.status = "Created " + path
		state.mu.Unlock()
		ui.Invalidate()
	}()
}

func (state *State) RenameActiveFile() {
	state.mu.RLock()
	project := state.current
	projectGeneration := state.projectGeneration
	from := state.activePath
	to := strings.TrimSpace(state.renamePath)
	savePending := state.savePending
	mutationBusy := state.projectMutationBusy
	state.mu.RUnlock()
	if mutationBusy {
		return
	}
	if savePending > 0 {
		state.mu.Lock()
		state.status = "Wait for pending saves before renaming a file"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	if from == "" || !validRelativePath(to) || from == to {
		if to != "" && relativePathError(to) != "" {
			state.mu.Lock()
			state.status = "Enter a valid project-relative file path"
			state.mu.Unlock()
			ui.Invalidate()
		}
		return
	}
	state.mu.Lock()
	if state.projectMutationBusy || state.projectGeneration != projectGeneration || state.current.ID != project.ID {
		state.mu.Unlock()
		return
	}
	state.projectMutationBusy = true
	state.status = "Renaming " + from
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		if err := state.services.Files.RenameEntry(context.Background(), project.ID, from, to); err != nil {
			state.mu.Lock()
			state.projectMutationBusy = false
			state.status = "File rename failed"
			state.appendConsoleLocked(domain.ConsoleError, "files", err.Error())
			state.mu.Unlock()
			ui.Invalidate()
			return
		}
		state.mu.Lock()
		if state.projectGeneration != projectGeneration || state.current.ID != project.ID {
			state.projectMutationBusy = false
			state.mu.Unlock()
			return
		}
		code := state.buffers[from]
		if code != nil {
			delete(state.buffers, from)
			state.buffers[to] = code
			for index, path := range state.openPaths {
				if path == from {
					state.openPaths[index] = to
				}
			}
			if state.dirty[from] {
				state.dirty[to] = true
			} else {
				delete(state.dirty, to)
			}
			if saved, present := state.savedText[from]; present {
				state.savedText[to] = saved
			}
			state.diagnosticsByPath[to] = state.diagnosticsByPath[from]
		}
		delete(state.dirty, from)
		delete(state.savedText, from)
		delete(state.diagnosticsByPath, from)
		if state.activePath == from {
			state.activePath = to
			state.renamePath = to
			state.diagnostics = nil
		}
		state.renameFileVisible = false
		state.status = "Renamed " + from + " to " + to
		state.mu.Unlock()
		if code != nil {
			if err := code.Rebind("file://" + project.Root + "/" + to, "volang"); err != nil {
				state.log(domain.ConsoleError, "editor", err.Error())
			}
		}
		if err := state.refreshFiles(context.Background(), project, projectGeneration); err != nil {
			state.mu.Lock()
			state.projectMutationBusy = false
			state.status = "Renamed file; refresh failed"
			state.appendConsoleLocked(domain.ConsoleError, "files", err.Error())
			state.mu.Unlock()
			ui.Invalidate()
			return
		}
		if code != nil {
			state.scheduleAnalysis(code.Document.Version())
		} else {
			state.OpenFile(to)
		}
		state.mu.Lock()
		state.projectMutationBusy = false
		state.mu.Unlock()
		ui.Invalidate()
	}()
}

func (state *State) DeleteActiveFile() {
	state.mu.RLock()
	project := state.current
	projectGeneration := state.projectGeneration
	path := state.activePath
	savePending := state.savePending
	mutationBusy := state.projectMutationBusy
	state.mu.RUnlock()
	if path == "" {
		return
	}
	if mutationBusy {
		return
	}
	if savePending > 0 {
		state.mu.Lock()
		state.status = "Wait for pending saves before deleting a file"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	state.mu.Lock()
	if state.projectMutationBusy || state.projectGeneration != projectGeneration || state.current.ID != project.ID {
		state.mu.Unlock()
		return
	}
	state.deleteFilePath = path
	state.deleteFileProject = project
	state.deleteFileProjectGeneration = projectGeneration
	state.status = "Confirm deletion of " + path
	state.mu.Unlock()
	ui.Invalidate()

}

func (state *State) HideDeleteFileDialog() {
	state.mu.Lock()
	if state.deleteFilePath != "" {
		state.status = "Kept " + state.deleteFilePath
	}
	state.deleteFilePath = ""
	state.deleteFileProject = domain.Project{}
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) ConfirmDeleteFile() {
	state.mu.Lock()
	project := state.deleteFileProject
	projectGeneration := state.deleteFileProjectGeneration
	path := state.deleteFilePath
	if path == "" || state.projectMutationBusy ||
		state.projectGeneration != projectGeneration || state.current.ID != project.ID {
		state.deleteFilePath = ""
		state.deleteFileProject = domain.Project{}
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	state.deleteFilePath = ""
	state.deleteFileProject = domain.Project{}
	state.projectMutationBusy = true
	state.status = "Deleting " + path
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		state.mu.RLock()
		current := state.projectGeneration == projectGeneration && state.current.ID == project.ID
		state.mu.RUnlock()
		if !current {
			state.mu.Lock()
			state.projectMutationBusy = false
			state.mu.Unlock()
			return
		}
		if err := state.services.Files.DeleteEntry(context.Background(), project.ID, path); err != nil {
			state.mu.Lock()
			state.projectMutationBusy = false
			state.status = "File deletion failed"
			state.appendConsoleLocked(domain.ConsoleError, "files", err.Error())
			state.mu.Unlock()
			ui.Invalidate()
			return
		}
		state.mu.Lock()
		if state.projectGeneration != projectGeneration || state.current.ID != project.ID {
			state.projectMutationBusy = false
			state.mu.Unlock()
			return
		}
		code := state.closeBufferLocked(path)
		state.status = "Deleted " + path
		state.mu.Unlock()
		if err := state.refreshFiles(context.Background(), project, projectGeneration); err != nil {
			state.mu.Lock()
			state.status = "Deleted file; refresh failed"
			state.appendConsoleLocked(domain.ConsoleError, "files", err.Error())
			state.mu.Unlock()
		}
		if code != nil {
			state.scheduleAnalysis(code.Document.Version())
		}
		state.mu.Lock()
		state.projectMutationBusy = false
		state.mu.Unlock()
		ui.Invalidate()
	}()
}

func toLanguageSeverity(value domain.DiagnosticSeverity) language.Severity {
	if value == domain.DiagnosticError {
		return language.Error
	}
	if value == domain.DiagnosticWarning {
		return language.Warning
	}
	if value == domain.DiagnosticInfo {
		return language.Information
	}
	return language.Hint
}

func toLanguageDiagnostics(values []domain.Diagnostic) []language.Diagnostic {
	result := make([]language.Diagnostic, 0, len(values))
	for _, value := range values {
		line := value.Line - 1
		if line < 0 {
			line = 0
		}
		column := value.Column - 1
		if column < 0 {
			column = 0
		}
		endLine := value.EndLine - 1
		if endLine < line {
			endLine = line
		}
		endColumn := value.EndColumn - 1
		if endColumn < 0 || (endLine == line && endColumn < column) {
			endColumn = column
		}
		result = append(result, language.Diagnostic{
			Range: language.Range{
				Start: language.Position{Line: line, CharacterUTF16: column},
				End: language.Position{Line: endLine, CharacterUTF16: endColumn},
			},
			Severity: toLanguageSeverity(value.Severity), Code: value.Code, Message: value.Message,
			Source: "volang",
		})
	}
	return result
}

func (state *State) scheduleAnalysis(version uint64) {
	state.mu.Lock()
	if state.analysisCancel != nil {
		state.analysisCancel()
	}
	ctx, cancel := context.WithCancel(context.Background())
	state.analysisCancel = cancel
	state.analysisGeneration++
	generation := state.analysisGeneration
	runGeneration := state.runGeneration
	project := state.current
	path := state.activePath
	code := state.editor
	state.status = "Analyzing " + path
	state.mu.Unlock()
	if code == nil {
		cancel()
		return
	}
	text, currentVersion := code.Document.Snapshot()
	if currentVersion != version {
		version = currentVersion
	}
	go func() {
		select {
			case <-ctx.Done():
				return
			case <-time.After(160 * time.Millisecond):
		}
		values, err := state.services.Language.Analyze(ctx, protocol.AnalyzeRequest{
			ProjectID: project.ID, Path: path, Version: version, Text: text,
		})
		if err != nil {
			if ctx.Err() == nil {
				state.mu.Lock()
				if generation == state.analysisGeneration && state.editor == code {
					state.analysisCancel = nil
					state.status = "Analysis failed"
					state.appendConsoleLocked(domain.ConsoleError, "analyzer", err.Error())
				}
				state.mu.Unlock()
				ui.Invalidate()
			}
			return
		}
		state.mu.Lock()
		if generation != state.analysisGeneration || state.editor != code ||
			code.Document.Version() != version {
			state.mu.Unlock()
			return
		}
		state.diagnostics = values
		state.diagnosticsByPath[path] = append([]domain.Diagnostic(nil), values...)
		if state.runGeneration == runGeneration && !state.running {
			state.status = strconv.Itoa(len(values)) + " problems"
		}
		state.analysisCancel = nil
		state.mu.Unlock()
		_ = code.PublishLanguage(version, toLanguageDiagnostics(values), nil)
		ui.Invalidate()
	}()
}

func (state *State) DocumentChanged(edit document.Edit, version uint64) {
	state.mu.Lock()
	path := state.activePath
	code := state.editor
	if path != "" && code != nil {
		state.updateDirtyLocked(path, code)
		if state.dirty[path] {
			state.status = "Modified " + path
		} else {
			state.status = "Reverted " + path
		}
		if state.previewState == domain.PreviewReady && state.previewSurface != "" {
			state.previewStale = true
		}
	}
	state.mu.Unlock()
	state.scheduleAnalysis(version)
}

func (state *State) changeHistory(redo bool) {
	state.mu.RLock()
	path := state.activePath
	code := state.editor
	state.mu.RUnlock()
	if code == nil || path == "" {
		return
	}
	changed := false
	label := "Undo"
	if redo {
		changed = code.Document.Redo()
		label = "Redo"
	} else {
		changed = code.Document.Undo()
	}
	if !changed {
		return
	}
	version := code.Document.Version()
	state.mu.Lock()
	current, present := state.buffers[path]
	if present && current == code {
		state.updateDirtyLocked(path, code)
		state.status = label + " " + path
		if state.previewState == domain.PreviewReady && state.previewSurface != "" {
			state.previewStale = true
		}
	}
	active := state.editor == code && state.activePath == path
	state.mu.Unlock()
	if active {
		state.scheduleAnalysis(version)
	}
	ui.Invalidate()
}

func (state *State) Undo() {
	state.changeHistory(false)
}

func (state *State) Redo() {
	state.changeHistory(true)
}

func (state *State) StartRun(mode domain.RuntimeMode, preview bool) {
	state.mu.Lock()
	if state.projectMutationBusy {
		state.status = "Wait for the current project operation before running"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	if !supportsRuntimeMode(state.host, mode) {
		state.status = mode.String() + " is unavailable on " + state.host.Platform
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	if !state.hasProject || state.activePath == "" || state.editor == nil {
		state.status = "Open a source file to run"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	if state.runCancel != nil {
		state.runCancel()
	}
	ctx, cancel := context.WithCancel(context.Background())
	state.runCancel = cancel
	state.runGeneration++
	generation := state.runGeneration
	state.running = true
	state.runMode = mode
	state.runPreview = preview
	state.status = "Building"
	if preview {
		state.previewState = domain.PreviewBuilding
		state.previewError = ""
	}
	project := state.current
	path := state.activePath
	overlays := make([]protocol.FileOverlay, 0, len(state.openPaths))
	for _, openPath := range state.openPaths {
		code := state.buffers[openPath]
		if code == nil || !state.dirty[openPath] {
			continue
		}
		text, version := code.Document.Snapshot()
		overlays = append(overlays, protocol.FileOverlay{Path: openPath, Text: text, Version: version})
	}
	state.appendConsoleLocked(domain.ConsoleInfo, "runner", "Building " + path + " for " +
		mode.String())
	state.mu.Unlock()
	ui.Invalidate()
	go state.execute(ctx, generation, project, path, overlays, mode, preview)
}

func (state *State) failRun(generation uint64, preview bool, source string, err error) {
	state.mu.Lock()
	if generation != state.runGeneration {
		state.mu.Unlock()
		return
	}
	state.running = false
	state.runPreview = false
	state.status = err.Error()
	if preview {
		state.previewError = err.Error()
		if state.previewSurface != "" {
			state.previewState = domain.PreviewReady
			state.previewStale = true
		} else {
			state.previewState = domain.PreviewFailed
		}
	}
	state.runCancel = nil
	state.appendConsoleLocked(domain.ConsoleError, source, err.Error())
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) execute(ctx context.Context, generation uint64, project domain.Project, path string, overlays []protocol.FileOverlay, mode domain.RuntimeMode, preview bool) {
	artifact, err := state.services.Compiler.Compile(ctx, protocol.CompileRequest{
		ProjectID: project.ID, Entry: path, Mode: mode, ForPreview: preview, Overlays: overlays,
	})
	if err != nil {
		if ctx.Err() == nil {
			state.failRun(generation, preview, "compiler", err)
		}
		return
	}
	surface := ""
	if preview {
		var openErr error
		surface, openErr = state.services.Preview.OpenPreview(ctx, artifact)
		if openErr != nil {
			if ctx.Err() == nil {
				state.failRun(generation, true, "preview", openErr)
			}
			return
		}
	}
	events, err := state.services.Runner.Run(ctx, protocol.RunRequest{
		ProjectID: project.ID, Artifact: artifact, Mode: mode,
	})
	if err != nil {
		if surface != "" {
			_ = state.services.Preview.ClosePreview(context.Background(), surface)
		}
		if ctx.Err() == nil {
			state.failRun(generation, preview, "runner", err)
		}
		return
	}
	if preview {
		state.mu.Lock()
		previousPreview := ""
		acceptedPreview := false
		if generation == state.runGeneration {
			previousPreview = state.previewSurface
			state.previewSurface = surface
			state.previewState = domain.PreviewReady
			state.previewStale = false
			state.previewError = ""
			acceptedPreview = true
		}
		state.mu.Unlock()
		if !acceptedPreview {
			_ = state.services.Preview.ClosePreview(context.Background(), surface)
			return
		}
		if previousPreview != "" && previousPreview != surface {
			_ = state.services.Preview.ClosePreview(context.Background(), previousPreview)
		}
		ui.Invalidate()
	}
	finished := false
	for event := range events {
		state.mu.Lock()
		if generation != state.runGeneration {
			state.mu.Unlock()
			return
		}
		level := domain.ConsoleInfo
		if event.Kind == domain.RunStderr || event.Kind == domain.RunDiagnostic {
			level = domain.ConsoleError
		}
		if event.Kind == domain.RunFinished && event.ExitCode == 0 {
			level = domain.ConsoleSuccess
		}
		state.appendConsoleLocked(level, "run", event.Text)
		if event.Kind == domain.RunFinished {
			finished = true
			state.running = false
			state.runPreview = false
			state.runCancel = nil
			if preview && event.ExitCode == 0 {
				state.status = "Preview ready"
			} else if event.ExitCode == 0 {
				state.status = "Run finished"
			} else {
				state.status = "Run failed"
				if preview {
					state.previewError = event.Text
					state.previewStale = true
				}
			}
			if event.Duration > 0 {
				state.appendConsoleLocked(domain.ConsoleInfo, "runner", "Duration " + event.Duration.String())
			}
		}
		state.mu.Unlock()
		ui.Invalidate()
	}
	state.mu.Lock()
	if generation == state.runGeneration && !finished && ctx.Err() == nil {
		state.running = false
		state.runPreview = false
		state.runCancel = nil
		state.status = "Run ended without a completion event"
		state.appendConsoleLocked(domain.ConsoleWarning, "runner", "Run stream ended without a completion event")
	}
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) StopRun() {
	state.mu.Lock()
	if state.runCancel != nil {
		state.runCancel()
		state.runCancel = nil
	}
	state.runGeneration++
	wasPreview := state.runPreview
	state.running = false
	state.runPreview = false
	if wasPreview && state.previewState == domain.PreviewBuilding {
		if state.previewSurface != "" {
			state.previewState = domain.PreviewReady
			state.previewStale = true
		} else {
			state.previewState = domain.PreviewIdle
		}
	}
	state.status = "Stopped"
	state.appendConsoleLocked(domain.ConsoleWarning, "runner", "Run cancelled")
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) SetActivity(activity Activity) {
	state.mu.Lock()
	state.activity = activity
	if !state.running {
		if activity == ActivityExplorer {
			state.status = "Explorer"
		} else if activity == ActivitySearch {
			state.status = "Search workspace"
		} else if activity == ActivitySourceControl {
			state.status = "Source Control"
		} else if activity == ActivityDocs {
			state.status = "Documentation"
		} else {
			state.status = "Ready"
		}
	}
	canSync := state.host.CanSyncRemote
	state.mu.Unlock()
	if activity != ActivityDocs {
		ui.Navigate(workspaceActivityPath(activity))
	}
	if activity == ActivitySourceControl && canSync {
		state.RefreshRemote()
	}
	ui.Invalidate()
}

func (state *State) RefreshRemote() {
	state.mu.Lock()
	if !state.hasProject || state.remoteLoading {
		state.mu.Unlock()
		return
	}
	project := state.current
	projectGeneration := state.projectGeneration
	state.remoteLoading = true
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		remote, err := state.services.Remote.State(context.Background(), project.ID)
		state.mu.Lock()
		if state.projectGeneration != projectGeneration || state.current.ID != project.ID {
			state.mu.Unlock()
			return
		}
		state.remoteLoading = false
		if err == nil {
			state.remote = remote
			state.remoteLoaded = true
		}
		state.mu.Unlock()
		if err != nil {
			state.log(domain.ConsoleError, "git", err.Error())
		} else {
			ui.Invalidate()
		}
	}()
}

func (state *State) SetCommitMessage(value string) {
	state.mu.Lock()
	state.commitMessage = value
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) PullRemote() {
	state.startRemoteOperation("Pull", func(ctx context.Context, id domain.ProjectID, progress func(string)) error {
		return state.services.Remote.Pull(ctx, id, progress)
	})
}

func (state *State) PushRemote() {
	state.mu.RLock()
	message := state.commitMessage
	state.mu.RUnlock()
	state.startRemoteOperation("Commit & Push", func(ctx context.Context, id domain.ProjectID, progress func(string)) error {
		return state.services.Remote.Push(ctx, id, message, progress)
	})
}

func (state *State) startRemoteOperation(label string, action func(context.Context, domain.ProjectID, func(string)) error) {
	state.mu.Lock()
	if !state.hasProject || state.remoteBusy || state.projectMutationBusy {
		state.mu.Unlock()
		return
	}
	if state.hasDirtyLocked() || state.savePending > 0 {
		state.status = "Save all editor changes before source control operations"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	ctx, cancel := context.WithCancel(context.Background())
	state.remoteBusy = true
	state.remoteCancel = cancel
	state.remoteGeneration++
	generation := state.remoteGeneration
	project := state.current
	state.status = label + " in progress"
	state.appendConsoleLocked(domain.ConsoleInfo, "git", label + " started")
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		progress := func(message string) {
			state.mu.Lock()
			if generation == state.remoteGeneration && state.current.ID == project.ID && ctx.Err() == nil {
				state.status = label + ": " + message
				state.appendConsoleLocked(domain.ConsoleInfo, "git", message)
			}
			state.mu.Unlock()
			ui.Invalidate()
		}
		err := action(ctx, project.ID, progress)
		state.mu.Lock()
		if generation != state.remoteGeneration || state.current.ID != project.ID {
			state.mu.Unlock()
			return
		}
		state.remoteBusy = false
		state.remoteCancel = nil
		if err != nil {
			state.status = label + " failed"
			state.appendConsoleLocked(domain.ConsoleError, "git", err.Error())
		} else {
			state.status = label + " complete"
			state.appendConsoleLocked(domain.ConsoleSuccess, "git", label + " complete")
		}
		state.mu.Unlock()
		ui.Invalidate()
		if err == nil {
			state.RefreshRemote()
		}
	}()
}

func (state *State) CancelRemote() {
	state.mu.Lock()
	if state.remoteCancel != nil {
		state.remoteCancel()
		state.remoteCancel = nil
	}
	state.remoteGeneration++
	state.remoteBusy = false
	state.status = "Source control operation cancelled"
	state.appendConsoleLocked(domain.ConsoleWarning, "git", "Operation cancelled")
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) ShowRemoteDelete() {
	state.mu.Lock()
	if !state.hasProject || state.remote.DeleteTarget == "" || state.remoteBusy ||
		state.remoteDeleteBusy || state.projectMutationBusy {
		state.mu.Unlock()
		return
	}
	state.remoteDeleteVisible = true
	state.remoteDeleteConfirmation = ""
	state.status = "Confirm cloud repository deletion"
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) SetRemoteDeleteConfirmation(value string) {
	state.mu.Lock()
	state.remoteDeleteConfirmation = value
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) HideRemoteDelete() {
	state.mu.Lock()
	if !state.remoteDeleteBusy {
		state.remoteDeleteVisible = false
		state.remoteDeleteConfirmation = ""
	}
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) DeleteRemote(deleteLocal bool) {
	state.mu.Lock()
	project := state.current
	projectGeneration := state.projectGeneration
	target := state.remote.DeleteTarget
	confirmation := strings.TrimSpace(state.remoteDeleteConfirmation)
	if !state.remoteDeleteVisible || state.remoteDeleteBusy || target == "" || confirmation != target ||
		(deleteLocal && state.projectMutationBusy) {
		state.mu.Unlock()
		return
	}
	if deleteLocal && state.savePending > 0 {
		state.status = "Wait for pending saves before deleting the local project"
		state.mu.Unlock()
		ui.Invalidate()
		return
	}
	state.remoteDeleteBusy = true
	if deleteLocal {
		state.projectMutationBusy = true
	}
	state.status = "Deleting " + target
	state.appendConsoleLocked(domain.ConsoleWarning, "github", "Deleting cloud repository " + target)
	state.mu.Unlock()
	ui.Invalidate()
	go func() {
		if err := state.services.Remote.DeleteRepository(context.Background(), project.ID, target); err !=
			nil {
			state.mu.Lock()
			if state.projectGeneration != projectGeneration || state.current.ID != project.ID {
				if deleteLocal {
					state.projectMutationBusy = false
				}
				state.appendConsoleLocked(domain.ConsoleError, "github", err.Error())
				state.mu.Unlock()
				ui.Invalidate()
				return
			}
			state.remoteDeleteBusy = false
			if deleteLocal {
				state.projectMutationBusy = false
			}
			state.status = "Cloud repository deletion failed"
			state.appendConsoleLocked(domain.ConsoleError, "github", err.Error())
			state.mu.Unlock()
			ui.Invalidate()
			return
		}
		if deleteLocal {
			var err error
			if project.Managed {
				err = state.services.Files.DeleteProject(context.Background(), project.ID)
			} else {
				err = state.services.Files.ForgetProject(context.Background(), project.ID)
			}
			if err != nil {
				state.mu.Lock()
				if state.projectGeneration != projectGeneration || state.current.ID != project.ID {
					state.projectMutationBusy = false
					state.appendConsoleLocked(domain.ConsoleError, "project", err.Error())
					state.mu.Unlock()
					ui.Invalidate()
					return
				}
				state.remoteDeleteBusy = false
				state.projectMutationBusy = false
				state.remoteDeleteVisible = false
				state.remoteDeleteConfirmation = ""
				state.remote = domain.RemoteState{}
				state.status = "Cloud deleted; local removal failed"
				state.appendConsoleLocked(domain.ConsoleError, "project", err.Error())
				state.mu.Unlock()
				ui.Invalidate()
				return
			}
			verb := "Deleted cloud repository and forgot "
			if project.Managed {
				verb = "Deleted cloud repository and local project "
			}
			state.completeProjectRemoval(project, verb)
			return
		}
		state.mu.Lock()
		if state.projectGeneration == projectGeneration && state.current.ID == project.ID {
			state.remote = domain.RemoteState{}
			state.remoteLoaded = true
		} else {
			state.mu.Unlock()
			return
		}
		state.remoteDeleteBusy = false
		state.remoteDeleteVisible = false
		state.remoteDeleteConfirmation = ""
		state.status = "Deleted cloud repository " + target
		state.appendConsoleLocked(domain.ConsoleSuccess, "github", "Deleted cloud repository " + target +
			"; local files were kept")
		state.mu.Unlock()
		ui.Invalidate()
	}()
}

func (state *State) OpenRemoteDiff(path string) {
	state.mu.Lock()
	if !state.hasProject || state.remoteDiffLoading {
		state.mu.Unlock()
		return
	}
	project := state.current
	projectGeneration := state.projectGeneration
	state.remoteDiffLoading = true
	state.remoteDiff = domain.RemoteDiff{Path: path}
	state.status = "Loading changes for " + path
	state.mu.Unlock()
	_ = state.layout.Activate("bottom", 3)
	ui.Invalidate()
	go func() {
		diff, err := state.services.Remote.Diff(context.Background(), project.ID, path)
		state.mu.Lock()
		if state.projectGeneration != projectGeneration || state.current.ID != project.ID {
			state.mu.Unlock()
			return
		}
		state.remoteDiffLoading = false
		if err != nil {
			state.status = "Diff failed"
			state.appendConsoleLocked(domain.ConsoleError, "git", err.Error())
		} else {
			state.remoteDiff = diff
			state.status = "Changes · " + path
		}
		state.mu.Unlock()
		ui.Invalidate()
	}()
}

func documentationPages() []domain.DocPage {
	return documentation.Pages()
}

func documentationPage(id string) (domain.DocPage, bool) {
	for _, page := range documentationPages() {
		if page.ID == id {
			return page, true
		}
	}
	return domain.DocPage{}, false
}

func documentationMatches(page domain.DocPage, query string) bool {
	normalized := strings.ToLower(strings.TrimSpace(query))
	if normalized == "" {
		return true
	}
	haystack := strings.ToLower(page.Title + " " + page.Section + " " + page.Summary + " " +
		page.SourcePath +
		" " +
		page.Markdown)
	for _, token := range strings.Fields(normalized) {
		if !strings.Contains(haystack, token) {
			return false
		}
	}
	return true
}

func (state *State) SetDocQuery(value string) {
	state.mu.Lock()
	state.docQuery = value
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) expandDocPageLocked(id string) {
	page, ok := documentationPage(id)
	if ok {
		state.docExpanded[page.SectionID] = true
	}
}

func (state *State) ToggleDocSection(key string) {
	if !strings.HasPrefix(key, "section/") {
		return
	}
	id := strings.TrimPrefix(key, "section/")
	state.mu.Lock()
	state.docExpanded[id] = !state.docExpanded[id]
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) SelectDocTreeItem(key string) {
	if strings.HasPrefix(key, "page/") {
		state.OpenDoc(strings.TrimPrefix(key, "page/"))
	}
}

func (state *State) OpenDoc(id string) {
	for _, page := range documentationPages() {
		if page.ID == id {
			state.mu.Lock()
			state.docPageID = id
			state.expandDocPageLocked(id)
			state.docHeadingID = ""
			state.activity = ActivityDocs
			state.status = "Documentation · " + page.Title
			state.mu.Unlock()
			_ = state.layout.Activate("documents", 1)
			ui.Navigate("/docs/" + id)
			ui.Invalidate()
			return
		}
	}
}

func (state *State) OpenDocHeading(pageID string, headingID string) {
	if headingID == "" {
		return
	}
	state.mu.Lock()
	state.docPageID = pageID
	state.expandDocPageLocked(pageID)
	state.docHeadingID = headingID
	state.docFocusToken++
	state.activity = ActivityDocs
	state.mu.Unlock()
	ui.Navigate("/docs/" + pageID + "#" + headingID)
	ui.Invalidate()
}

func (state *State) ShowDocs() {
	state.mu.Lock()
	state.activity = ActivityDocs
	if state.docPageID == "" {
		state.docPageID = "introduction"
	}
	id := state.docPageID
	state.expandDocPageLocked(id)
	state.status = "Documentation"
	state.mu.Unlock()
	_ = state.layout.Activate("documents", 1)
	ui.Navigate("/docs/" + id)
	ui.Invalidate()
}

func (state *State) ShowPreview() {
	_ = state.layout.Activate("bottom", 1)
	ui.Invalidate()
}

func (state *State) ShowFind() {
	state.mu.Lock()
	state.findVisible = true
	state.status = "Find in file"
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) HideFind() {
	state.mu.Lock()
	state.findVisible = false
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) SetFindQuery(value string) {
	state.mu.Lock()
	state.findQuery = value
	code := state.editor
	state.mu.Unlock()
	if code != nil {
		_ = code.Document.SetSelection(document.Selection{})
	}
	state.FindNext()
}

func findRuneOffset(text string, query string, start int, forward bool) int {
	runes := []rune(text)
	if len(runes) == 0 || query == "" {
		return -1
	}
	if start < 0 {
		start = 0
	}
	if start > len(runes) {
		start = len(runes)
	}
	if forward {
		tail := string(runes[start:])
		byteIndex := strings.Index(tail, query)
		if byteIndex >= 0 {
			return start + len([]rune(tail[:byteIndex]))
		}
		byteIndex = strings.Index(text, query)
		if byteIndex >= 0 {
			return len([]rune(text[:byteIndex]))
		}
		return -1
	}
	head := string(runes[:start])
	byteIndex := strings.LastIndex(head, query)
	if byteIndex >= 0 {
		return len([]rune(head[:byteIndex]))
	}
	byteIndex = strings.LastIndex(text, query)
	if byteIndex >= 0 {
		return len([]rune(text[:byteIndex]))
	}
	return -1
}

func (state *State) selectFind(forward bool) {
	state.mu.RLock()
	query := state.findQuery
	code := state.editor
	state.mu.RUnlock()
	if code == nil || query == "" {
		return
	}
	selection := code.Document.Selection()
	start := selection.End()
	if !forward {
		start = selection.Start()
	}
	index := findRuneOffset(code.Document.Text(), query, start, forward)
	state.mu.Lock()
	if index < 0 {
		state.status = "No matches for " + query
	} else {
		if err := code.Document.SetSelection(document.Selection{
			Anchor: index, Focus: index + len([]rune(query)),
		}); err != nil {
			state.mu.Unlock()
			state.ReportFailure("find", err)
			return
		}
		state.status = "Found " + query
	}
	state.mu.Unlock()
	ui.Invalidate()
}

func (state *State) FindNext() {
	state.selectFind(true)
}

func (state *State) FindPrevious() {
	state.selectFind(false)
}

