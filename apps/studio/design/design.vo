// Package design owns Studio's visual language. Product components consume
// semantic recipes instead of scattering renderer properties across features.
package design

import (
	"github.com/vo-lang/ui"
	kitcomponents "github.com/vo-lang/ui/kit/components"
	"github.com/vo-lang/ui/kit/icons"
	kittokens "github.com/vo-lang/ui/kit/tokens"
)

const (
	Canvas uint32 = 0xff070a10
	SurfaceSunken uint32 = 0xff0a0f18
	Surface uint32 = 0xff0e1420
	SurfaceRaised uint32 = 0xff151d2b
	SurfaceHover uint32 = 0xff1d2940
	Divider uint32 = 0xff29364b
	DividerStrong uint32 = 0xff394862
	TextPrimary uint32 = 0xfff2f5fb
	TextSecondary uint32 = 0xffaab5c8
	TextMuted uint32 = 0xff748198
	Accent uint32 = 0xff91a2ff
	AccentStrong uint32 = 0xff637eff
	AccentHover uint32 = 0xff7690ff
	AccentPressed uint32 = 0xff536fe6
	AccentSoft uint32 = 0xff222e5c
	Success uint32 = 0xff55d39a
	Warning uint32 = 0xffffc96b
	Danger uint32 = 0xffff7185
	DangerHover uint32 = 0xffff8798
	DangerPressed uint32 = 0xffe85d72
	SurfacePressed uint32 = 0xff253249
)

const (
	Space1 float64 = 4
	Space2 float64 = 8
	Space3 float64 = 12
	Space4 float64 = 16
	Space5 float64 = 24
	Space6 float64 = 32
	Space7 float64 = 40
	Space8 float64 = 48
)

// StudioTheme layers Studio's visual language on the official UIKit contract.
// Generic controls stay owned by UIKit while this package owns product-level
// compositions such as project cards, editor tabs, and the activity rail.
func StudioTheme() kittokens.Theme {
	theme := kittokens.ThemeFor(true, false)
	theme.Colors.Canvas = Canvas
	theme.Colors.Surface = Surface
	theme.Colors.SurfaceRaised = SurfaceRaised
	theme.Colors.Text = TextPrimary
	theme.Colors.TextMuted = TextSecondary
	theme.Colors.Accent = AccentStrong
	theme.Colors.OnAccent = TextPrimary
	theme.Colors.Danger = Danger
	theme.Colors.Success = Success
	theme.Colors.Warning = Warning
	theme.Colors.Border = Divider
	theme.Colors.Focus = Accent
	theme.Colors.SurfaceHover = SurfaceHover
	theme.Colors.SurfacePressed = SurfacePressed
	theme.Colors.AccentHover = AccentHover
	theme.Colors.AccentPressed = AccentPressed
	theme.Colors.DangerHover = DangerHover
	theme.Colors.DangerPressed = DangerPressed
	theme.Background = Canvas
	theme.Surface = Surface
	theme.Foreground = TextPrimary
	theme.MutedForeground = TextSecondary
	theme.Accent = AccentStrong
	theme.AccentForeground = TextPrimary
	theme.Danger = Danger
	theme.Radius = 8
	theme.Space = Space2
	theme.ControlHeight = 36
	theme.Spacing.Step = Space2
	theme.Spacing.ControlGap = Space2
	theme.Spacing.ContentGap = Space3
	theme.Spacing.SectionGap = Space5
	theme.Shape.SmallRadius = 6
	theme.Shape.MediumRadius = 8
	theme.Shape.LargeRadius = 12
	return theme
}

func framed(view ui.View, fill uint32, border uint32, radius float64) ui.View {
	view = ui.Background(view, fill)
	view = ui.BorderColor(view, border)
	view = ui.BorderWidth(view, 1)
	return ui.Radius(view, radius)
}

func AppSurface(view ui.View) ui.View {
	view = ui.Background(view, Canvas)
	view = ui.Foreground(view, TextPrimary)
	return view
}

func Panel(view ui.View) ui.View {
	view = ui.Background(view, Surface)
	view = ui.Foreground(view, TextPrimary)
	return ui.Overflow(view, ui.OverflowHidden)
}

func PanelHeader(title string, action ui.View) ui.View {
	label := ui.FontSize(ui.FontWeight(ui.Foreground(ui.Text(title), TextSecondary), 680), 11)
	header := ui.Row(label, ui.Flex(ui.Box(), 1), action)
	header = ui.Align(header, ui.AlignCenter)
	header = ui.MinHeight(ui.Padding(header, Space2), 42)
	header = ui.Background(header, SurfaceRaised)
	separator := ui.Height(ui.Background(ui.Box(), Divider), 1)
	return ui.Column(header, separator)
}

func TopBar(view ui.View) ui.View {
	view = ui.MinHeight(ui.Padding(view, Space2), 54)
	view = ui.Background(view, Surface)
	separator := ui.Height(ui.Background(ui.Box(), Divider), 1)
	return ui.Elevation(ui.Column(view, separator), 1)
}

func PrimaryButton(label string, action func()) ui.View {
	return kitcomponents.Button(StudioTheme(), label, kittokens.ButtonPrimary, kittokens.ControlMedium, false, action)
}

func QuietButton(label string, action func()) ui.View {
	return kitcomponents.Button(StudioTheme(), label, kittokens.ButtonQuiet, kittokens.ControlMedium, false, action)
}

func DangerButton(label string, action func()) ui.View {
	return kitcomponents.Button(StudioTheme(), label, kittokens.ButtonDanger, kittokens.ControlMedium, false, action)
}

func NavigationButton(label string, selected bool, action func()) ui.View {
	button := kitcomponents.Button(StudioTheme(), label, kittokens.ButtonQuiet, kittokens.ControlMedium, false, action)
	button = ui.Selected(button, selected)
	if selected {
		button = ui.Foreground(button, TextPrimary)
		button = ui.Background(button, SurfaceHover)
		button = ui.BorderColor(button, DividerStrong)
	}
	button = ui.HoverBackground(button, SurfaceHover)
	button = ui.PressedBackground(button, SurfacePressed)
	button = ui.FocusRing(button, Accent)
	return button
}

// SidebarItem is a dense, borderless navigation row for project and file
// trees. Commands and forms retain a control silhouette while persistent
// navigation uses quiet hierarchy and a strong current-row signal.
func SidebarItem(label string, selected bool, action func()) ui.View {
	foreground := TextSecondary
	background := Surface
	if selected {
		foreground = TextPrimary
		background = SurfaceHover
	}
	button := ui.Button(label, ui.Action(action))
	button = ui.Selected(button, selected)
	button = ui.MinHeight(ui.Padding(button, 9), 34)
	button = ui.FontSize(ui.FontWeight(ui.Foreground(button, foreground), 580), 12)
	button = ui.Background(button, background)
	button = ui.HoverBackground(button, SurfaceHover)
	button = ui.PressedBackground(button, SurfacePressed)
	button = ui.FocusRing(button, Accent)
	button = ui.BorderWidth(button, 0)
	button = ui.Radius(button, 7)
	return button
}

func DocumentTab(label string, path string, selected bool, activate func(), close func()) ui.View {
	tab := ui.Button(label, ui.Action(activate))
	tab = ui.Role(tab, "tab")
	tab = ui.Selected(tab, selected)
	tab = ui.AccessibleName(tab, "Open editor " + path)
	fill := Surface
	if selected {
		fill = SurfaceRaised
	}
	tab = ui.Foreground(tab, TextSecondary)
	tab = ui.FontSize(ui.FontWeight(tab, 600), 12)
	tab = ui.Background(tab, fill)
	tab = ui.HoverBackground(tab, SurfaceHover)
	tab = ui.PressedBackground(tab, SurfacePressed)
	tab = ui.FocusRing(tab, Accent)
	tab = ui.BorderWidth(tab, 0)
	if selected {
		tab = ui.Foreground(tab, TextPrimary)
	}
	tab = ui.Padding(tab, Space2)
	closeButton := ui.Button("×", ui.Action(close))
	closeButton = ui.AccessibleName(closeButton, "Close editor " + path)
	closeButton = ui.Foreground(closeButton, TextMuted)
	closeButton = ui.Background(closeButton, fill)
	closeButton = ui.HoverBackground(closeButton, SurfaceHover)
	closeButton = ui.PressedBackground(closeButton, SurfacePressed)
	closeButton = ui.FocusRing(closeButton, Accent)
	closeButton = ui.BorderWidth(closeButton, 0)
	closeButton = ui.Radius(closeButton, 6)
	closeButton = ui.Padding(closeButton, Space2)
	view := ui.Row(tab, closeButton)
	view = ui.Align(view, ui.AlignCenter)
	view = ui.Background(view, fill)
	indicatorColor := fill
	if selected {
		indicatorColor = AccentStrong
	}
	indicator := ui.Height(ui.Background(ui.Box(), indicatorColor), 2)
	return ui.Column(view, indicator)
}

func BrandMark() ui.View {
	mark := ui.FontSize(ui.FontWeight(ui.Foreground(ui.Text("V"), TextPrimary), 820), 16)
	mark = ui.Justify(ui.Align(ui.Height(ui.Width(mark, 38), 38), ui.AlignCenter), ui.JustifyCenter)
	return framed(mark, AccentSoft, AccentStrong, 11)
}

func BrandLockup() ui.View {
	name := ui.FontSize(ui.FontWeight(ui.Text("Studio"), 760), 14)
	detail := ui.FontSize(ui.FontWeight(ui.Foreground(ui.Text("VOLANG"), TextMuted), 700), 9)
	return ui.Align(ui.Gap(ui.Row(BrandMark(), ui.Column(name, detail)), Space2), ui.AlignCenter)
}

func ActivityButton(glyph icons.Glyph, name string, label string, selected bool, action func()) ui.View {
	color := TextMuted
	fill := Canvas
	indicatorColor := Canvas
	if selected {
		color = Accent
		fill = SurfaceHover
		indicatorColor = AccentStrong
	}
	icon := icons.Icon(glyph, 20, color, name)
	visual := ui.Justify(ui.Align(ui.Height(ui.Width(ui.Row(icon), 42), 42), ui.AlignCenter), ui.JustifyCenter)
	visual = ui.Radius(ui.Background(visual, fill), 10)
	button := ui.AccessibleName(ui.Button(" ", ui.Action(action)), name)
	button = ui.AccessibleDescription(button, label)
	button = ui.Selected(button, selected)
	button = ui.Height(ui.Width(button, 42), 42)
	button = ui.Background(button, 0x00000000)
	button = ui.HoverBackground(button, 0x551d2940)
	button = ui.PressedBackground(button, 0x88253249)
	button = ui.FocusRing(button, Accent)
	button = ui.BorderWidth(button, 0)
	button = ui.Radius(button, 10)
	control := ui.Height(ui.Width(ui.Stack(visual, button), 42), 42)
	indicator := ui.Height(ui.Width(ui.Radius(ui.Background(ui.Box(), indicatorColor), 2), 3), 28)
	return ui.Align(ui.Gap(ui.Row(indicator, control), Space1), ui.AlignCenter)
}

func Muted(value string) ui.View {
	return ui.Foreground(ui.Text(value), TextMuted)
}

func Badge(value string, color uint32) ui.View {
	badge := ui.FontSize(ui.FontWeight(ui.Text(value), 720), 10)
	badge = ui.Foreground(badge, color)
	badge = ui.Background(badge, SurfaceRaised)
	badge = ui.Padding(badge, 6)
	badge = ui.Radius(badge, 6)
	return ui.Row(badge, ui.Flex(ui.Box(), 1))
}

func StatusPill(value string, color uint32) ui.View {
	dot := ui.Width(ui.Height(ui.Radius(ui.Background(ui.Box(), color), 4), 8), 8)
	label := ui.FontSize(ui.FontWeight(ui.Foreground(ui.Text(value), TextSecondary), 600), 11)
	content := ui.Align(ui.Gap(ui.Row(dot, label), Space2), ui.AlignCenter)
	return ui.Role(framed(ui.Padding(content, 7), SurfaceRaised, Divider, 8), "status")
}

func SectionHeading(kicker string, title string, detail string, action ui.View) ui.View {
	copy := ui.Gap(ui.Column(ui.FontSize(ui.FontWeight(ui.Foreground(ui.Text(kicker), Accent), 740), 10), ui.FontSize(ui.FontWeight(ui.Text(title), 760), 25), ui.Foreground(ui.Text(detail), TextSecondary)), Space1)
	if ui.CurrentEnvironment().ViewportWidth < 600 {
		return ui.Gap(ui.Column(copy, action), Space3)
	}
	return ui.Align(ui.Row(ui.Flex(copy, 1), action), ui.AlignCenter)
}

func Hero(view ui.View) ui.View {
	view = ui.Padding(view, Space6)
	return framed(view, Surface, DividerStrong, 18)
}

// DashboardPanel is the compact workbench surface used by Studio's start page.
// It keeps hierarchy and spacing consistent without pulling product copy into
// the generic UIKit layer.
func DashboardPanel(kicker string, title string, detail string, content ui.View) ui.View {
	heading := ui.Gap(ui.Column(ui.FontSize(ui.FontWeight(ui.Foreground(ui.Text(kicker), Accent), 740), 10), ui.FontSize(ui.FontWeight(ui.Text(title), 740), 17), ui.FontSize(ui.Foreground(ui.Text(detail), TextSecondary), 12)), Space1)
	body := ui.Gap(ui.Column(heading, content), Space4)
	body = ui.MinHeight(ui.Padding(body, Space4), 184)
	return ui.Elevation(framed(body, Surface, Divider, 12), 1)
}

func CapabilityRow(label string, value string, color uint32) ui.View {
	dot := ui.Height(ui.Width(ui.Radius(ui.Background(ui.Box(), color), 4), 8), 8)
	name := ui.FontSize(ui.FontWeight(ui.Text(label), 620), 12)
	status := ui.FontSize(ui.Foreground(ui.Text(value), TextMuted), 11)
	return ui.Align(ui.Row(dot, ui.Flex(name, 1), status), ui.AlignCenter)
}

func Metric(label string, value string, detail string, color uint32) ui.View {
	accent := ui.Height(ui.Width(ui.Radius(ui.Background(ui.Box(), color), 2), 3), 34)
	copy := ui.Column(ui.FontSize(ui.FontWeight(ui.Text(value), 720), 15), ui.FontSize(ui.Foreground(ui.Text(label), TextSecondary), 11), ui.FontSize(ui.Foreground(ui.Text(detail), TextMuted), 10))
	content := ui.Align(ui.Gap(ui.Row(accent, copy), Space3), ui.AlignCenter)
	return framed(ui.Padding(content, Space3), SurfaceSunken, Divider, 10)
}

func EmptyState(title string, detail string, action ui.View) ui.View {
	view := ui.Column(ui.FontSize(ui.FontWeight(ui.Text(title), 720), 18), ui.Foreground(ui.Text(detail), TextSecondary), action)
	view = ui.Gap(view, Space3)
	view = ui.Align(view, ui.AlignCenter)
	view = ui.Justify(view, ui.JustifyCenter)
	view = ui.Padding(view, Space6)
	return framed(view, Surface, Divider, 12)
}

func StarterCard(monogram string, title string, file string, description string, tags string, featured bool, busy bool, action func()) ui.View {
	accent := Accent
	if !featured {
		accent = Success
	}
	mark := ui.FontSize(ui.FontWeight(ui.Foreground(ui.Text(monogram), accent), 820), 12)
	mark = ui.Justify(ui.Align(ui.Height(ui.Width(ui.Background(ui.Radius(mark, 10), AccentSoft), 42), 42), ui.AlignCenter), ui.JustifyCenter)
	header := ui.Align(ui.Row(mark, ui.Flex(ui.Box(), 1), ui.FontSize(Muted(file), 11)), ui.AlignCenter)
	buttonLabel := "Open & edit"
	if busy {
		buttonLabel = "Opening…"
	}
	open := ui.Disabled(QuietButton(buttonLabel, action), busy)
	open = ui.AccessibleName(open, "Open " + title + " example in Studio")
	footer := ui.Align(ui.Row(ui.FontSize(Muted(tags), 11), ui.Flex(ui.Box(), 1), open), ui.AlignCenter)
	content := ui.Gap(ui.Column(header, ui.FontSize(ui.FontWeight(ui.Text(title), 740), 18), ui.Foreground(ui.Text(description), TextSecondary), ui.Flex(ui.Box(), 1), footer), Space3)
	content = ui.MinHeight(ui.Padding(content, Space4), 172)
	stripe := ui.Height(ui.Background(ui.Box(), accent), 3)
	return ui.Elevation(framed(ui.Column(stripe, content), Surface, Divider, 14), 1)
}

func ProjectCard(name string, root string, selected bool, managed bool, open func(), rename func(), remove func()) ui.View {
	title := name
	if selected {
		title = "● " + title
	}
	openButton := ui.AccessibleName(PrimaryButton("Open workspace", open), "Open project " + name)
	renameButton := ui.Disabled(ui.AccessibleName(QuietButton("Rename", rename), "Rename project " +
		name), !managed)
	removeLabel := "Delete"
	removeName := "Delete project " + name
	if !managed {
		removeLabel = "Forget"
		removeName = "Forget project " + name
	}
	deleteButton := ui.AccessibleName(QuietButton(removeLabel, remove), removeName)
	actions := ui.Gap(ui.Row(openButton, renameButton, deleteButton), Space2)
	content := ui.Gap(ui.Column(ui.FontSize(ui.FontWeight(ui.Text(title), 720), 16), ui.FontSize(Muted(root), 11), ui.Flex(ui.Box(), 1), actions), Space2)
	content = ui.MinHeight(ui.Padding(content, Space4), 146)
	border := Divider
	if selected {
		border = AccentStrong
	}
	return ui.Elevation(framed(content, Surface, border, 12), 1)
}

func ModalDialog(title string, open bool, content ui.View, onDismiss func()) ui.View {
	if !open {
		return ui.Fragment()
	}
	backdrop := ui.TestID(ui.OnClick(ui.Background(ui.Box(), 0x99000000), ui.Action(onDismiss)), "dialog-backdrop")
	heading := ui.FontSize(ui.FontWeight(ui.Text(title), 720), 18)
	actions := ui.Justify(ui.Row(PrimaryButton("Close dialog", onDismiss)), ui.JustifyEnd)
	panelContent := ui.Gap(ui.Column(heading, content, actions), Space3)
	panel := ui.PointerEvents(ui.MinWidth(ui.MaxWidth(ui.Padding(framed(panelContent, SurfaceRaised, Divider, 12), Space4), 480), 320), ui.PointerEventsAuto)
	positioned := ui.PointerEvents(ui.Justify(ui.Align(ui.Column(panel), ui.AlignCenter), ui.JustifyCenter), ui.PointerEventsNone)
	overlay := ui.AccessibleName(ui.Role(ui.Stack(backdrop, positioned), "dialog"), title)
	overlay = ui.OnKeyDownCapture(overlay, func(event ui.Event) {
		if event.Key == "Escape" {
			onDismiss()
		}
	})
	return ui.Portal(ui.Modal(overlay, true), ui.OverlayModal)
}

func ValidatedTextFieldWithFocus(label string, value string, placeholder string, required bool, disabled bool, errorMessage string, focusToken int64, onInput func(ui.Event)) ui.View {
	theme := StudioTheme()
	control := ui.TextInput(value, placeholder, onInput)
	control = ui.FocusRequest(control, focusToken)
	control = ui.AccessibleName(control, label)
	control = ui.AccessibleDescription(control, errorMessage)
	control = ui.Required(control, required)
	control = ui.Invalid(control, errorMessage != "")
	control = ui.Disabled(control, disabled)
	control = ui.Height(ui.Radius(ui.Foreground(ui.Background(control, theme.Surface), theme.Foreground), theme.Radius), theme.ControlHeight)
	control = ui.BorderWidth(ui.BorderColor(control, theme.Colors.Border), 1)
	labelView := ui.FontWeight(ui.Foreground(ui.Text(label), theme.Foreground), 600)
	if errorMessage != "" {
		errorView := ui.Role(ui.FontSize(ui.Foreground(ui.Text(errorMessage), theme.Danger), 13), "alert")
		return ui.Gap(ui.Column(labelView, control, errorView), theme.Space / 2)
	}
	return ui.Gap(ui.Column(labelView, control), theme.Space / 2)
}
