package main

import (
	"os"
)

func main() {
	r, w, err := os.Pipe()
	assert(err == nil, "create pipe")
	n, err := w.Write([]byte("ready"))
	assert(n == 5 && err == nil, "write through both open ends")
	buf := make([]byte, 5)
	n, err = r.Read(buf)
	assert(n == 5 && err == nil && string(buf) == "ready", "read the written bytes")
	assert(r.Close() == nil, "close the only reader")
	n, err = w.Write([]byte("payload"))
	assert(n == 0 && err != nil, "closed reader returns a write error")
	assert(w.Close() == nil, "writer remains closable after the error")
	println("closed pipe write returned an error")
}
