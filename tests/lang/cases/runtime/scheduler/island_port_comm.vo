// Test cross-island port communication
package main

func main() {
	// Create island and port
	i := make(island)
	p := make(port int, 1)
	// Spawn goroutine on island that sends value back
	go @(i) func(ch port<- int) {
		ch <- 42
	}(p)
	// Receive on main island
	println("main: waiting to receive")
	v := <-p
	println("main: received", v)
	assert(v == 42, "expected 42")
	// Test buffered port with multiple values
	p2 := make(port int, 5)
	buffered := make(port bool, 1)
	go @(i) func(ch port<- int, done port<- bool) {
		for x := 0; x < 5; x++ {
			ch <- x * 10
		}
		done <- true
	}(p2, buffered)
	// Completion proves all five values fit before the receiver starts.
	assert(<-buffered, "sender filled the buffered port")
	sum := 0
	for x := 0; x < 5; x++ {
		v := <-p2
		println("main: received", v)
		sum += v
	}
	assert(sum == 100, "expected sum 100") // 0+10+20+30+40=100
	close(p)
	close(p2)
	close(buffered)
	println("PASS")
}
