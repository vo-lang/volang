// Compile-only wasm32 regression. Keep this case out of the native runtime
// manifest: executing the valid 64-bit form would request an enormous array.
package main

type oversized [4294967296]struct{}

var value oversized

func escapeOversized() []struct{} {
	// The backing array remains globally represented while the slice escapes.
	// This reaches wasm32 address-width verification without first requiring a
	// target-independent, u16-wide aggregate transfer layout.
	return value[:]
}

func main() {
	_ = escapeOversized()
}
