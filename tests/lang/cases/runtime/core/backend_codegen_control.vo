package main

var trace int

var ticks int

func emptyCall() {
	ticks++
}

func repeatedClosure(x int) int {
	f := func(n int) int {
		return n + 1
	}
	y := f(x)
	return y + f(x)
}

func mark(id int, value bool) bool {
	trace = trace * 10 + id
	return value
}

func predicates(mask int) {
	a := mask & 1 != 0
	b := mask & 2 != 0
	c := mask & 4 != 0
	d := mask & 8 != 0
	expectedTrace := 1
	expected := false
	if a {
		expectedTrace = 12
		if b {
			expected = true
		}
	}
	if !expected {
		expectedTrace = expectedTrace * 10 + 3
		if !c {
			expectedTrace = expectedTrace * 10 + 4
			expected = d
		}
	}
	trace = 0
	result := false
	if (mark(1, a) && mark(2, b)) || (!mark(3, c) && mark(4, d)) {
		result = true
	}
	assert(result == expected && trace == expectedTrace)
	trace = 0
	switch {
		case !((mark(1, a) && mark(2, b)) || (!mark(3, c) && mark(4, d))):
			result = false
		default:
			result = true
	}
	assert(result == expected && trace == expectedTrace)
}

func decision(x int) int {
	switch x {
		case -8:
			return 0
		case -7:
			return 1
		case -6:
			return 4
		case -5:
			return 9
		case -4:
			return 16
		case -3:
			return 25
		case -2:
			return 36
		case -1:
			return 49
		case 0:
			return 64
		case 1:
			return 81
		case 2:
			return 100
		case 3:
			return 121
		case 4:
			return 144
		case 5:
			return 169
		case 6:
			return 196
		case 7:
			return 225
		default:
			return -1
	}
}

func stable(a []int) int {
	sum := 0
	for i := 0; i < len(a); i++ {
		a[i]++
		sum += a[i]
	}
	return sum
}

func resized(a []int) int {
	sum := 0
	for i := 0; i < len(a); i++ {
		if i == 0 {
			a = a[:2]
		}
		sum += a[i]
	}
	return sum
}

func captured(a []int) int {
	change := func() {
		a = a[:1]
	}
	sum := 0
	for i := 0; i < len(a); i++ {
		change()
		sum += a[i]
	}
	return sum
}

func cleanup(x int) int {
	a := 7
	b := a + 5
	unused := x + 999
	unused = (x + b) * (x + b) + (x + b)
	if b == 12 {
		return unused
	}
	return -1
}

func recovered() (out int) {
	defer func() {
		if recover() != nil {
			out += 7
		}
	}()
	out = 35
	panic("recover")
}

// Exercise all signed/unsigned, increasing/decreasing and inclusive/exclusive
// counted-loop forms in an ordinary typed function.
func loopDirections(mode int) int {
	sum := 0
	switch mode {
		case 0:
			for i := 0; i < 7; i++ {
				sum += i
			}
		case 1:
			for i := 0; i <= 7; i++ {
				sum += i
			}
		case 2:
			for i := 9; i > 3; i-- {
				sum += i
			}
		case 3:
			for i := 9; i >= 3; i-- {
				sum += i
			}
		case 4:
			for i := uint(0); i < uint(7); i++ {
				sum += int(i)
			}
		case 5:
			for i := uint(0); i <= uint(7); i++ {
				sum += int(i)
			}
		case 6:
			for i := uint(9); i > uint(3); i-- {
				sum += int(i)
			}
		case 7:
			for i := uint(9); i >= uint(3); i-- {
				sum += int(i)
			}
	}
	return sum
}

func nestedTransfers() int {
	sum := 0
	outer: for i := 0; i < 7; i++ {
		if i == 1 {
			continue
		}
		for j := 0; j < 6; j++ {
			if j == 2 {
				continue
			}
			if i == 4 && j == 1 {
				continue outer
			}
			if i == 6 && j == 4 {
				break outer
			}
			sum += i * 10 + j
		}
	}
	return sum
}

func main() {
	for i := 0; i < 200; i++ {
		assert(loopDirections(0) == 21 && loopDirections(4) == 21)
		assert(loopDirections(1) == 28 && loopDirections(5) == 28)
		assert(loopDirections(2) == 39 && loopDirections(6) == 39)
		assert(loopDirections(3) == 42 && loopDirections(7) == 42)
		assert(nestedTransfers() == 776)
		emptyCall()
		assert(repeatedClosure(i) == 2 * i + 2)
		predicates(i % 16)
		x := i % 20 - 10
		expected := -1
		if x >= -8 && x <= 7 {
			expected = (x + 8) * (x + 8)
		}
		assert(decision(x) == expected)
		assert(stable([]int{1, 2, 3}) == 9)
		assert(resized([]int{1, 2, 3, 4}) == 3)
		assert(captured([]int{5, 6, 7}) == 5)
		assert(cleanup(i) == (i + 12) * (i + 12) + i + 12)
		assert(recovered() == 42)
	}
	assert(ticks == 200)
	println("backend codegen control ok")
}
