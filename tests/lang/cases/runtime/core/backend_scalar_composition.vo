package main

import (
	"runtime/mem"
)

func f7(x int) int {
	return f6(x) + 1
}

func f6(x int) int {
	return f5(x) + 1
}

func f5(x int) int {
	return f4(x) + 1
}

func f4(x int) int {
	return f3(x) + 1
}

func f3(x int) int {
	return f2(x) + 1
}

func f2(x int) int {
	return f1(x) + 1
}

func f1(x int) int {
	return f0(x) + 1
}

func f0(x int) int {
	return x * 3
}

func narrow(x int8, y uint8, flag bool) (int8, uint8, bool) {
	x++
	y++
	return x, y, !flag
}

func swap(a, b int) (int, int) {
	return b + 1, a - 1
}

func named(x int) (a int, b int) {
	a = x
	return
}

func caughtDivide(divisor int) (caught bool) {
	defer func() {
		if recover() != nil {
			caught = true
		}
	}()
	_ = 100 / divisor
	return
}

func driver() {
	kept := []string{"retained", "after collection"}
	alias := kept[:]
	total := 0
	for i := 0; i < 256; i++ {
		total += f7(i)
		a, b := swap(total, i)
		assert(a == i + 1 && b == total - 1)
		original := int8(i)
		x, y, z := narrow(original, uint8(i), i % 2 == 0)
		assert(original == int8(i))
		assert(x == int8(i + 1) && y == uint8(i + 1) && z == (i % 2 != 0))
		first, second := named(i)
		assert(first == i && second == 0)
		if i % 7 == 0 {
			assert(mem.GCCollect())
		}
		assert(alias[0] == "retained" && alias[1] == "after collection")
	}
	assert(total == 99712)
	assert(caughtDivide(0))
	assert(!caughtDivide(4))
	assert(mem.GCCollect())
	assert(kept[0] == "retained" && alias[1] == "after collection")
}

func main() {
	driver()
	println("scalar composition ok")
}
