package main

import (
	"runtime/mem"
)

func literal() string {
	return "start:\x00\xff:漢字:end"
}

func checkLiteral(i int) int {
	first := literal()
	second := literal()
	assert(first == second && len(first) == 20)
	var boxed any = first
	var again any = second
	assert(boxed == again)
	bytes := []byte(first)
	bytes[0] = 'X'
	assert(first[0] == 's' && second[0] == 's')
	assert(first[6] == 0 && first[7] == 195 && first[8] == 191)
	view := first[6:9]
	held := func() string {
		return view
	}
	if i % 31 == 0 {
		assert(mem.GCCollect())
	}
	assert(held()[0] == 0 && held()[1] == 195 && held()[2] == 191)
	third := literal()
	assert(third == first && third[0] == 's')
	copied := make([]byte, 3)
	assert(copy(copied, view) == 3)
	copied[0] = 'q'
	assert(view[0] == 0)
	return len(third)
}

func main() {
	total := 0
	for i := 0; i < 500; i++ {
		total += checkLiteral(i)
	}
	assert(total == 10000)
	println("literal reuse ok")
}
