package main
import "math"

type operationCase struct { a, b, add, sub, mul, div uint32; compare int }
func checkBits(actual float32, expected uint32) {
    got := math.Float32bits(actual)
    if expected & 0x7fffffff > 0x7f800000 {
        assert(got & 0x7fffffff > 0x7f800000)
    } else {
        assert(got == expected)
    }
}
func check(row operationCase) {
    a, b := math.Float32frombits(row.a), math.Float32frombits(row.b)
    checkBits(a + b, row.add)
    checkBits(a - b, row.sub)
    checkBits(a * b, row.mul)
    checkBits(a / b, row.div)
    checkBits(-a, row.a ^ 0x80000000)
    x := a; x += b; checkBits(x, row.add)
    x = a; x -= b; checkBits(x, row.sub)
    x = a; x *= b; checkBits(x, row.mul)
    x = a; x /= b; checkBits(x, row.div)
    mask := 0
    if a == b { mask |= 1 }; if a != b { mask |= 2 }
    if a < b { mask |= 4 }; if a <= b { mask |= 8 }
    if a > b { mask |= 16 }; if a >= b { mask |= 32 }
    assert(mask == row.compare)
    assert(([1]float32{a} == [1]float32{b}) == (a == b))
    matched := false
    switch a { case b: matched = true }
    assert(matched == (a == b))
}
func rounding(a, b, c float32) {
    assert((a + b) - a == 0)
    x := math.Float32frombits(0x3f800001)
    y := math.Float32frombits(0x3f7ffffe)
    assert(x * y + c == 0)
    x = a; x++; assert(x == a); x--; assert(x == a - 1)
}
