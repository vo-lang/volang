package main

type Adder interface {
	Add(int) int
}

type A struct {
	base int
}

type B struct {
	base int
}

type C struct {
	base int
}

type D struct {
	base int
}

type E struct {
	base int
}

func (a *A) Add(x int) int {
	return x + a.base
}

func (a *B) Add(x int) int {
	return x + a.base
}

func (a *C) Add(x int) int {
	return x + a.base
}

func (a *D) Add(x int) int {
	return x + a.base
}

func (a *E) Add(x int) int {
	return x + a.base
}

func invoke(a Adder, x int) int {
	return a.Add(x)
}

func main() {
	values := []Adder{&A{1}, &B{2}, &C{3}, &D{4}, &E{5}}
	for i := 0; i < 1000; i++ {
		j := i % len(values)
		assert(invoke(values[j], i) == i + j + 1, "PIC must preserve receiver identity across tier changes and overflow")
	}
	for i := 0; i < 1000; i++ {
		j := i % 2
		assert(invoke(values[j], i) == i + j + 1, "PIC overflow must preserve established hot identities")
	}
}
