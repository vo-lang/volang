package main

type Cell struct {
	x int
}

func appendDifference(s []Cell) int {
	full := s[:cap(s)]
	p := &full[1]
	before := p.x
	s = append(s, Cell{x: 99})
	return p.x - before + len(s) - 2
}

func main() {
	total := 0
	for i := 0; i < 1000; i++ {
		total += appendDifference(make([]Cell, 1, 2))
	}
	assert(total == 99000, "append must invalidate reads through backing-array aliases")
}
