package main

import (
	"io"
	"net/http"
)

func main() {
	resp, err := http.Get("data:text/plain,client-ok")
	if err != nil {
		panic("GET failed: " + err.Error())
	}
	defer resp.Body.Close()
	assert(resp.StatusCode == http.StatusOK)
	body, err := io.ReadAll(resp.Body)
	if err != nil {
		panic("Read body failed: " + err.Error())
	}
	assert(string(body) == "client-ok")
	// References occupy language slots even when the host uses 32-bit pointers.
	request, err := http.NewRequest("GET", "data:text/plain,headers-ok", nil)
	assert(err == nil)
	request.Header.Add("X-First", "one")
	request.Header.Add("X-Second", "two")
	response, err := http.DefaultClient.Do(request)
	assert(err == nil)
	defer response.Body.Close()
	data, err := io.ReadAll(response.Body)
	assert(err == nil && string(data) == "headers-ok")
}
