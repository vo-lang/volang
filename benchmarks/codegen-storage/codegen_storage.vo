package main

func readArray(a [4]int, i int) int {
	return a[i]
}

func values(x int) int {
	sum := 0
	{
		y := x + 1
		sum += y
	}
	{
		y := x + 2
		sum += y
	}
	{
		y := x + 3
		sum += y
	}
	{
		y := x + 4
		sum += y
	}
	a := [4]int{x, x + 1, x + 2, x + 3}
	b := a
	return sum + readArray(b, x & 3)
}

func main() {
	sum := 0
	for i := 0; i < 200000; i++ {
		sum += values(i)
	}
	assert(sum == 100001800000)
	println(sum)
}
