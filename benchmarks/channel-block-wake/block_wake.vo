package main

const channelIterations = 524288

func channelRelay(input chan int, output chan int, done chan int) {
	for i := 0; i < channelIterations; i++ {
		value := <-input
		output <- (value & 1023) + 1
	}
	done <- 1
}

func main() {
	ping := make(chan int)
	pong := make(chan int)
	done := make(chan int, 1)
	go channelRelay(ping, pong, done)
	checksum := 0
	for i := 0; i < channelIterations; i++ {
		ping <- i
		checksum += <-pong
	}
	<-done
	expected := (channelIterations / 1024) * (1024 * 1025 / 2)
	assert(checksum == expected, "channel block/wake checksum mismatch")
	println(checksum)
}
