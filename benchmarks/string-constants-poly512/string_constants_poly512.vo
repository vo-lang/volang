func main() {
	sum := 0
	var retained string
	for i := 0; i < 262144; i++ {
		s := label(i & 511)
		sum = (sum * 1664525 + len(s) + int(s[1]) * 17 + int(s[2]) * 19 + int(s[3]) * 23 + int(s[4]) * 29) &
			2147483647
		if i & 4095 == 0 {
			retained = s
		}
	}
	sum += len(retained)
	assert(sum == 1952444421)
	println(sum)
}
