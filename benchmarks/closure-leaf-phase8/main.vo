package main

func mix(x int) int {
	return (x * 33) ^ 17
}

func main() {
	table := []func(int) int{
		func(x int) int {
			return x + 1
		},
		func(x int) int {
			return x + 2
		},
		func(x int) int {
			return x + 3
		},
		func(x int) int {
			return x + 4
		},
		func(x int) int {
			return x + 5
		},
		func(x int) int {
			return x + 6
		},
		func(x int) int {
			return x + 7
		},
		func(x int) int {
			return x + 8
		},
	}
	total := 0
	for i := 0; i < 200000; i++ {
		index := i & 7
		if i < 100000 {
			index = 0
		}
		total += table[index](i & 1023)
	}
	assert(total == 102737360, "dynamic target/value mismatch")
	println(total)
}
