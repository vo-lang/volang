package main

func mix(x int) int {
	return (x * 33) ^ 17
}

type Adder interface {
	Add(int) int
}

type Shape0 struct{}

func (s *Shape0) Add(x int) int {
	return mix(x) + 1
}

type Shape1 struct{}

func (s *Shape1) Add(x int) int {
	return mix(x) + 2
}

type Shape2 struct{}

func (s *Shape2) Add(x int) int {
	return mix(x) + 3
}

type Shape3 struct{}

func (s *Shape3) Add(x int) int {
	return mix(x) + 4
}

type Shape4 struct{}

func (s *Shape4) Add(x int) int {
	return mix(x) + 5
}

type Shape5 struct{}

func (s *Shape5) Add(x int) int {
	return mix(x) + 6
}

type Shape6 struct{}

func (s *Shape6) Add(x int) int {
	return mix(x) + 7
}

type Shape7 struct{}

func (s *Shape7) Add(x int) int {
	return mix(x) + 8
}

func main() {
	table := []Adder{
		&Shape0{}, &Shape1{}, &Shape2{}, &Shape3{}, &Shape4{}, &Shape5{}, &Shape6{}, &Shape7{},
	}
	total := 0
	for i := 0; i < 200000; i++ {
		index := i & 7
		if i < 100000 {
			index = 0
		}
		total += table[index].Add(i & 1023)
	}
	assert(total == 3372732880, "dynamic target/value mismatch")
	println(total)
}
