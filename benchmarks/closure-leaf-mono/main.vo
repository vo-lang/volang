package main

func mix(x int) int {
	return (x * 33) ^ 17
}

func main() {
	table := []func(int) int{
		func(x int) int {
			return x + 1
		},
	}
	total := 0
	for i := 0; i < 200000; i++ {
		index := i & 0
		total += table[index](i & 1023)
	}
	assert(total == 102387360, "dynamic target/value mismatch")
	println(total)
}
