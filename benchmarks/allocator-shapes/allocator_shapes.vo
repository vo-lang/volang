package main

type First struct {
	value int
}

type Second struct {
	value int
}

var first *First

var second *Second

func main() {
	sum := 0
	for i := 0; i < 262144; i++ {
		if i & 1 == 0 {
			first = &First{i}
			sum += first.value
		} else {
			second = &Second{i}
			sum += second.value
		}
	}
	assert(sum == 34359607296)
	println(sum)
}
