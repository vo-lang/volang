package main

func mix(x int) int {
	return (x * 33) ^ 17
}

type Adder interface {
	Add(int) int
}

type Shape0 struct{}

func (s *Shape0) Add(x int) int {
	return x + 1
}

type Shape1 struct{}

func (s *Shape1) Add(x int) int {
	return x + 2
}

func main() {
	table := []Adder{&Shape0{}, &Shape1{}}
	total := 0
	for i := 0; i < 200000; i++ {
		index := i & 1
		total += table[index].Add(i & 1023)
	}
	assert(total == 102487360, "dynamic target/value mismatch")
	println(total)
}
