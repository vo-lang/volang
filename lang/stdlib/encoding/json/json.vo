// Package json implements encoding and decoding of JSON.
//
// Public API:
//   - Marshal(v any) ([]byte, error)           - encode to JSON (encode.vo)
//   - Unmarshal(data []byte, v any) error      - decode into struct (native)
//   - Decode(data []byte) (any, error)         - decode to dynamic types (decode.vo)
//   - Encoder / Decoder                        - streaming API
package json

import (
	"errors"
	"strconv"
	"unicode/utf8"
)

// Native functions (implemented in Rust)
func unmarshalAny(data []byte, v any) error

func marshalAny(v any) ([]byte, error)

func appendHex4(buf []byte, value rune) []byte {
	const digits = "0123456789abcdef"
	return append(buf, '\\', 'u', digits[(value >> 12) & 0xf], digits[(value >> 8) & 0xf], digits[(value >>
		4) &
		0xf], digits[value & 0xf])
}

// writeJsonString appends one JSON string, including its quotes. It lives in
// the language library so every backend shares the same UTF-8 and escaping
// rules.
func writeJsonString(buf []byte, s string, escapeHTML bool) []byte {
	buf = append(buf, '"')
	data := []byte(s)
	for pos := 0; pos < len(data);  {
		c := data[pos]
		if c < utf8.RuneSelf {
			pos++
			switch c {
				case '"', '\\':
					buf = append(buf, '\\', c)
				case '\b':
					buf = append(buf, '\\', 'b')
				case '\f':
					buf = append(buf, '\\', 'f')
				case '\n':
					buf = append(buf, '\\', 'n')
				case '\r':
					buf = append(buf, '\\', 'r')
				case '\t':
					buf = append(buf, '\\', 't')
				case '<', '>', '&':
					if escapeHTML {
						buf = appendHex4(buf, rune(c))
					} else {
						buf = append(buf, c)
					}
				default:
					if c < 0x20 {
						buf = appendHex4(buf, rune(c))
					} else {
						buf = append(buf, c)
					}
			}
			continue
		}
		r, width := utf8.DecodeRune(data[pos:])
		if r == utf8.RuneError && width == 1 {
			buf = append(buf, "\\ufffd"...)
			pos++
			continue
		}
		buf = append(buf, data[pos:pos + width]...)
		pos += width
	}
	return append(buf, '"')
}

func jsonHexDigit(c byte) (rune, bool) {
	if c >= '0' && c <= '9' {
		return rune(c - '0'), true
	}
	if c >= 'a' && c <= 'f' {
		return rune(c - 'a' + 10), true
	}
	if c >= 'A' && c <= 'F' {
		return rune(c - 'A' + 10), true
	}
	return 0, false
}

func parseHex4(data []byte, pos int) (rune, bool) {
	if pos < 0 || pos + 4 > len(data) {
		return 0, false
	}
	value := rune(0)
	for i := 0; i < 4; i++ {
		digit, ok := jsonHexDigit(data[pos + i])
		if !ok {
			return 0, false
		}
		value = value << 4 | digit
	}
	return value, true
}

func jsonStringError(message string) error {
	return errors.Wrap(ErrSyntax, message)
}

// parseJsonString decodes the JSON string beginning at pos and returns the
// byte offset immediately following its closing quote.
func parseJsonString(data []byte, pos int) (string, int, error) {
	if pos < 0 || pos >= len(data) || data[pos] != '"' {
		return "", pos, jsonStringError("expected JSON string")
	}
	start := pos
	pos++
	buf := make([]byte, 0, 16)
	for pos < len(data) {
		c := data[pos]
		if c == '"' {
			return string(buf), pos + 1, nil
		}
		if c == '\\' {
			pos++
			if pos >= len(data) {
				return "", start, ErrUnexpectedEOF
			}
			escape := data[pos]
			pos++
			switch escape {
				case '"', '\\', '/':
					buf = append(buf, escape)
				case 'b':
					buf = append(buf, '\b')
				case 'f':
					buf = append(buf, '\f')
				case 'n':
					buf = append(buf, '\n')
				case 'r':
					buf = append(buf, '\r')
				case 't':
					buf = append(buf, '\t')
				case 'u':
					value, ok := parseHex4(data, pos)
					if !ok {
						return "", start, jsonStringError("invalid Unicode escape")
					}
					pos += 4
					if value >= 0xd800 && value <= 0xdbff {
						if pos + 6 > len(data) || data[pos] != '\\' || data[pos + 1] != 'u' {
							return "", start, jsonStringError("invalid Unicode surrogate pair")
						}
						low, valid := parseHex4(data, pos + 2)
						if !valid || low < 0xdc00 || low > 0xdfff {
							return "", start, jsonStringError("invalid Unicode surrogate pair")
						}
						value = 0x10000 + (value - 0xd800) * 0x400 + low - 0xdc00
						pos += 6
					} else if value >= 0xdc00 && value <= 0xdfff {
						return "", start, jsonStringError("invalid Unicode surrogate")
					}
					buf = utf8.AppendRune(buf, value)
				default:
					return "", start, jsonStringError("invalid escape character")
			}
			continue
		}
		if c < 0x20 {
			return "", start, jsonStringError("unescaped control character")
		}
		if c < utf8.RuneSelf {
			buf = append(buf, c)
			pos++
			continue
		}
		r, width := utf8.DecodeRune(data[pos:])
		if r == utf8.RuneError && width == 1 {
			return "", start, jsonStringError("invalid UTF-8 in JSON string")
		}
		buf = append(buf, data[pos:pos + width]...)
		pos += width
	}
	return "", start, ErrUnexpectedEOF
}

// Errors
var (
	ErrSyntax = errors.New("json syntax error")
	ErrUnexpectedEOF = errors.New("unexpected end of JSON input")
	ErrInvalidValue = errors.New("invalid JSON value")
	ErrTypeMismatch = errors.New("JSON type mismatch")
	ErrMarshal = errors.New("JSON marshal error")
	ErrUnmarshal = errors.New("JSON unmarshal error")
)

// Marshaler is the interface implemented by types that can marshal themselves into valid JSON.
type Marshaler interface {
	MarshalJSON() ([]byte, error)
}

// Unmarshaler is the interface implemented by types that can unmarshal a JSON description of themselves.
type Unmarshaler interface {
	UnmarshalJSON([]byte) error
}

// Unmarshal decodes data into v, honoring a user-defined Unmarshaler before
// falling back to the native structured decoder.
func Unmarshal(data []byte, v any) error {
	if unmarshaler, ok := v.(Unmarshaler); ok {
		return unmarshaler.UnmarshalJSON(data)
	}
	return unmarshalAny(data, v)
}

// Number preserves the original string representation of a JSON number.
type Number string

func (n Number) String() string {
	return string(n)
}

func (n Number) Int64() (int64, error) {
	return strconv.ParseInt(string(n), 10, 64)
}

func (n Number) Float64() (float64, error) {
	return strconv.ParseFloat(string(n), 64)
}

// RawMessage is a raw encoded JSON value.
type RawMessage []byte

// Delim is a JSON delimiter: [ ] { }
type Delim rune

func (d Delim) String() string {
	return string(d)
}

// Token is returned by Decoder.Token(): Delim, bool, float64, Number, string, or nil.
type Token interface{}
