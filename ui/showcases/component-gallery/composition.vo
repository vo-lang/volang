package main

import (
	ui "github.com/vo-lang/ui"
	"github.com/vo-lang/ui/kit"
	"strconv"
)

// CompositionGallery owns the dense collection, navigation, calendar, upload,
// gesture, and code-preview laboratory as one independently mounted component.
// Keeping its state local prevents the page shell from becoming one oversized
// Native AOT function while preserving the complete initial gallery surface.
func CompositionGallery(status ui.StringState) ui.View {
	packageSearch := ui.UseStringState("Volang")
	navigationLayout := ui.UseStringState("top")
	navigationFocusToken := ui.UseIntState(0)
	navigationOverflowOpen := ui.UseBoolState(false)
	toggleBold := ui.UseBoolState(true)
	toggleItalic := ui.UseBoolState(false)
	toggleFocus := ui.UseStringState("bold")
	toggleFocusToken := ui.UseIntState(0)
	rating := ui.UseIntState(4)
	ratingFocusToken := ui.UseIntState(0)
	scrollX := ui.UseFloatState(0)
	scrollY := ui.UseFloatState(0)
	carouselKey := ui.UseStringState("compiler")
	carouselState := kit.UseCarouselState()
	codeCopied := ui.UseBoolState(false)
	paneSize := ui.UseFloatState(280)
	resizableState := kit.UseResizableState(280)
	comboboxQuery := ui.UseStringState("Renderer package")
	comboboxValue := ui.UseStringState("renderer")
	comboboxActive := ui.UseStringState("renderer")
	comboboxOpen := ui.UseBoolState(false)
	comboboxFocusToken := ui.UseIntState(0)
	multiSelectQuery := ui.UseStringState("")
	multiSelectActive := ui.UseStringState("desktop")
	multiSelectOpen := ui.UseBoolState(false)
	multiSelectWeb := ui.UseBoolState(true)
	multiSelectDesktop := ui.UseBoolState(false)
	multiSelectNative := ui.UseBoolState(false)
	multiSelectFocusToken := ui.UseIntState(0)
	calendarMonth := ui.UseStringState("2026-08")
	calendarFocus := ui.UseStringState("2026-08-18")
	calendarFocusToken := ui.UseIntState(0)
	calendarRangeStart := ui.UseStringState("2026-08-12")
	calendarRangeEnd := ui.UseStringState("2026-08-18")
	datePickerInput := ui.UseStringState("29/08/2026")
	datePickerValue := ui.UseStringState("2026-08-29")
	datePickerMonth := ui.UseStringState("2026-08")
	datePickerFocus := ui.UseStringState("2026-08-29")
	datePickerFocusToken := ui.UseIntState(0)
	datePickerOpen := ui.UseBoolState(false)
	datePickerError := ui.UseStringState("")
	uploadDragActive := ui.UseBoolState(false)
	uploadCancelled := ui.UseBoolState(false)
	uploadDropped := ui.UseBoolState(false)
	uploadRejected := ui.UseBoolState(false)
	contextOpen := ui.UseBoolState(false)
	contextX := ui.UseFloatState(16)
	contextY := ui.UseFloatState(16)
	contextActive := ui.UseStringState("open")
	contextSubmenu := ui.UseStringState("")
	contextFocusToken := ui.UseIntState(0)
	contextRestoreFocusToken := ui.UseIntState(0)
	contextCompactView := ui.UseBoolState(false)
	avatarItems := []kit.AvatarItem{
		{Key: "ada", Name: "Ada Lovelace", Initials: "AL"},
		{Key: "grace", Name: "Grace Hopper", Initials: "GH"},
		{Key: "margaret", Name: "Margaret Hamilton", Initials: "MH"},
		{Key: "alan", Name: "Alan Turing", Initials: "AT"},
	}
	toggleValues := []string{}
	if ui.BoolStateValue(toggleBold) {
		toggleValues = append(toggleValues, "bold")
	}
	if ui.BoolStateValue(toggleItalic) {
		toggleValues = append(toggleValues, "italic")
	}
	toggleItems := []kit.SegmentItem{
		{Value: "bold", Label: "Bold"}, {Value: "italic", Label: "Italic"},
		{Value: "underline", Label: "Underline", Disabled: true},
	}
	navigationGroups := []kit.NavigationGroup{
		{
			Key: "workspace", Label: "Workspace",
			Items: []kit.NavigationItem{
				{Key: "home", Label: "Home", CompactLabel: "H", Path: "/", Current: true},
				{Key: "components", Label: "Components", CompactLabel: "C", Path: "/components"},
			},
		},
		{
			Key: "manage", Label: "Manage",
			Items: []kit.NavigationItem{
				{Key: "admin", Label: "Admin", CompactLabel: "A", Path: "/admin", Disabled: true},
				{Key: "logs", Label: "Logs", CompactLabel: "L", Path: "/logs"},
			},
		},
		{
			Key: "insights", Label: "Insights",
			Items: []kit.NavigationItem{
				{Key: "metrics", Label: "Metrics", CompactLabel: "M", Path: "/metrics"},
			},
		},
	}
	navigationModes := []kit.SegmentItem{
		{Value: "top", Label: "Top"}, {Value: "side", Label: "Side"},
		{Value: "compact", Label: "Compact"},
	}
	packageChoices := []kit.ChoiceOption{
		{Value: "compiler", Label: "Compiler package"}, {Value: "renderer", Label: "Renderer package"},
		{Value: "tooling", Label: "Tooling package", Disabled: true},
		{Value: "runtime", Label: "Runtime package"},
	}
	targetChoices := []kit.ChoiceOption{
		{Value: "web", Label: "Web target"}, {Value: "desktop", Label: "Desktop target"},
		{Value: "native", Label: "Native target"},
		{Value: "legacy", Label: "Legacy target", Disabled: true},
	}
	selectedTargets := []string{}
	if ui.BoolStateValue(multiSelectWeb) {
		selectedTargets = append(selectedTargets, "web")
	}
	if ui.BoolStateValue(multiSelectDesktop) {
		selectedTargets = append(selectedTargets, "desktop")
	}
	if ui.BoolStateValue(multiSelectNative) {
		selectedTargets = append(selectedTargets, "native")
	}
	weekdayLabels := []string{"Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"}
	calendarConfig := kit.CalendarConfig{
		VisibleMonth: ui.StringStateValue(calendarMonth),
		MonthLabel: galleryMonthLabel(ui.StringStateValue(calendarMonth)), Minimum: "2026-08-01",
		Maximum: "2026-10-31", DisabledDates: []string{"2026-08-20"}, WeekStartsMonday: true,
		WeekdayLabels: weekdayLabels,
	}
	datePickerConfig := kit.CalendarConfig{
		VisibleMonth: ui.StringStateValue(datePickerMonth),
		MonthLabel: galleryMonthLabel(ui.StringStateValue(datePickerMonth)), Minimum: "2026-08-01",
		Maximum: "2026-10-31", DisabledDates: []string{"2026-08-20"}, WeekStartsMonday: true,
		WeekdayLabels: weekdayLabels,
	}
	uploadFiles := []kit.UploadFile{
		{
			Key: "readme", Name: "README.md", Path: "/workspace/README.md", Size: 4096, Progress: 100,
			Status: kit.UploadComplete,
		},
		{
			Key: "bundle", Name: "app.wasm", Path: "/workspace/app.wasm", Size: 18173114, Progress: 64,
			Status: kit.UploadRunning,
		},
		{
			Key: "oversized", Name: "archive.iso", Path: "/workspace/archive.iso", Size: 9000000000,
			Progress: 0, Status: kit.UploadRejected, Message: "File exceeds 64 MiB",
		},
	}
	if ui.BoolStateValue(uploadCancelled) {
		uploadFiles[1].Status = kit.UploadCancelled
		uploadFiles[1].Message = "Cancelled by user"
	}
	if ui.BoolStateValue(uploadDropped) {
		uploadFiles = append(uploadFiles, kit.UploadFile{
			Key: "dropped", Name: "dropped.vo", Path: "dropped.vo", Size: 128, Progress: 0,
			Status: kit.UploadQueued,
		})
	}
	if ui.BoolStateValue(uploadRejected) {
		uploadFiles = append(uploadFiles, kit.UploadFile{
			Key: "limit", Name: "rejected batch", Path: "rejected", Size: 0, Progress: 0,
			Status: kit.UploadRejected, Message: "File limit exceeded",
		})
	}
	contextItems := []kit.ContextMenuItem{
		{Key: "open", Label: "Open project", Shortcut: "Enter"},
		{Key: "rename", Label: "Rename project", Shortcut: "F2"},
		{Key: "archive", Label: "Archive project", Disabled: true},
		{
			Key: "view", Label: "View options",
			Children: []kit.ContextMenuItem{
				{
					Key: "compact", Label: "Compact view", Checkable: true,
					Checked: ui.BoolStateValue(contextCompactView),
				},
				{
					Key: "comfortable", Label: "Comfortable view", Checkable: true,
					Checked: !ui.BoolStateValue(contextCompactView),
				},
			},
		},
		{Key: "details", Label: "Project details"},
	}
	contextTarget := ui.AccessibleName(ui.Role(ui.Padding(kit.Paragraph("Right-click or press the Context Menu key to inspect this project."), kit.CurrentTheme().Spacing.ContentGap), "region"), "Project canvas")
	navigationLayoutValue := ui.DerivedString(ui.StringStateValue(navigationLayout))
	navigationMode := kit.NavigationMode(ui.DerivedInt(int64(kit.NavigationTop)))
	if navigationLayoutValue == "side" {
		navigationMode = kit.NavigationSide
	} else if navigationLayoutValue == "compact" {
		navigationMode = kit.NavigationCompact
	}
	carouselItems := []kit.CarouselItem{
		{
			Key: "compiler", Label: "Compiler",
			Content: kit.Paragraph("Static component structure lowers to direct renderer updates."),
		},
		{
			Key: "runtime", Label: "Runtime",
			Content: kit.Paragraph("One bounded UI writer commits worker results deterministically."),
		},
		{
			Key: "release", Label: "Release",
			Content: kit.Paragraph("WebAssembly and native AOT share the same application tree."),
		},
	}
	carouselValue := ui.DerivedString(ui.StringStateValue(carouselKey))
	codeSample := "func main() int {\n\tprintln(\"hello from Volang\")\n\treturn 0\n}"
	scrollPosition := ui.DerivedString(strconv.FormatFloat(ui.FloatStateValue(scrollX), 'f', 0, 64) +
		"," +
		strconv.FormatFloat(ui.FloatStateValue(scrollY), 'f', 0, 64))
	scrollContent := ui.Width(ui.Height(ui.Box(ui.Padding(kit.Paragraph("Two-axis controlled scrolling preserves the exact viewport across renderer commits."), kit.CurrentTheme().Spacing.SectionGap)), 220), 640)
	resizableDemo := ui.AccessibleName(ui.Role(ui.Align(ui.Row(ui.AccessibleName(ui.Role(ui.Width(ui.Padding(kit.Paragraph("Primary workspace pane"), kit.CurrentTheme().Spacing.ContentGap), ui.FloatStateValue(paneSize)), "region"), "Resizable primary pane"), kit.ResizableHandle("Inspector size", resizableState, kit.AxisHorizontal, ui.FloatStateValue(paneSize), 0, 600, 16, false, func(value float64) {
		ui.SetFloatState(paneSize, value)
		ui.SetStringState(status, "Inspector size changed")
	}), ui.Flex(ui.Padding(kit.Caption("Flexible inspector content"), kit.CurrentTheme().Spacing.ContentGap), 1)), ui.AlignCenter), "group"), "Resizable workspace")
	return kit.Panel(ui.Gap(ui.Column(kit.Title("Composition and collections"), kit.AvatarGroup("Core maintainers", avatarItems, 3, 40), kit.InputGroup("Package address", kit.Caption("github.com/vo-lang/"), kit.InputGroupField("Package", ui.StringStateValue(packageSearch), "ui/kit", false, false, "", 0, func(value string) {
		ui.SetStringState(packageSearch, value)
	}), kit.IconButton("Resolve package", kit.IconSearch, kit.ButtonQuiet, kit.ControlSmall, false, func() {
		ui.SetStringState(status, "Package resolved")
	}), ""), kit.InputGroup("Registry token", kit.Caption("@"), kit.InputGroupField("Registry token value", "", "token", true, false, "Token is required", 0, func(value string) {
		ui.SetStringState(status, "Registry token changed")
	}), kit.KeyboardKey("required"), "Token is required"), kit.ToggleGroup("Text styles", toggleItems, toggleValues, kit.ToggleMultiple, false, kit.Horizontal, ui.StringStateValue(toggleFocus), ui.IntStateValue(toggleFocusToken), func(key string) {
		ui.SetStringState(toggleFocus, key)
		ui.SetIntState(toggleFocusToken, ui.IntStateValue(toggleFocusToken) + 1)
	}, func(key string, selected bool) {
		if key == "bold" {
			ui.SetBoolState(toggleBold, selected)
		} else if key == "italic" {
			ui.SetBoolState(toggleItalic, selected)
		}
		ui.SetStringState(status, "Text style changed: " + key)
	}), kit.Rating("Framework quality", ui.IntStateValue(rating), 5, false, false, ui.IntStateValue(ratingFocusToken), func(value int64) {
		ui.SetIntState(rating, value)
		ui.SetIntState(ratingFocusToken, ui.IntStateValue(ratingFocusToken) + 1)
		ui.SetStringState(status, "Framework quality changed")
	}), kit.Rating("Read-only framework quality", 3, 5, true, false, 0, nil), kit.Rating("Unavailable framework quality", 2, 5, false, true, 0, func(value int64) {}), kit.CodeSnippet("Build command", "vo ui build -o dist", kit.CodeSnippetInline, true, ui.BoolStateValue(codeCopied), func(err error) {
		if err != nil {
			ui.SetStringState(status, "Code copy failed")
		} else {
			ui.SetBoolState(codeCopied, true)
			ui.SetStringState(status, "Code copied")
		}
	}), kit.CodeSnippet("Volang entry point", codeSample, kit.CodeSnippetBlock, false, false, nil), kit.Combobox("gallery-package-combobox", "Framework package", ui.StringStateValue(comboboxQuery), "Filter packages", ui.StringStateValue(comboboxValue), ui.StringStateValue(comboboxActive), packageChoices, ui.BoolStateValue(comboboxOpen), false, false, ui.IntStateValue(comboboxFocusToken), func(value string) {
		ui.SetStringState(comboboxQuery, value)
	}, func(open bool) {
		ui.SetBoolState(comboboxOpen, open)
	}, func(value string) {
		ui.SetStringState(comboboxActive, value)
	}, func(value string) {
		ui.SetStringState(comboboxValue, value)
		ui.SetStringState(status, "Framework package: " + value)
	}), kit.MultiSelect("gallery-target-multiselect", "Release platforms", ui.StringStateValue(multiSelectQuery), "Filter release platforms", selectedTargets, ui.StringStateValue(multiSelectActive), targetChoices, ui.BoolStateValue(multiSelectOpen), false, false, 3, ui.IntStateValue(multiSelectFocusToken), func(value string) {
		ui.SetStringState(multiSelectQuery, value)
	}, func(open bool) {
		ui.SetBoolState(multiSelectOpen, open)
	}, func(value string) {
		ui.SetStringState(multiSelectActive, value)
	}, func(value string, selected bool) {
		if value == "web" {
			ui.SetBoolState(multiSelectWeb, selected)
		} else if value == "desktop" {
			ui.SetBoolState(multiSelectDesktop, selected)
		} else if value == "native" {
			ui.SetBoolState(multiSelectNative, selected)
		}
		ui.SetStringState(status, "Release platform changed: " + value)
	}), kit.DatePicker("gallery-release-date", "Release date", ui.StringStateValue(datePickerInput), "DD/MM/YYYY", "02/01/2006", ui.StringStateValue(datePickerValue), datePickerConfig, ui.BoolStateValue(datePickerOpen), ui.StringStateValue(datePickerFocus), ui.IntStateValue(datePickerFocusToken), ui.StringStateValue(datePickerError), false, func(value string) {
		ui.SetStringState(datePickerInput, value)
		ui.SetStringState(datePickerError, "")
	}, func(open bool) {
		ui.SetBoolState(datePickerOpen, open)
		if open {
			ui.SetIntState(datePickerFocusToken, ui.IntStateValue(datePickerFocusToken) + 1)
		}
	}, func(value string) {
		ui.SetStringState(datePickerMonth, value)
	}, func(value string) {
		ui.SetStringState(datePickerFocus, value)
		ui.SetIntState(datePickerFocusToken, ui.IntStateValue(datePickerFocusToken) + 1)
	}, func(value string) {
		ui.SetStringState(datePickerValue, value)
		ui.SetStringState(datePickerError, "")
		ui.SetStringState(status, "Release date: " + value)
	}, func() {
		ui.SetStringState(datePickerError, "Enter a valid available date")
		ui.SetStringState(status, "Release date is invalid")
	}), kit.Calendar("Release window", calendarConfig, kit.CalendarRange, ui.StringStateValue(calendarRangeStart), ui.StringStateValue(calendarRangeEnd), ui.StringStateValue(calendarFocus), ui.IntStateValue(calendarFocusToken), func(value string) {
		ui.SetStringState(calendarMonth, value)
	}, func(value string) {
		ui.SetStringState(calendarFocus, value)
		ui.SetIntState(calendarFocusToken, ui.IntStateValue(calendarFocusToken) + 1)
	}, func(value string) {
		if ui.StringStateValue(calendarRangeStart) == "" || ui.StringStateValue(calendarRangeEnd) != "" {
			ui.SetStringState(calendarRangeStart, value)
			ui.SetStringState(calendarRangeEnd, "")
		} else if value < ui.StringStateValue(calendarRangeStart) {
			ui.SetStringState(calendarRangeStart, value)
		} else {
			ui.SetStringState(calendarRangeEnd, value)
		}
		ui.SetStringState(status, "Release window date: " + value)
	}), kit.FileUploader("Release artifacts", uploadFiles, kit.FileUploaderOptions{
		Multiple: true, MaximumFiles: 4, MaximumBytes: 67108864,
		Filters: []kit.FileFilter{{Name: "Volang artifacts", Extensions: []string{"vo", "wasm", "md"}}},
	}, ui.BoolStateValue(uploadDragActive), false, func(paths []string) {
		ui.SetBoolState(uploadDropped, true)
		ui.SetStringState(status, "Upload files accepted")
	}, func(paths []string, reason string) {
		ui.SetBoolState(uploadRejected, true)
		ui.SetStringState(status, "Upload rejected: " + reason)
	}, func(active bool) {
		ui.SetBoolState(uploadDragActive, active)
	}, func(key string) {
		if key == "bundle" {
			ui.SetBoolState(uploadCancelled, true)
		}
		ui.SetStringState(status, "Upload cancelled: " + key)
	}, func(key string) {
		if key == "bundle" {
			ui.SetBoolState(uploadCancelled, false)
		}
		ui.SetStringState(status, "Upload retried: " + key)
	}, func(err error) {
		ui.SetStringState(status, "Upload picker unavailable: " + err.Error())
	}), kit.ContextMenu("Project canvas menu", contextTarget, contextItems, ui.BoolStateValue(contextOpen), ui.FloatStateValue(contextX), ui.FloatStateValue(contextY), ui.StringStateValue(contextActive), ui.StringStateValue(contextSubmenu), ui.IntStateValue(contextFocusToken), ui.IntStateValue(contextRestoreFocusToken), func(x float64, y float64) {
		ui.SetFloatState(contextX, x)
		ui.SetFloatState(contextY, y)
		ui.SetStringState(contextActive, "open")
		ui.SetStringState(contextSubmenu, "")
		ui.SetIntState(contextFocusToken, ui.IntStateValue(contextFocusToken) + 1)
		ui.SetBoolState(contextOpen, true)
	}, func(key string) {
		ui.SetStringState(contextActive, key)
		ui.SetIntState(contextFocusToken, ui.IntStateValue(contextFocusToken) + 1)
	}, func(key string) {
		ui.SetStringState(contextSubmenu, key)
		ui.SetIntState(contextFocusToken, ui.IntStateValue(contextFocusToken) + 1)
	}, func(key string) {
		if key == "compact" {
			ui.SetBoolState(contextCompactView, true)
		} else if key == "comfortable" {
			ui.SetBoolState(contextCompactView, false)
		}
		ui.SetStringState(status, "Context action: " + key)
		ui.SetBoolState(contextOpen, false)
		ui.SetIntState(contextRestoreFocusToken, ui.IntStateValue(contextRestoreFocusToken) + 1)
	}, func() {
		ui.SetBoolState(contextOpen, false)
		ui.SetStringState(contextSubmenu, "")
		ui.SetIntState(contextRestoreFocusToken, ui.IntStateValue(contextRestoreFocusToken) + 1)
	}), kit.SegmentedControl("Navigation layout", navigationModes, navigationLayoutValue, false, ui.IntStateValue(navigationFocusToken), func(value string) {
		ui.SetStringState(navigationLayout, value)
		ui.SetIntState(navigationFocusToken, ui.IntStateValue(navigationFocusToken) + 1)
		ui.SetBoolState(navigationOverflowOpen, false)
		ui.SetStringState(status, "Navigation layout: " + value)
	}), kit.NavigationMenu("Product navigation", navigationGroups, navigationMode, 3, ui.BoolStateValue(navigationOverflowOpen), func(open bool) {
		ui.SetBoolState(navigationOverflowOpen, open)
	}), kit.ScrollArea("Portable scroll area", scrollContent, 360, 120, ui.FloatStateValue(scrollX), ui.FloatStateValue(scrollY), func(x float64, y float64) {
		ui.SetFloatState(scrollX, x)
		ui.SetFloatState(scrollY, y)
		ui.SetStringState(status, "Scroll position changed")
	}), ui.AccessibleName(ui.Role(kit.Caption("Scroll position: " + scrollPosition), "status"), "Scroll position"), resizableDemo, ui.AccessibleName(ui.Role(kit.Caption("Selected carousel item: " +
		carouselValue), "status"), "Carousel selection"), kit.Carousel("Runtime pipeline", carouselState, carouselItems, carouselValue, true, func(key string) {
		ui.SetStringState(carouselKey, key)
		ui.SetStringState(status, "Carousel item: " + key)
	})), kit.CurrentTheme().Spacing.ContentGap))
}
