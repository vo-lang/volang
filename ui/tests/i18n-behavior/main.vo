package main

import (
	ui "github.com/vo-lang/ui"
	"github.com/vo-lang/ui/i18n"
	"github.com/vo-lang/ui/kit"
)

func App() ui.View {
	en := i18n.Parse("en-US")
	de := i18n.Parse("de-DE")
	ar := i18n.Parse("ar-EG")
	ru := i18n.Parse("ru-RU")
	if en.Tag != "en-US" || ar.Direction != ui.DirectionRTL {
		panic("locale parsing contract failed")
	}
	if i18n.Plural(en, 1) != i18n.PluralOne || i18n.Plural(en, 2) != i18n.PluralOther ||
		i18n.Plural(ar, 2) != i18n.PluralTwo ||
		i18n.Plural(ru, 23) != i18n.PluralFew {
		panic("plural contract failed")
	}
	if i18n.FormatInteger(en, 1234567) != "1,234,567" ||
		i18n.FormatDecimal(de, 12345.5, 1) != "12.345,5" ||
		i18n.FormatDate(en, i18n.Date{Year: 2026, Month: 8, Day: 25}) != "8/25/2026" {
		panic("locale formatting contract failed")
	}
	if len(i18n.Graphemes("Á👩‍💻🇨🇳")) != 3 || i18n.DirectionOf("مرحبا") != ui.DirectionRTL ||
		i18n.Compare(en, "Alpha", "beta") >= 0 {
		panic("Unicode behavior contract failed")
	}
	catalog := i18n.NewCatalog("en-US", map[string]string{"hello": "Hello {name}"})
	message := catalog.Message("hello", i18n.Argument{Name: "name", Value: "Volang"})
	plural := catalog.PluralMessage(2, i18n.PluralForms{One: "{count} item", Other: "{count} items"})
	return kit.Application(func() ui.View {
		return kit.Page(ui.Gap(ui.Column(kit.Title("Internationalization ready"), kit.Paragraph(message), kit.Paragraph(plural), kit.Caption(i18n.Isolate("مرحبا Volang"))), kit.CurrentTheme().Spacing.ContentGap))
	})
}

func main() {
	if err := ui.Mount(App); err != nil {
		panic(err.Error())
	}
}
