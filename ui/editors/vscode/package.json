{
  "name": "volang-ui-authoring",
  "displayName": "Volang UI Authoring",
  "description": "Compiler-backed completion, definitions, diagnostics, syntax, and snippets for Volang.",
  "version": "0.1.4",
  "publisher": "vo-lang",
  "license": "MIT",
  "repository": {"type": "git", "url": "https://github.com/vo-lang/volang.git", "directory": "ui/editors/vscode"},
  "main": "./extension.cjs",
  "activationEvents": [
    "onLanguage:volang"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax and snippets are available. The local compiler starts after the workspace is trusted."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2"
  },
  "scripts": {
    "test": "node test/run.cjs",
    "package": "node build.mjs"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "commands": [
      {
        "command": "volang.restartServer",
        "title": "Volang: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Volang",
      "properties": {
        "volang.server.path": {
          "type": "string",
          "default": "vo",
          "description": "Path to the Volang toolchain executable. The extension starts it with lsp --stdio."
        },
        "volang.workspace": {
          "type": "string",
          "default": "",
          "description": "Optional VOWORK override: an absolute vo.work path, or off. Empty inherits the environment and normal workspace discovery."
        }
      }
    },
    "languages": [
      {
        "id": "volang",
        "aliases": [
          "Volang",
          "vo"
        ],
        "extensions": [
          ".vo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "volang",
        "scopeName": "source.volang",
        "path": "./syntaxes/volang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "volang",
        "path": "./snippets/ui.json"
      },
      {
        "language": "volang",
        "path": "./snippets/web.json"
      }
    ]
  }
}
