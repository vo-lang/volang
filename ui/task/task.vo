}

type IntStream struct {
	status ui.IntState
	value ui.IntState
	message ui.StringState
	revision ui.IntState
	hasValue ui.BoolState
}

func UseIntStream(key string, worker func(context.Context, func(int64) bool) error) IntStream {
	if worker == nil {
		panic("UI int stream worker cannot be nil")
	}
	owner := ui.UseIntState(0)
	generation := ui.UseIntState(0)
	activeKey := ui.UseStringState("")
	started := ui.UseBoolState(false)
	status := ui.UseIntState(int64(Idle))
	value := ui.UseIntState(0)
	message := ui.UseStringState("")
	revision := ui.UseIntState(0)
	hasValue := ui.UseBoolState(false)
	identity := initialize(owner, kindIntStream)
	currentGeneration := ui.IntStateValue(generation)
	if !ui.BoolStateValue(started) || ui.StringStateValue(activeKey) != key {
		currentGeneration++
		ui.SetIntState(generation, currentGeneration)
		ui.SetStringState(activeKey, key)
		ui.SetBoolState(started, true)
		ui.SetIntState(status, int64(Pending))
		ui.SetStringState(message, "")
		ui.SetIntState(revision, 0)
		ui.SetBoolState(hasValue, false)
		ctx := restartStream(identity, kindIntStream, currentGeneration)
		go func() {
			if !awaitCommitted(owner, ctx) {
				return
			}
			err := worker(ctx, func(value int64) bool {
				return publishStream(identity, kindIntStream, completion{
					generation: currentGeneration, intValue: value,
				}, ctx)
			})
			finishStream(identity, kindIntStream, currentGeneration, err, ctx)
		}()
	}
	if result, ok := takeStream(identity, kindIntStream, currentGeneration); ok {
		if result.terminal {
			if result.failed {
				ui.SetStringState(message, result.message)
				ui.SetIntState(status, int64(Failed))
			} else {
				ui.SetIntState(status, int64(Complete))
			}
		} else {
			ui.SetIntState(value, result.intValue)
			ui.SetBoolState(hasValue, true)
			ui.SetIntState(revision, ui.IntStateValue(revision) + 1)
			ui.SetIntState(status, int64(Ready))
		}
	}
	return IntStream{
		status: status, value: value, message: message, revision: revision, hasValue: hasValue,
	}
}

func (result IntStream) Status() Status {
	return Status(ui.IntStateValue(result.status))
}

func (result IntStream) HasValue() bool {
	return ui.BoolStateValue(result.hasValue)
}

func (result IntStream) Value() int64 {
	return ui.IntStateValue(result.value)
}

func (result IntStream) Revision() int64 {
	return ui.IntStateValue(result.revision)
}

func (result IntStream) Error() string {
	return ui.StringStateValue(result.message)
}

type FloatStream struct {
	status ui.IntState
	value ui.FloatState
	message ui.StringState
	revision ui.IntState
	hasValue ui.BoolState
}

func UseFloatStream(key string, worker func(context.Context, func(float64) bool) error) FloatStream {
	if worker == nil {
		panic("UI float stream worker cannot be nil")
	}
	owner := ui.UseIntState(0)
	generation := ui.UseIntState(0)
	activeKey := ui.UseStringState("")
	started := ui.UseBoolState(false)
	status := ui.UseIntState(int64(Idle))
	value := ui.UseFloatState(0)
	message := ui.UseStringState("")
	revision := ui.UseIntState(0)
	hasValue := ui.UseBoolState(false)
	identity := initialize(owner, kindFloatStream)
	currentGeneration := ui.IntStateValue(generation)
	if !ui.BoolStateValue(started) || ui.StringStateValue(activeKey) != key {
		currentGeneration++
		ui.SetIntState(generation, currentGeneration)
		ui.SetStringState(activeKey, key)
		ui.SetBoolState(started, true)
		ui.SetIntState(status, int64(Pending))
		ui.SetStringState(message, "")
		ui.SetIntState(revision, 0)
		ui.SetBoolState(hasValue, false)
		ctx := restartStream(identity, kindFloatStream, currentGeneration)
		go func() {
			if !awaitCommitted(owner, ctx) {
				return
			}
			err := worker(ctx, func(value float64) bool {
				return publishStream(identity, kindFloatStream, completion{
					generation: currentGeneration, floatValue: value,
				}, ctx)
			})
			finishStream(identity, kindFloatStream, currentGeneration, err, ctx)
		}()
	}
	if result, ok := takeStream(identity, kindFloatStream, currentGeneration); ok {
		if result.terminal {
			if result.failed {
				ui.SetStringState(message, result.message)
				ui.SetIntState(status, int64(Failed))
			} else {
				ui.SetIntState(status, int64(Complete))
			}
		} else {
			ui.SetFloatState(value, result.floatValue)
			ui.SetBoolState(hasValue, true)
			ui.SetIntState(revision, ui.IntStateValue(revision) + 1)
			ui.SetIntState(status, int64(Ready))
		}
	}
	return FloatStream{
		status: status, value: value, message: message, revision: revision, hasValue: hasValue,
	}
}

func (result FloatStream) Status() Status {
	return Status(ui.IntStateValue(result.status))
}

func (result FloatStream) HasValue() bool {
	return ui.BoolStateValue(result.hasValue)
}

func (result FloatStream) Value() float64 {
	return ui.FloatStateValue(result.value)
}

func (result FloatStream) Revision() int64 {
	return ui.IntStateValue(result.revision)
}

func (result FloatStream) Error() string {
	return ui.StringStateValue(result.message)
}
