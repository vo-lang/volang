// StringStream is the latest committed value of a component-scoped string
// stream. Revision increases once per accepted message. Complete and Failed
// are terminal until key changes.
type StringStream struct {
	status ui.IntState
	value ui.StringState
	message ui.StringState
	revision ui.IntState
	hasValue ui.BoolState
}

// UseStringStream starts one post-commit worker for key. emit applies bounded
// backpressure and returns false after cancellation or replacement.
func UseStringStream(key string, worker func(context.Context, func(string) bool) error) StringStream {
	if worker == nil {
		panic("UI string stream worker cannot be nil")
	}
	owner := ui.UseIntState(0)
	generation := ui.UseIntState(0)
	activeKey := ui.UseStringState("")
	started := ui.UseBoolState(false)
	status := ui.UseIntState(int64(Idle))
	value := ui.UseStringState("")
	message := ui.UseStringState("")
	revision := ui.UseIntState(0)
	hasValue := ui.UseBoolState(false)
	identity := initialize(owner, kindStringStream)
	currentGeneration := ui.IntStateValue(generation)
	if !ui.BoolStateValue(started) || ui.StringStateValue(activeKey) != key {
		currentGeneration++
		ui.SetIntState(generation, currentGeneration)
		ui.SetStringState(activeKey, key)
		ui.SetBoolState(started, true)
		ui.SetIntState(status, int64(Pending))
		ui.SetStringState(message, "")
		ui.SetIntState(revision, 0)
		ui.SetBoolState(hasValue, false)
		ctx := restartStream(identity, kindStringStream, currentGeneration)
		go func() {
			if !awaitCommitted(owner, ctx) {
				return
			}
			err := worker(ctx, func(value string) bool {
				return publishStream(identity, kindStringStream, completion{
					generation: currentGeneration, stringValue: value,
				}, ctx)
			})
			finishStream(identity, kindStringStream, currentGeneration, err, ctx)
		}()
	}
	if result, ok := takeStream(identity, kindStringStream, currentGeneration); ok {
		if result.terminal {
			if result.failed {
				ui.SetStringState(message, result.message)
				ui.SetIntState(status, int64(Failed))
			} else {
				ui.SetIntState(status, int64(Complete))
			}
		} else {
			ui.SetStringState(value, result.stringValue)
			ui.SetBoolState(hasValue, true)
			ui.SetIntState(revision, ui.IntStateValue(revision) + 1)
			ui.SetIntState(status, int64(Ready))
		}
	}
	return StringStream{
		status: status, value: value, message: message, revision: revision, hasValue: hasValue,
	}
}

func (result StringStream) Status() Status {
	return Status(ui.IntStateValue(result.status))
}

func (result StringStream) HasValue() bool {
	return ui.BoolStateValue(result.hasValue)
}

func (result StringStream) Value() string {
	return ui.StringStateValue(result.value)
}

func (result StringStream) Revision() int64 {
	return ui.IntStateValue(result.revision)
}

func (result StringStream) Error() string {
	return ui.StringStateValue(result.message)
}

