// interaction-state colors. Web maps them to native pseudo states; desktop
// resolves them from retained hit-test and focus state without re-rendering the
// application tree.
func HoverBackground(view View, rgba uint32) View

func PressedBackground(view View, rgba uint32) View

func FocusRing(view View, rgba uint32) View

