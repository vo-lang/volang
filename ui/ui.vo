type CurrentToken string

const (
	CurrentNone CurrentToken = "false"
	CurrentItem CurrentToken = "true"
	CurrentPage CurrentToken = "page"
	CurrentStep CurrentToken = "step"
	CurrentLocation CurrentToken = "location"
	CurrentDate CurrentToken = "date"
	CurrentTime CurrentToken = "time"
)

func Current(view View, value CurrentToken) View

// Hidden retains component and node identity while excluding the complete
// subtree from layout, paint, hit testing, focus, and accessibility.
func Hidden(view View, value bool) View

// AccessibilityHidden keeps a visual subtree in layout and paint while
// excluding it from browser and desktop accessibility projections.
func AccessibilityHidden(view View, value bool) View

// Focusable opts a composed semantic control into or out of sequential
// keyboard focus without requiring a renderer-specific element.
func Focusable(view View, value bool) View

func Source(view View, value string) View

func ContentType(view View, value string) View

