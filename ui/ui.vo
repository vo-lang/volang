func MediaState(view View, value string) View

func Poster(view View, value string) View

// Modal creates one platform-enforced focus and interaction scope. A committed
// tree may contain at most one active modal. AutoFocus selects its preferred
// initial target; hosts fall back to the first enabled control, then the modal
// container itself.
func Modal(view View, value bool) View

func AutoFocus(view View, value bool) View

// PointerEvents accepts "auto" or "none". Descendants may opt back into hit
// testing with "auto", which is useful for backdrop-and-panel overlays.
func PointerEvents(view View, value PointerEventsMode) View

// CapturePointer keeps move, up, and cancellation events routed to this view
// after a pointer-down sequence crosses its bounds.
func CapturePointer(view View, value bool) View

// FlowDirection applies inherited logical direction to layout, text, and
// platform semantics. UIKit roots derive it from CurrentEnvironment.
func FlowDirection(view View, value LayoutDirection) View

// Portal moves a subtree into the host overlay plane. Siblings with the same
// layer retain logical tree order, so focus and paint ordering stay stable.
func Portal(view View, layer OverlayLayer) View

// FocusRequest moves focus after a successful commit when token is positive
// and differs from the last accepted node/token pair. Incrementing a local
// token makes validation focus and command-driven focus deterministic.
func FocusRequest(view View, token int64) View

// Key gives one sibling a stable logical identity across insertion, removal,
// and reordering. Keys are local to one parent and must be unique there.
func Key(view View, value string) View

// Controlled text selection offsets use UTF-16 code units on every platform,
// matching Event.SelectionStartUTF16 and Event.SelectionLengthUTF16.
func SelectionStartUTF16(view View, start int64) View

func SelectionLengthUTF16(view View, length int64) View

func TestID(view View, value string) View

