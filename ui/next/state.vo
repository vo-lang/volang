}

// Store holds application-defined values. Updates replace the stored snapshot;
// application code must copy mutable collections before changing them.
type Store struct {
	signal Signal
	value any
	selections map[*observation][]*storeSelection
}

func State(scope *Scope, key string, initial func() any) *Store {
	scope.requireState(key)
	if stored, ok := scope.states[key]; ok {
		state, valid := stored.(*Store)
		if !valid {
			panic("ui: state key changed type: " + key)
		}
		return state
	}
	if initial == nil {
		panic("ui: state requires an initializer")
	}
	state := &Store{signal: newSignal(scope), value: initial()}
	scope.storeState(key, state)
	return state
}

func (state *Store) Get() any {
	state.signal.read()
	return state.value
}

func (state *Store) Update(update func(any) any) {
	state.signal.write()
	if update == nil {
		panic("ui: state update requires a function")
	}
	value := update(state.value)
	changed := state.changedSelections(value)
	state.value = value
	state.signal.changed()
	for _, reader := range changed {
		if reader.derived == nil && state.signal.owner.root.observer != nil {
			state.signal.owner.root.observer.Invalidate(reader.scope, &state.signal)
		}
		reader.invalidate()
	}
}
