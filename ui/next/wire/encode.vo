	out.integer(value.ID)
	out.float(value.ClientX)
	out.float(value.ClientY)
	out.integer(value.Buttons)
	out.float(value.Pressure)
	out.boolean(value.IsPrimary)
}

func readPointerData(in *wireReader) PointerData {
	value := PointerData{}
	value.ID = in.integer()
	value.ClientX = in.float()
	value.ClientY = in.float()
	value.Buttons = in.integer()
	value.Pressure = in.float()
	value.IsPrimary = in.boolean()
	return value
}
