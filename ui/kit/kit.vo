// Application is the normal UIKit root. Applications may override the host
// environment with ApplicationWithEnvironment for tests, previews, embedded
// surfaces, and deterministic server rendering.
func Application(content func() ui.View) ui.View {
	return ui.FlowDirection(ProvideTheme(SystemTheme(), func() ui.View {
		return ui.Foreground(content(), CurrentTheme().Foreground)
	}), ui.CurrentEnvironment().Direction)
}

func ApplicationWithEnvironment(environment ui.Environment, content func() ui.View) ui.View {
	return ui.ProvideEnvironment(environment, func() ui.View {
		return Application(content)
	})
}

// The following components form the concise inherited-theme surface. The
// explicit-theme functions below remain useful for low-level recipes and
// incremental source migration.
func Page(content ui.View) ui.View {
	return Screen(CurrentTheme(), content)
}

func Panel(content ui.View) ui.View {
	return Card(CurrentTheme(), content)
}

func Title(value string) ui.View {
	return Heading(CurrentTheme(), value)
}

// PageTitle is the display-level heading for a screen. Section titles keep a
// quieter scale so a complete page has an intentional visual hierarchy.
func PageTitle(value string) ui.View {
	theme := CurrentTheme()
	return ui.Role(ui.FontWeight(ui.FontSize(ui.Foreground(ui.Text(value), theme.Foreground), theme.Typography.TitleSize *
		1.6), theme.Typography.WeightStrong), "heading")
}

func Paragraph(value string) ui.View {
	return ui.Role(Body(CurrentTheme(), value), "paragraph")
}

func Caption(value string) ui.View {
	return MutedText(CurrentTheme(), value)
}

func ActionButton(label string, disabled bool, onClick func()) ui.View {
	return Button(label, ButtonPrimary, ControlMedium, disabled, onClick)
}

func DestructiveButton(label string, disabled bool, onClick func()) ui.View {
	return Button(label, ButtonDanger, ControlMedium, disabled, onClick)
}

func Input(label string, value string, placeholder string, disabled bool, onInput func(string)) ui.View {
	return TextField(CurrentTheme(), label, value, placeholder, disabled, ui.TextChange(onInput))
}

func ValidatedInput(label string, value string, placeholder string, required bool, disabled bool, errorMessage string, focusToken int64, onInput func(string)) ui.View {
	return ValidatedTextFieldWithFocus(CurrentTheme(), label, value, placeholder, required, disabled, errorMessage, focusToken, ui.TextChange(onInput))
}

func Switch(label string, checked bool, disabled bool, onChange func(bool)) ui.View {
	return ToggleField(CurrentTheme(), label, checked, disabled, ui.ToggleChange(onChange))
}

func Actions(children ...ui.View) ui.View {
